<UserControl x:Class="AuraEcho.Views.Purchase"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:apiOrder="clr-namespace:AuraEcho.Api.Models.V1.Order;assembly=AuraEcho.Api.Models"
             xmlns:converters="clr-namespace:AuraEcho.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:AuraEcho.Core.Models;assembly=AuraEcho.Core"
             xmlns:pcap="clr-namespace:AuraEcho.PluginContracts.AttachedProperties;assembly=AuraEcho.PluginContracts"
             xmlns:pcm="clr-namespace:AuraEcho.PluginContracts.Models;assembly=AuraEcho.PluginContracts"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:ui="http://ui.auraecho.com/"
             xmlns:viewmodels="clr-namespace:AuraEcho.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:PurchaseViewModel}"
             d:DesignHeight="640"
             d:DesignWidth="982"
             d:Foreground="{DynamicResource Brushes.OnSurface}"
             prism:ViewModelLocator.AutoWireViewModel="True"
             UseLayoutRounding="True"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ui:BindingProxy x:Key="BindingProxy" Data="{Binding}" />
        <converters:PayUrlToQRCodeConverter x:Key="PayUrlToQRCode" />
        <ui:EnumToBooleanConverter x:Key="EnumToBoolean" />
        <DataTemplate x:Key="SkuTemplate" DataType="{x:Type models:Sku}">
            <RadioButton Width="120"
                         Command="{Binding Source={StaticResource BindingProxy}, Path=Data.SelectSkuCommand}"
                         CommandParameter="{Binding}"
                         GroupName="SkuGroup"
                         Style="{DynamicResource CardRadioButtonStyle}">
                <i:Interaction.Triggers>
                    <i:DataTrigger Binding="{Binding Source={StaticResource BindingProxy}, Path=Data.SelectedSku}" Value="{Binding}">
                        <i:ChangePropertyAction PropertyName="IsChecked" Value="True" />
                    </i:DataTrigger>
                </i:Interaction.Triggers>
                <Border CornerRadius="4">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Margin="0,0,0,8"
                                   HorizontalAlignment="Center"
                                   d:Text="SKU名称"
                                   FontSize="{DynamicResource FontSize.Title.Medium}"
                                   Foreground="{DynamicResource Brushes.OnSurface}">
                            <i:Interaction.Triggers>
                                <i:DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type RadioButton}}, Path=IsChecked}" Value="False">
                                    <i:ChangePropertyAction PropertyName="FontWeight" Value="Regular" />
                                </i:DataTrigger>
                                <i:DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type RadioButton}}, Path=IsChecked}" Value="True">
                                    <i:ChangePropertyAction PropertyName="FontWeight" Value="SemiBold" />
                                </i:DataTrigger>
                                <i:DataTrigger Binding="{Binding Type}" Value="{x:Static pcm:LicenseType.Monthly}">
                                    <i:ChangePropertyAction PropertyName="Text" Value="月卡" />
                                </i:DataTrigger>
                                <i:DataTrigger Binding="{Binding Type}" Value="{x:Static pcm:LicenseType.Yearly}">
                                    <i:ChangePropertyAction PropertyName="Text" Value="年卡" />
                                </i:DataTrigger>
                                <i:DataTrigger Binding="{Binding Type}" Value="{x:Static pcm:LicenseType.Lifetime}">
                                    <i:ChangePropertyAction PropertyName="Text" Value="永久" />
                                </i:DataTrigger>
                            </i:Interaction.Triggers>
                        </TextBlock>

                        <TextBlock Margin="0,0,0,4" HorizontalAlignment="Center">
                            <Run FontSize="{DynamicResource FontSize.Body.Large}" Text="￥" /><Run d:Text="0.5"
                                 FontSize="{DynamicResource FontSize.Headline.Large}"
                                 FontWeight="SemiBold"
                                 Text="{Binding SalePrice, StringFormat={}{0:N2}}" />
                        </TextBlock>
                        <TextBlock HorizontalAlignment="Center"
                                   d:Text="￥2.00"
                                   FontSize="14"
                                   Foreground="{DynamicResource Brushes.OnSurfaceVariant}"
                                   Text="{Binding OriginalPrice, StringFormat=￥{0:N2}}"
                                   TextDecorations="Strikethrough" />

                    </StackPanel>
                </Border>
            </RadioButton>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Background="{DynamicResource Brushes.Scrim}">
        <Border Width="680"
                Height="450"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource Brushes.SurfaceContainerHighest}"
                BorderBrush="{DynamicResource Brushes.OutlineShadow}"
                BorderThickness="1"
                CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                                  Direction="270"
                                  Opacity="0.15"
                                  ShadowDepth="6" />
            </Border.Effect>
            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, *">

                <Grid Grid.Row="0"
                      Grid.Column="0"
                      Grid.ColumnSpan="2">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="48"
                                Height="48"
                                Margin="0,0,8,0"
                                CornerRadius="4"
                                DockPanel.Dock="Left">
                            <Border.Background>
                                <ImageBrush pcap:WebImageHelper.DecodePixelWidth="96"
                                            pcap:WebImageHelper.Url="{Binding CurrentPlugin.IconFileUrl}"
                                            Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,4"
                                       d:Text="插件名称"
                                       Style="{DynamicResource TitleMediumTextBlockStyle}"
                                       Text="{Binding CurrentPlugin.Name}" />
                            <TextBlock FontSize="{DynamicResource FontSize.Body.Medium}"
                                       Foreground="{DynamicResource Brushes.OnSurfaceVariant}"
                                       Text="购买后有效期顺延" />
                        </StackPanel>
                    </StackPanel>
                    <Button Width="45"
                            Height="36"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            BorderThickness="0"
                            Command="{Binding CloseCommand}"
                            FontSize="15"
                            IsTabStop="False"
                            Style="{DynamicResource IconButtonStyle}"
                            ToolTip="{Binding Source={StaticResource R}, Path=Labels.Window_Close}"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.RenderTransform>
                            <TranslateTransform X="16" Y="-16" />
                        </Button.RenderTransform>
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="16" Height="16">
                                <Path Data="M 3.14645 3.14645 C 3.34171 2.95118 3.65829 2.95118 3.85355 3.14645 L 8 7.293 L 12.1464 3.14645 C 12.32 2.97288 12.5894 2.9536 12.7843 3.08859 L 12.8536 3.14645 C 13.0488 3.34171 13.0488 3.65829 12.8536 3.85355 L 8.707 8 L 12.8536 12.1464 C 13.0271 12.32 13.0464 12.5894 12.9114 12.7843 L 12.8536 12.8536 C 12.6583 13.0488 12.3417 13.0488 12.1464 12.8536 L 8 8.707 L 3.85355 12.8536 C 3.67999 13.0271 3.41056 13.0464 3.21569 12.9114 L 3.14645 12.8536 C 2.95118 12.6583 2.95118 12.3417 3.14645 12.1464 L 7.293 8 L 3.14645 3.85355 C 2.97288 3.67999 2.9536 3.41056 3.08859 3.21569 L 3.14645 3.14645 Z" Fill="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Button}}, Path=Foreground}" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,16,16,0">
                    <TextBlock Margin="0,0,0,8"
                               Style="{DynamicResource BodyLargeTextBlockStyle}"
                               Text="选择您的订阅" />
                    <ItemsControl Height="160"
                                  Margin="0,0,0,16"
                                  d:ItemsSource="{d:SampleData ItemCount=3}"
                                  ItemTemplate="{StaticResource SkuTemplate}"
                                  ItemsSource="{Binding Skus}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel IsItemsHost="True" Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="{x:Type ContentPresenter}">
                                <Setter Property="Margin" Value="0,0,12,0" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                    <StackPanel>
                        <TextBlock Margin="0,0,0,8"
                                   Style="{DynamicResource BodyLargeTextBlockStyle}"
                                   Text="支付方式" />
                        <RadioButton Height="48"
                                     Margin="0,0,0,8"
                                     HorizontalContentAlignment="Left"
                                     GroupName="PaymentChannelGroup"
                                     IsChecked="{Binding PaymentChannel, Converter={StaticResource EnumToBoolean}, ConverterParameter={x:Static apiOrder:PaymentChannel.Alipay}}"
                                     Style="{DynamicResource CardRadioButtonStyle}">
                            <StackPanel Margin="4,0,0,0" Orientation="Horizontal">
                                <Border Width="32"
                                        Height="32"
                                        Margin="0,0,8,0">
                                    <Border.Background>
                                        <ImageBrush>
                                            <ImageBrush.ImageSource>
                                                <BitmapImage DecodePixelHeight="64"
                                                             DecodePixelWidth="64"
                                                             UriSource="/Assets/Images/alipay_logo.png" />
                                            </ImageBrush.ImageSource>
                                        </ImageBrush>
                                    </Border.Background>
                                </Border>
                                <TextBlock VerticalAlignment="Center"
                                           Style="{DynamicResource BodyLargeTextBlockStyle}"
                                           Text="支付宝" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Height="48"
                                     HorizontalContentAlignment="Left"
                                     GroupName="PaymentChannelGroup"
                                     IsChecked="{Binding PaymentChannel, Converter={StaticResource EnumToBoolean}, ConverterParameter={x:Static apiOrder:PaymentChannel.Wxpay}}"
                                     Style="{DynamicResource CardRadioButtonStyle}"
                                     UseLayoutRounding="True">
                            <StackPanel Margin="4,0,0,0" Orientation="Horizontal">
                                <Border Width="32"
                                        Height="32"
                                        Margin="0,0,8,0">
                                    <Border.Background>
                                        <ImageBrush>
                                            <ImageBrush.ImageSource>
                                                <BitmapImage DecodePixelHeight="64"
                                                             DecodePixelWidth="64"
                                                             UriSource="/Assets/Images/wechat_logo.png" />
                                            </ImageBrush.ImageSource>
                                        </ImageBrush>
                                    </Border.Background>
                                </Border>
                                <TextBlock VerticalAlignment="Center"
                                           Style="{DynamicResource BodyLargeTextBlockStyle}"
                                           Text="微信支付" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="1"
                      Grid.Column="1"
                      RowDefinitions="*, Auto">
                    <StackPanel Grid.Row="0" VerticalAlignment="Center">
                        <TextBlock Margin="0,0,0,8"
                                   HorizontalAlignment="Center"
                                   d:Text="￥0.00"
                                   Foreground="#c38542"
                                   Style="{DynamicResource DisplaySmallTextBlockStyle}"
                                   Text="{Binding SelectedSku.SalePrice, StringFormat=￥{0:N2}}" />
                        <Border Margin="0,0,0,16"
                                Padding="4"
                                HorizontalAlignment="Center"
                                BorderBrush="#c38542"
                                BorderThickness="2"
                                CornerRadius="8">
                            <Grid Width="150" Height="150">

                                <Border Padding="8"
                                        Background="White"
                                        CornerRadius="4">
                                    <Image Source="{Binding PayUrl, Converter={StaticResource PayUrlToQRCode}}" />
                                </Border>

                                <Border Background="#BB000000" CornerRadius="4">
                                    <i:Interaction.Triggers>
                                        <i:DataTrigger Binding="{Binding IsOrderCreating}" Value="True">
                                            <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Visible}" />
                                        </i:DataTrigger>
                                        <i:DataTrigger Binding="{Binding IsOrderCreating}" Value="False">
                                            <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Hidden}" />
                                        </i:DataTrigger>
                                    </i:Interaction.Triggers>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Viewbox Width="36" Height="36">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z" Fill="#FFFFFF" />
                                            </Canvas>
                                        </Viewbox>
                                    </StackPanel>
                                </Border>

                                <Border Background="#BB000000" CornerRadius="4">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="MouseUp">
                                            <i:InvokeCommandAction Command="{Binding RefreshPayUrlCommand}" />
                                        </i:EventTrigger>
                                        <i:DataTrigger Binding="{Binding PayUrlIsValid}" Value="True">
                                            <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Hidden}" />
                                        </i:DataTrigger>
                                        <i:DataTrigger Binding="{Binding PayUrlIsValid}" Value="False">
                                            <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Visible}" />
                                        </i:DataTrigger>
                                    </i:Interaction.Triggers>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Margin="0,0,0,8"
                                                   Foreground="#FFFFFF"
                                                   Style="{DynamicResource TitleMediumTextBlockStyle}"
                                                   Text="二维码已失效" />
                                        <TextBlock Foreground="#FFFFFF"
                                                   Style="{DynamicResource BodyMediumTextBlockStyle}"
                                                   Text="请点击二维码刷新" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <Grid HorizontalAlignment="Center">
                            <i:Interaction.Triggers>
                                <i:DataTrigger Binding="{Binding PaymentChannel}" Value="{x:Static apiOrder:PaymentChannel.Alipay}">
                                    <i:ChangePropertyAction PropertyName="Visibility"
                                                            TargetName="AlipayTipsBorder"
                                                            Value="{x:Static Visibility.Visible}" />
                                    <i:ChangePropertyAction PropertyName="Visibility"
                                                            TargetName="WxpayTipsBorder"
                                                            Value="{x:Static Visibility.Collapsed}" />
                                </i:DataTrigger>
                                <i:DataTrigger Binding="{Binding PaymentChannel}" Value="{x:Static apiOrder:PaymentChannel.Wxpay}">
                                    <i:ChangePropertyAction PropertyName="Visibility"
                                                            TargetName="AlipayTipsBorder"
                                                            Value="{x:Static Visibility.Collapsed}" />
                                    <i:ChangePropertyAction PropertyName="Visibility"
                                                            TargetName="WxpayTipsBorder"
                                                            Value="{x:Static Visibility.Visible}" />
                                </i:DataTrigger>
                            </i:Interaction.Triggers>
                            <Border x:Name="AlipayTipsBorder"
                                    HorizontalAlignment="Center"
                                    BorderBrush="#4377FA"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="16"
                                            Height="16"
                                            Margin="0,0,4,0">
                                        <Border.Background>
                                            <ImageBrush>
                                                <ImageBrush.ImageSource>
                                                    <BitmapImage DecodePixelHeight="32"
                                                                 DecodePixelWidth="32"
                                                                 UriSource="/Assets/Images/alipay_logo.png" />
                                                </ImageBrush.ImageSource>
                                            </ImageBrush>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Margin="0,0,4,0"
                                               VerticalAlignment="Center"
                                               Foreground="#4377FA"
                                               Style="{DynamicResource BodySmallTextBlockStyle}"
                                               Text="请使用支付宝扫码支付" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="WxpayTipsBorder"
                                    HorizontalAlignment="Center"
                                    BorderBrush="#2dc100"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="16"
                                            Height="16"
                                            Margin="0,0,4,0">
                                        <Border.Background>
                                            <ImageBrush>
                                                <ImageBrush.ImageSource>
                                                    <BitmapImage DecodePixelHeight="32"
                                                                 DecodePixelWidth="32"
                                                                 UriSource="/Assets/Images/wechat_logo.png" />
                                                </ImageBrush.ImageSource>
                                            </ImageBrush>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Margin="0,0,4,0"
                                               VerticalAlignment="Center"
                                               Foreground="#2dc100"
                                               Style="{DynamicResource BodySmallTextBlockStyle}"
                                               Text="请使用微信扫一扫支付" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                    <TextBlock Grid.Row="1"
                               HorizontalAlignment="Center"
                               FontSize="12"
                               TextWrapping="Wrap">
                        <Run Foreground="{DynamicResource Brushes.OnSurfaceVariant}" Text="支付前请阅读" />
                        <Hyperlink Command="{Binding OpenSubscriptionTermsCommand}" Cursor="Hand">
                            会员订阅服务协议
                        </Hyperlink>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
