<UserControl x:Class="AuraEcho.Setup.UI.Views.Uninstalling"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:viewmodels="clr-namespace:AuraEcho.Setup.UI.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:UninstallingViewModel}"
             d:DesignHeight="500"
             d:DesignWidth="750"
             d:Foreground="White"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Storyboard x:Key="ProgressStorybard">
            <DoubleAnimation Storyboard.TargetName="UninstallProgressBar"
                             Storyboard.TargetProperty="Value"
                             Duration="0:0:2" />
        </Storyboard>
    </UserControl.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding UninstallCommand}" />
        </i:EventTrigger>
        <i:PropertyChangedTrigger Binding="{Binding Progress}">
            <i:CallMethodAction MethodName="BeginProgressStoryboard" TargetObject="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </i:PropertyChangedTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <StackPanel Grid.Row="1"
                    Width="400"
                    Margin="0,0,0,100"
                    VerticalAlignment="Bottom">
            <TextBlock Margin="0,0,0,50"
                       HorizontalAlignment="Center"
                       FontSize="14"
                       Text="正在将灵光回声从此计算机中移除，请耐心等待。" />
            <ProgressBar x:Name="UninstallProgressBar"
                         Height="4"
                         Margin="0,0,0,8"
                         d:Value="10"
                         Maximum="100"
                         Minimum="0" />
            <DockPanel LastChildFill="True">
                <TextBlock d:Text="10%"
                           DockPanel.Dock="Right"
                           Text="{Binding ElementName=UninstallProgressBar, Path=Value, StringFormat={}{0:N0}%}" />
                <TextBlock Margin="0,0,20,0"
                           d:Text="正在初始化..."
                           DockPanel.Dock="Left"
                           FontSize="14"
                           Text="{Binding Message}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </StackPanel>
    </Grid>
</UserControl>
