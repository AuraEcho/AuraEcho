<UserControl x:Class="AuraEcho.Views.Homepage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:auraecho="http://ui.auraecho.com/"
             xmlns:cc="clr-namespace:AuraEcho.PluginContracts.Constants;assembly=AuraEcho.PluginContracts"
             xmlns:cm="clr-namespace:AuraEcho.Core.Models;assembly=AuraEcho.Core"
             xmlns:converters="clr-namespace:AuraEcho.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:AuraEcho.Core.Models;assembly=AuraEcho.Core"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:selectors="clr-namespace:AuraEcho.Selectors"
             xmlns:viewmodels="clr-namespace:AuraEcho.ViewModels"
             d:Background="{DynamicResource Brushes.SurfaceContainerLowest}"
             d:DataContext="{d:DesignInstance Type=viewmodels:HomepageViewModel}"
             d:DesignHeight="355"
             d:DesignWidth="535"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">
    <UserControl.Resources>
        <auraecho:BindingProxy x:Key="BindingProxy" Data="{Binding}" />
        <DataTemplate x:Key="NativePluginTemplate" DataType="{x:Type cm:NativePlugin}">

            <Button Width="120"
                    Height="120"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Command="{Binding Source={StaticResource BindingProxy}, Path=Data.SwitchPluginCommand}"
                    CommandParameter="{Binding}"
                    FontSize="12"
                    Style="{DynamicResource IconButtonStyle}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Command="{Binding Source={StaticResource BindingProxy}, Path=Data.SwitchPluginCommand}"
                                  CommandParameter="{Binding}"
                                  Header="OPEN" />
                        <MenuItem x:Name="UninstallMenuItem"
                                  Command="{Binding Source={StaticResource BindingProxy}, Path=Data.PluginPlanUninstallCommand}"
                                  CommandParameter="{Binding}"
                                  Header="UNINSTALL">
                            <i:Interaction.Triggers>
                                <i:DataTrigger Binding="{Binding PlanStatus}" Value="{x:Static models:PluginPlanStatus.UninstallPending}">
                                    <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Collapsed}" />
                                </i:DataTrigger>
                                <i:DataTrigger Binding="{Binding PlanStatus}"
                                               Comparison="NotEqual"
                                               Value="{x:Static models:PluginPlanStatus.UninstallPending}">
                                    <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Visible}" />
                                </i:DataTrigger>
                            </i:Interaction.Triggers>
                        </MenuItem>
                        <MenuItem x:Name="CancelUninstallMenuItem"
                                  Command="{Binding Source={StaticResource BindingProxy}, Path=Data.CancelPluginPlanUninstallCommand}"
                                  CommandParameter="{Binding}"
                                  Header="CANCEL UNINSTALL">
                            <i:Interaction.Triggers>
                                <i:DataTrigger Binding="{Binding PlanStatus}" Value="{x:Static models:PluginPlanStatus.UninstallPending}">
                                    <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Visible}" />
                                </i:DataTrigger>
                                <i:DataTrigger Binding="{Binding PlanStatus}"
                                               Comparison="NotEqual"
                                               Value="{x:Static models:PluginPlanStatus.UninstallPending}">
                                    <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Collapsed}" />
                                </i:DataTrigger>
                            </i:Interaction.Triggers>
                        </MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>
                <Grid>
                    <DockPanel HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               LastChildFill="True">
                        <Rectangle Width="60"
                                   Height="60"
                                   Margin="0,0,0,8"
                                   DockPanel.Dock="Top"
                                   RadiusX="4"
                                   RadiusY="4">
                            <Rectangle.Fill>
                                <ImageBrush ImageSource="{Binding Path=., Converter={converters:PluginIconConverter}}" />
                            </Rectangle.Fill>
                        </Rectangle>
                        <TextBlock VerticalAlignment="Center"
                                   d:Text="Plugin Name"
                                   FontSize="14"
                                   Text="{Binding PluginName}" />
                    </DockPanel>
                    <Label Padding="4,2"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Background="{DynamicResource Brushes.Warning}"
                           Content="Pending">
                        <i:Interaction.Triggers>
                            <i:DataTrigger Binding="{Binding PlanStatus}" Value="{x:Static models:PluginPlanStatus.None}">
                                <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Collapsed}" />
                            </i:DataTrigger>
                            <i:DataTrigger Binding="{Binding PlanStatus}"
                                           Comparison="NotEqual"
                                           Value="{x:Static models:PluginPlanStatus.None}">
                                <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Visible}" />
                            </i:DataTrigger>
                        </i:Interaction.Triggers>
                    </Label>
                </Grid>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="StandalonePluginTemplate" DataType="{x:Type cm:StandalonePlugin}">
            <Button Width="120"
                    Height="120"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Command="{Binding Source={StaticResource BindingProxy}, Path=Data.SwitchPluginCommand}"
                    CommandParameter="{Binding}"
                    FontSize="12"
                    Style="{DynamicResource IconButtonStyle}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Command="{Binding Source={StaticResource BindingProxy}, Path=Data.SwitchPluginCommand}"
                                  CommandParameter="{Binding}"
                                  Header="OPEN" />
                        <MenuItem x:Name="UninstallMenuItem"
                                  Command="{Binding Source={StaticResource BindingProxy}, Path=Data.PluginPlanUninstallCommand}"
                                  CommandParameter="{Binding}"
                                  Header="UNINSTALL">
                            <i:Interaction.Triggers>
                                <i:DataTrigger Binding="{Binding PlanStatus}" Value="{x:Static models:PluginPlanStatus.UninstallPending}">
                                    <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Collapsed}" />
                                </i:DataTrigger>
                                <i:DataTrigger Binding="{Binding PlanStatus}"
                                               Comparison="NotEqual"
                                               Value="{x:Static models:PluginPlanStatus.UninstallPending}">
                                    <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Visible}" />
                                </i:DataTrigger>
                            </i:Interaction.Triggers>
                        </MenuItem>
                        <MenuItem x:Name="CancelUninstallMenuItem"
                                  Command="{Binding Source={StaticResource BindingProxy}, Path=Data.CancelPluginPlanUninstallCommand}"
                                  CommandParameter="{Binding}"
                                  Header="CANCEL UNINSTALL">
                            <i:Interaction.Triggers>
                                <i:DataTrigger Binding="{Binding PlanStatus}" Value="{x:Static models:PluginPlanStatus.UninstallPending}">
                                    <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Visible}" />
                                </i:DataTrigger>
                                <i:DataTrigger Binding="{Binding PlanStatus}"
                                               Comparison="NotEqual"
                                               Value="{x:Static models:PluginPlanStatus.UninstallPending}">
                                    <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Collapsed}" />
                                </i:DataTrigger>
                            </i:Interaction.Triggers>
                        </MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>
                <Grid>
                    <DockPanel HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               LastChildFill="True">
                        <Rectangle Width="60"
                                   Height="60"
                                   Margin="0,0,0,8"
                                   DockPanel.Dock="Top"
                                   RadiusX="4"
                                   RadiusY="4">
                            <Rectangle.Fill>
                                <ImageBrush ImageSource="{Binding Path=., Converter={converters:PluginIconConverter}}" />
                            </Rectangle.Fill>
                        </Rectangle>
                        <TextBlock VerticalAlignment="Center"
                                   d:Text="Plugin Name"
                                   FontSize="14"
                                   Text="{Binding PluginName}" />
                    </DockPanel>
                    <Label Padding="4,2"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Background="{DynamicResource Brushes.Warning}"
                           Content="Pending">
                        <i:Interaction.Triggers>
                            <i:DataTrigger Binding="{Binding PlanStatus}" Value="{x:Static models:PluginPlanStatus.None}">
                                <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Collapsed}" />
                            </i:DataTrigger>
                            <i:DataTrigger Binding="{Binding PlanStatus}"
                                           Comparison="NotEqual"
                                           Value="{x:Static models:PluginPlanStatus.None}">
                                <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Visible}" />
                            </i:DataTrigger>
                        </i:Interaction.Triggers>
                    </Label>
                </Grid>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="WebPluginTemplate" DataType="{x:Type cm:AppPlugin}">
            <Button Width="120"
                    Height="120"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Command="{Binding Source={StaticResource BindingProxy}, Path=Data.SwitchPluginCommand}"
                    CommandParameter="{Binding}"
                    FontSize="12"
                    Style="{DynamicResource IconButtonStyle}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Command="{Binding Source={StaticResource BindingProxy}, Path=Data.SwitchPluginCommand}"
                                  CommandParameter="{Binding}"
                                  Header="OPEN" />
                        <MenuItem x:Name="UninstallMenuItem"
                                  Command="{Binding Source={StaticResource BindingProxy}, Path=Data.PluginPlanUninstallCommand}"
                                  CommandParameter="{Binding}"
                                  Header="UNINSTALL">
                            <i:Interaction.Triggers>
                                <i:DataTrigger Binding="{Binding PlanStatus}" Value="{x:Static models:PluginPlanStatus.UninstallPending}">
                                    <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Collapsed}" />
                                </i:DataTrigger>
                                <i:DataTrigger Binding="{Binding PlanStatus}"
                                               Comparison="NotEqual"
                                               Value="{x:Static models:PluginPlanStatus.UninstallPending}">
                                    <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Visible}" />
                                </i:DataTrigger>
                            </i:Interaction.Triggers>
                        </MenuItem>
                        <MenuItem x:Name="CancelUninstallMenuItem"
                                  Command="{Binding Source={StaticResource BindingProxy}, Path=Data.CancelPluginPlanUninstallCommand}"
                                  CommandParameter="{Binding}"
                                  Header="CANCEL UNINSTALL">
                            <i:Interaction.Triggers>
                                <i:DataTrigger Binding="{Binding PlanStatus}" Value="{x:Static models:PluginPlanStatus.UninstallPending}">
                                    <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Visible}" />
                                </i:DataTrigger>
                                <i:DataTrigger Binding="{Binding PlanStatus}"
                                               Comparison="NotEqual"
                                               Value="{x:Static models:PluginPlanStatus.UninstallPending}">
                                    <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Collapsed}" />
                                </i:DataTrigger>
                            </i:Interaction.Triggers>
                        </MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>
                <Grid>
                    <DockPanel HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               LastChildFill="True">
                        <Rectangle Width="60"
                                   Height="60"
                                   Margin="0,0,0,8"
                                   DockPanel.Dock="Top"
                                   RadiusX="4"
                                   RadiusY="4">
                            <Rectangle.Fill>
                                <ImageBrush ImageSource="{Binding Path=., Converter={converters:PluginIconConverter}}" />
                            </Rectangle.Fill>
                        </Rectangle>
                        <TextBlock VerticalAlignment="Center"
                                   d:Text="Plugin Name"
                                   FontSize="14"
                                   Text="{Binding PluginName}" />
                    </DockPanel>
                    <Label Padding="4,2"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Background="{DynamicResource Brushes.Warning}"
                           Content="Pending">
                        <i:Interaction.Triggers>
                            <i:DataTrigger Binding="{Binding PlanStatus}" Value="{x:Static models:PluginPlanStatus.None}">
                                <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Collapsed}" />
                            </i:DataTrigger>
                            <i:DataTrigger Binding="{Binding PlanStatus}"
                                           Comparison="NotEqual"
                                           Value="{x:Static models:PluginPlanStatus.None}">
                                <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Visible}" />
                            </i:DataTrigger>
                        </i:Interaction.Triggers>
                    </Label>
                </Grid>
            </Button>
        </DataTemplate>
        <CollectionViewSource x:Key="PluginsSource" Source="{Binding Plugins}" />
    </UserControl.Resources>
    <Grid RowDefinitions="36, *">
        <ItemsControl Grid.Row="1" Margin="24,12,24,24">
            <ItemsControl.ItemTemplateSelector>
                <selectors:AppPluginDataTemplateSelector LocalWebPluginTemplate="{StaticResource WebPluginTemplate}"
                                                         NativePluginTemplate="{StaticResource NativePluginTemplate}"
                                                         RemoteWebPluginTemplate="{StaticResource WebPluginTemplate}"
                                                         StandalonePluginTemplate="{StaticResource StandalonePluginTemplate}" />
            </ItemsControl.ItemTemplateSelector>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel IsItemsHost="True" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemsSource>
                <CompositeCollection>
                    <CollectionContainer d:Collection="{d:SampleData ItemCount=5}" Collection="{Binding Source={StaticResource PluginsSource}}" />
                    <Button Width="120"
                            Height="120"
                            Command="{Binding NavigationToPluginsMarketplaceCommand}"
                            FontSize="12"
                            Style="{DynamicResource IconButtonStyle}">
                        <DockPanel LastChildFill="True">
                            <Viewbox Width="60"
                                     Height="60"
                                     Margin="0,0,0,8"
                                     DockPanel.Dock="Top">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M12,13A5,5 0 0,1 7,8H9A3,3 0 0,0 12,11A3,3 0 0,0 15,8H17A5,5 0 0,1 12,13M12,3A3,3 0 0,1 15,6H9A3,3 0 0,1 12,3M19,6H17A5,5 0 0,0 12,1A5,5 0 0,0 7,6H5C3.89,6 3,6.89 3,8V20A2,2 0 0,0 5,22H19A2,2 0 0,0 21,20V8C21,6.89 20.1,6 19,6Z" Fill="#AAAAAA" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="14"
                                       Text="{Binding Source={StaticResource R}, Path=Labels.PluginsMarketplace}"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Button>
                </CompositeCollection>
            </ItemsControl.ItemsSource>
        </ItemsControl>
    </Grid>
</UserControl>
