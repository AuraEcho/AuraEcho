<UserControl x:Class="AuraEcho.Setup.UI.Views.InstallFinish"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:av="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:viewmodels="clr-namespace:AuraEcho.Setup.UI.ViewModels"
             av:DataContext="{av:DesignInstance Type=viewmodels:InstallFinishViewModel}"
             av:DesignHeight="500"
             av:DesignWidth="750"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="av">
    <Grid>
        <StackPanel Margin="0,0,0,100" VerticalAlignment="Bottom">
            <Border Width="330"
                    Height="42"
                    Margin="0,0,0,100"
                    Padding="16,8"
                    Background="#1A00C853"
                    BorderBrush="#00C853"
                    BorderThickness="1"
                    CornerRadius="4">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="16" Height="16" Margin="0, 2, 4, 0">
                        <Canvas Width="16"
                                Height="16">
                            <Path Stroke="#ff00b400"
                                  StrokeDashCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="2.0"
                                  Data="M 13.33 4 L 6 11.33 L 2.67 8"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="#00C853"
                               Text="安装成功！" />
                </StackPanel>
            </Border>
            <Button Width="200"
                    Height="48"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Click="FinishedButton_Click"
                    Content="现在启动"
                    FontSize="18"
                    Style="{DynamicResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</UserControl>
