        <Setter Property="Padding" Value="5" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brushes.OutlineInner}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
