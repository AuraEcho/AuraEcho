<Window x:Class="AuraEcho.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:auraecho="http://ui.auraecho.com/"
        xmlns:constants="clr-namespace:AuraEcho.PluginContracts.Constants;assembly=AuraEcho.PluginContracts"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pm="clr-namespace:AuraEcho.PluginContracts.Models;assembly=AuraEcho.PluginContracts"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:viewmodels="clr-namespace:AuraEcho.ViewModels"
        xmlns:views="clr-namespace:AuraEcho.Views"
        Title="{Binding Source={StaticResource R}, Path=Labels.AppName}"
        Width="960"
        Height="640"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel}"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Background="{DynamicResource Brushes.SurfaceContainerLowest}"
        Closing="Window_Closing"
        Foreground="{DynamicResource Brushes.OnSurface}"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">

    <Window.Resources>
        <auraecho:BindingProxy x:Key="BindingProxy" Data="{Binding}" />
        <Storyboard x:Key="ShowMask">
            <DoubleAnimation Storyboard.TargetName="AppContainer"
                             Storyboard.TargetProperty="(Grid.Effect).Progress"
                             To="0"
                             Duration="0:0:.5">
                <DoubleAnimation.EasingFunction>
                    <CircleEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation BeginTime="0:0:.5"
                             Storyboard.TargetName="AppContainer"
                             Storyboard.TargetProperty="(Grid.Effect).Progress"
                             From="0"
                             To="0"
                             Duration="0:0:.5" />
        </Storyboard>
        <Storyboard x:Key="HideMask">
            <DoubleAnimation Storyboard.TargetName="AppContainer"
                             Storyboard.TargetProperty="(Grid.Effect).Progress"
                             To="100"
                             Duration="0:0:.5">
                <DoubleAnimation.EasingFunction>
                    <CircleEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>
    <i:Interaction.Behaviors>
        <auraecho:ClearFocusOnClickBehavior />
    </i:Interaction.Behaviors>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding AutoSignInCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Window.InputBindings>
        <!--
            为什么不使用 Applications.NotACommand?
            不知道为什么，使用 ApplicationCommands.NotACommand 不生效，所以使用了一个程序未进行处理的其他命令
        -->
        <KeyBinding Command="{x:Static ApplicationCommands.Paste}" Gesture="Alt+Space" />
        <KeyBinding Command="{x:Static ApplicationCommands.Paste}" Gesture="Alt+F4" />
    </Window.InputBindings>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      CornerRadius="0"
                      GlassFrameThickness="0,0,0,1"
                      ResizeBorderThickness="4"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid x:Name="AppContainer">
        <i:Interaction.Triggers>
            <i:DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}, Path=WindowState}" Value="{x:Static WindowState.Maximized}">
                <i:ChangePropertyAction PropertyName="Margin" Value="8" />
            </i:DataTrigger>
            <i:DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}, Path=WindowState}"
                           Comparison="NotEqual"
                           Value="{x:Static WindowState.Maximized}">
                <i:ChangePropertyAction PropertyName="Margin" Value="0" />
            </i:DataTrigger>
        </i:Interaction.Triggers>

        <Grid x:Name="HomeContainer" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <!-- 首页区域 -->
            <ContentControl Grid.Row="0"
                            Grid.RowSpan="2"
                            prism:RegionManager.RegionName="{x:Static constants:HostRegionNames.HomeRegion}" />
            <!-- 内容区域 -->
            <ContentControl Grid.Row="0"
                            Grid.RowSpan="2"
                            prism:RegionManager.RegionName="{x:Static constants:HostRegionNames.MainRegion}" />

            <!--#region 窗口标题栏-->
            <Grid x:Name="AppTitleContainer"
                  Grid.Row="0"
                  Grid.RowSpan="2"
                  Height="36"
                  VerticalAlignment="Top"
                  Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseLeftButtonDown">
                        <i:CallMethodAction MethodName="DragMove" TargetObject="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Width="32"
                            Height="32"
                            Padding="0"
                            Command="{Binding GoBackCommand}"
                            Style="{DynamicResource IconButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <i:Interaction.Triggers>
                            <i:DataTrigger Binding="{Binding NavigationService.CanGoBack}" Value="True">
                                <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Visible}" />
                            </i:DataTrigger>
                            <i:DataTrigger Binding="{Binding NavigationService.CanGoBack}" Value="False">
                                <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Collapsed}" />
                            </i:DataTrigger>
                        </i:Interaction.Triggers>
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="24" Height="24">
                                <Path Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" Fill="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Button}}, Path=Foreground}" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Image Margin="8" Source="/Assets/Icons/AuraEcho.ico" />
                    <TextBlock VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource Brushes.OnSurface}"
                               Text="{Binding Source={StaticResource R}, Path=Labels.AppName}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <Button x:Name="RestartTipsButton"
                            Margin="0,0,4,0"
                            Padding="16,6"
                            VerticalAlignment="Center"
                            auraecho:ControlHelper.CornerRadius="4"
                            Click="RestartTipsButton_Click"
                            Content="更新"
                            Visibility="Visible"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <i:Interaction.Triggers>
                            <i:DataTrigger Binding="{Binding PendingRestartItems.Count}" Value="0">
                                <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Collapsed}" />
                            </i:DataTrigger>
                            <i:DataTrigger Binding="{Binding PendingRestartItems.Count}"
                                           Comparison="NotEqual"
                                           Value="0">
                                <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Visible}" />
                            </i:DataTrigger>
                        </i:Interaction.Triggers>
                    </Button>

                    <Button Width="47"
                            auraecho:ControlHelper.CornerRadius="0"
                            FontSize="15"
                            IsTabStop="False"
                            Style="{DynamicResource IconButtonStyle}"
                            ToolTip="{Binding Source={StaticResource R}, Path=Labels.Window_Minimize}"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Click">
                                <i:ChangePropertyAction PropertyName="WindowState"
                                                        TargetObject="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                                                        Value="Minimized" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <Canvas Width="16" Height="16">
                            <Rectangle Canvas.Left="2.0"
                                       Canvas.Top="8.0"
                                       Width="12.0"
                                       Height="1.0"
                                       Fill="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Button}}, Path=Foreground}"
                                       RadiusX="0.5"
                                       RadiusY="0.5" />
                        </Canvas>
                    </Button>
                    <Button x:Name="MinMaxWindowButton"
                            Width="47"
                            auraecho:ControlHelper.CornerRadius="0"
                            Click="MaxWin_MouseClick"
                            FontSize="15"
                            IsTabStop="False"
                            Style="{DynamicResource IconButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True">

                        <Grid>
                            <i:Interaction.Triggers>
                                <i:DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}, Path=WindowState}" Value="{x:Static WindowState.Normal}">
                                    <i:ChangePropertyAction PropertyName="Visibility"
                                                            TargetName="MaxWindowIcon"
                                                            Value="{x:Static Visibility.Visible}" />
                                    <i:ChangePropertyAction PropertyName="ToolTip"
                                                            TargetName="MinMaxWindowButton"
                                                            Value="{Binding Source={StaticResource R}, Path=Labels.Window_Maximize}" />
                                    <i:ChangePropertyAction PropertyName="Visibility"
                                                            TargetName="RestoreWindowIcon"
                                                            Value="{x:Static Visibility.Hidden}" />
                                </i:DataTrigger>
                                <i:DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}, Path=WindowState}"
                                               Comparison="NotEqual"
                                               Value="{x:Static WindowState.Normal}">
                                    <i:ChangePropertyAction PropertyName="Visibility"
                                                            TargetName="MaxWindowIcon"
                                                            Value="{x:Static Visibility.Hidden}" />
                                    <i:ChangePropertyAction PropertyName="ToolTip"
                                                            TargetName="MinMaxWindowButton"
                                                            Value="{Binding Source={StaticResource R}, Path=Labels.Window_Reduction}" />
                                    <i:ChangePropertyAction PropertyName="Visibility"
                                                            TargetName="RestoreWindowIcon"
                                                            Value="{x:Static Visibility.Visible}" />
                                </i:DataTrigger>
                            </i:Interaction.Triggers>
                            <Viewbox x:Name="MaxWindowIcon"
                                     Width="12"
                                     Height="12"
                                     Visibility="Hidden">
                                <Canvas Width="10" Height="10">
                                    <Path Data="M 10 1 C 10 0.45 9.55 0 9 0 H 1 C 0.45 0 0 0.45 0 1 V 9 C 0 9.55 0.45 10 1 10 H 9 C 9.55 10 10 9.55 10 9 V 1 Z M 1 1 H 9 V 9 H 1 V 1 Z" Fill="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Button}}, Path=Foreground}" />
                                </Canvas>
                            </Viewbox>

                            <Viewbox x:Name="RestoreWindowIcon"
                                     Width="16"
                                     Height="16">
                                <Canvas Width="16.0" Height="16.0">
                                    <Rectangle Canvas.Left="2.5"
                                               Canvas.Top="4.5"
                                               Width="9.0"
                                               Height="9.0"
                                               RadiusX="0.5"
                                               RadiusY="0.5"
                                               Stroke="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Button}}, Path=Foreground}"
                                               StrokeDashCap="Flat"
                                               StrokeThickness="1.0" />
                                    <Path Stroke="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Button}}, Path=Foreground}"
                                          StrokeDashCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="1.0">
                                        <Path.Data>
                                            <PathGeometry Figures="M 5.5 4.48421 L 5.5 3 C 5.5 2.72386 5.72386 2.5 6 2.5 H 13 C 13.2761 2.5 13.5 2.72386 13.5 3 V 10 C 13.5 10.2761 13.2761 10.5 13 10.5 H 11.5102" FillRule="Nonzero" />
                                        </Path.Data>
                                    </Path>
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Button>
                    <Button Width="47"
                            auraecho:ControlHelper.CornerRadius="0"
                            BorderThickness="0"
                            Click="CloseWindowButton_Click"
                            FontSize="15"
                            IsTabStop="False"
                            Style="{DynamicResource IconButtonStyle}"
                            ToolTip="{Binding Source={StaticResource R}, Path=Labels.Window_Close}"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Canvas Width="16" Height="16">
                            <Path Data="M 3.14645 3.14645 C 3.34171 2.95118 3.65829 2.95118 3.85355 3.14645 L 8 7.293 L 12.1464 3.14645 C 12.32 2.97288 12.5894 2.9536 12.7843 3.08859 L 12.8536 3.14645 C 13.0488 3.34171 13.0488 3.65829 12.8536 3.85355 L 8.707 8 L 12.8536 12.1464 C 13.0271 12.32 13.0464 12.5894 12.9114 12.7843 L 12.8536 12.8536 C 12.6583 13.0488 12.3417 13.0488 12.1464 12.8536 L 8 8.707 L 3.85355 12.8536 C 3.67999 13.0271 3.41056 13.0464 3.21569 12.9114 L 3.14645 12.8536 C 2.95118 12.6583 2.95118 12.3417 3.14645 12.1464 L 7.293 8 L 3.14645 3.85355 C 2.97288 3.67999 2.9536 3.41056 3.08859 3.21569 L 3.14645 3.14645 Z" Fill="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Button}}, Path=Foreground}" />
                        </Canvas>
                    </Button>

                    <Popup x:Name="PendingRestartPopup"
                           AllowsTransparency="True"
                           HorizontalOffset="-64"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=RestartTipsButton}"
                           StaysOpen="False"
                           VerticalOffset="4">
                        <Border Width="200"
                                Margin="16"
                                Padding="16"
                                UseLayoutRounding="True"
                                Background="{DynamicResource Brushes.SurfaceContainerHighest}"
                                BorderBrush="{DynamicResource Brushes.OutlineVariant}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20"
                                                  Direction="270"
                                                  Opacity="0.15"
                                                  ShadowDepth="6" />
                            </Border.Effect>
                            <Grid RowDefinitions="Auto, *, Auto">
                                <TextBlock FontSize="14" Foreground="{DynamicResource Brushes.OnSurfaceVariant}" Text="重启以更新" Margin="0, 0, 0, 8"/>
                                <ItemsControl Grid.Row="1"
                                              Margin="0, 0, 0, 8"
                                              ItemsSource="{Binding PendingRestartItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="14">
                                                <Run Text="{Binding Name}" />
                                                |<Run Text="{Binding Description}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Grid.Row="2"
                                        Padding="0,8"
                                        FontSize="14"
                                        Style="{DynamicResource PrimaryButtonStyle}"
                                        Command="{Binding Source={StaticResource BindingProxy}, Path=Data.RequestRestartAppCommand}"
                                        Content="现在重启"/>
                            </Grid>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
            <!--#endregion-->
            <!-- 提示消息区域 -->
            <ContentControl Grid.Row="0"
                            Grid.RowSpan="2"
                            prism:RegionManager.RegionName="{x:Static constants:HostRegionNames.ContentDialogRegion}" />

            <!--#region 错误消息区域-->
            <ContentControl Grid.Row="0"
                            Height="36"
                            prism:RegionManager.RegionName="{x:Static constants:HostRegionNames.ErrorRegion}" />
            <!--#endregion-->

            <!-- Toast 区域 -->
            <ItemsControl Grid.Row="1"
                          Margin="0,24,24,0"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          d:ItemsSource="{d:SampleData ItemCount=3}"
                          Grid.ZIndex="999"
                          ItemsSource="{Binding ToastService.ActiveToasts}">

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type pm:AuraToast}">
                        <Border x:Name="ToastBorder"
                                MaxWidth="250"
                                Margin="0,0,0,10"
                                Padding="20,12"
                                HorizontalAlignment="Right"
                                Background="{DynamicResource Brushes.SurfaceContainerHighest}"
                                BorderBrush="{DynamicResource Brushes.OutlineShadow}"
                                BorderThickness="1"
                                CornerRadius="4"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20"
                                                  Direction="270"
                                                  Opacity="0.15"
                                                  ShadowDepth="6" />
                            </Border.Effect>
                            <Border.LayoutTransform>
                                <ScaleTransform x:Name="LayoutScale" ScaleY="1" />
                            </Border.LayoutTransform>

                            <Border.RenderTransform>
                                <TranslateTransform x:Name="RenderMove" Y="0" />
                            </Border.RenderTransform>
                            <TextBlock x:Name="MessageTextBlock"
                                       d:Foreground="{DynamicResource Brushes.OnSurface}"
                                       d:Text="验证码已发送至 example@domain.com"
                                       FontSize="12"
                                       Text="{Binding Message}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Level}" Value="Info">
                                <Setter TargetName="MessageTextBlock" Property="Foreground" Value="{DynamicResource Brushes.OnSurface}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Success">
                                <Setter TargetName="MessageTextBlock" Property="Foreground" Value="{DynamicResource Brushes.Success}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Warning">
                                <Setter TargetName="MessageTextBlock" Property="Foreground" Value="{DynamicResource Brushes.Warning}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                <Setter TargetName="MessageTextBlock" Property="Foreground" Value="{DynamicResource Brushes.Error}" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding IsClosing}" Value="False">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ToastBorder"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0"
                                                             To="1"
                                                             Duration="0:0:0.3" />
                                            <DoubleAnimation Storyboard.TargetName="RenderMove"
                                                             Storyboard.TargetProperty="Y"
                                                             From="20"
                                                             To="0"
                                                             Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="1" EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ToastBorder"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.3" />
                                            <DoubleAnimation Storyboard.TargetName="RenderMove"
                                                             Storyboard.TargetProperty="Y"
                                                             To="-20"
                                                             Duration="0:0:1">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="LayoutScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0"
                                                             Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>

                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</Window>
