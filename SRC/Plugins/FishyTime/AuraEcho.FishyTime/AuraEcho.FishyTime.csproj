		<PackageReference Include="System.Management" Version="9.0.6" />
	</ItemGroup>
	<ItemGroup>
		<Folder Include="Events\" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\..\Shared\AuraEcho.Design\SRC\AuraEcho.Design\AuraEcho.Design.csproj" />
		<ProjectReference Include="..\..\..\Shared\AuraEcho.PluginContracts\AuraEcho.PluginContracts.csproj">
