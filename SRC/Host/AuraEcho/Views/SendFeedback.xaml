                                        VerticalAlignment="Center">
                                <TextBlock VerticalAlignment="Center"
                                           Style="{DynamicResource BodyLargeTextBlockStyle}"
                                           Text="{Binding Source={StaticResource Loc}, Path=Labels.SendFeedback_GitHub}" />
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brushes.OnSurfaceVariant}"
                                           Style="{DynamicResource BodyMediumTextBlockStyle}"
                                           Text="{Binding Source={StaticResource Loc}, Path=Labels.SendFeedback_GitHubDescription}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Margin="4"
                                    Padding="16,8"
