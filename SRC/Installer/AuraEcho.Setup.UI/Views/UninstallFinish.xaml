<UserControl x:Class="AuraEcho.Setup.UI.Views.UninstallFinish"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:ui="http://ui.auraecho.com/"
             xmlns:viewmodels="clr-namespace:AuraEcho.Setup.UI.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:UninstallFinishViewModel}"
             d:DesignHeight="500"
             d:DesignWidth="750"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">
    <Grid>
        <StackPanel Margin="0,0,0,100" VerticalAlignment="Bottom">
            <Border Width="330"
                    Height="42"
                    Margin="0,0,0,100"
                    Padding="16,8"
                    Background="#1A00C853"
                    BorderBrush="#00C853"
                    BorderThickness="1"
                    CornerRadius="4">
                <i:Interaction.Behaviors>
                    <ui:LoadedEntranceAnimationBehavior />
                </i:Interaction.Behaviors>
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="16"
                             Height="16"
                             Margin="0,2,4,0">
                        <Canvas Width="16" Height="16">
                            <Path Data="M 13.33 4 L 6 11.33 L 2.67 8"
                                  Stroke="#ff00b400"
                                  StrokeDashCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="2.0" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="16"
                               Foreground="#00C853"
                               Text="已成功将灵光回声从此计算机中移除。" />
                </StackPanel>
            </Border>
            <Button Width="200"
                    Height="48"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Command="{Binding FinishedCommand}"
                    Content="完成"
                    FontSize="18"
                    Style="{DynamicResource PrimaryButtonStyle}">
                <i:Interaction.Behaviors>
                    <ui:LoadedEntranceAnimationBehavior Delay="0:0:0.07" />
                </i:Interaction.Behaviors>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
