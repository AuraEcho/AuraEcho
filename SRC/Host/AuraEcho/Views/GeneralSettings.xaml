<UserControl x:Class="AuraEcho.Views.GeneralSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AuraEcho.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pm="clr-namespace:AuraEcho.PluginContracts.Models;assembly=AuraEcho.PluginContracts"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:ub="clr-namespace:AuraEcho.UIToolkit.Behaviors;assembly=AuraEcho.UIToolkit"
             xmlns:viewmodels="clr-namespace:AuraEcho.ViewModels"
             d:Background="{DynamicResource Brushes.SurfaceContainerLowest}"
             d:DataContext="{d:DesignInstance Type=viewmodels:GeneralSettingsViewModel}"
             d:DesignHeight="425"
             d:DesignWidth="495"
             d:Foreground="{DynamicResource Brushes.OnSurface}"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:LanguageDisplayNameConverter x:Key="LanguageDisplayName" />
    </UserControl.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadSettingsCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <StackPanel Margin="24,0,24,24">
            <TextBlock Margin="0,0,0,24"
                       HorizontalAlignment="Left"
                       Style="{DynamicResource HeadlineLargeTextBlockStyle}"
                       Text="{Binding Source={StaticResource Loc}, Path=Labels.GeneralSettings_Title}" />
            <Border Height="64"
                    Margin="0,0,0,4"
                    Padding="16,0"
                    Background="{DynamicResource Brushes.SurfaceContainer}"
                    BorderBrush="{DynamicResource Brushes.OutlineInner}"
                    BorderThickness="1"
                    CornerRadius="4">
                <DockPanel LastChildFill="True">
                    <ComboBox x:Name="LanguagesComboBox"
                              Margin="4"
                              VerticalAlignment="Center"
                              d:SelectedItem="{x:Static pm:AppLanguage.ChineseSimplified}"
                              DockPanel.Dock="Right"
                              SelectedIndex="0"
                              SelectedItem="{Binding AppLanguage}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource LanguageDisplayName}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <ComboBox.ItemsSource>
                            <x:Array Type="{x:Type pm:AppLanguage}">
                                <x:Static Member="pm:AppLanguage.ChineseSimplified" />
                                <x:Static Member="pm:AppLanguage.English" />
                                <x:Static Member="pm:AppLanguage.Korean" />
                                <x:Static Member="pm:AppLanguage.Japanese" />
                            </x:Array>
                        </ComboBox.ItemsSource>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="24"
                                 Height="24"
                                 Margin="0,0,16,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="M12.87,15.07L10.33,12.56L10.36,12.53C12.1,10.59 13.34,8.36 14.07,6H17V4H10V2H8V4H1V6H12.17C11.5,7.92 10.44,9.75 9,11.35C8.07,10.32 7.3,9.19 6.69,8H4.69C5.42,9.63 6.42,11.17 7.67,12.56L2.58,17.58L4,19L9,14L12.11,17.11L12.87,15.07M18.5,10H16.5L12,22H14L15.12,19H19.87L21,22H23L18.5,10M15.88,17L17.5,12.67L19.12,17H15.88Z" Fill="{DynamicResource Brushes.OnSurface}" />
                            </Canvas>
                        </Viewbox>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center"
                                       Style="{DynamicResource BodyLargeTextBlockStyle}"
                                       Text="{Binding Source={StaticResource Loc}, Path=Labels.GeneralSettings_Language}" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brushes.OnSurfaceVariant}"
                                       Style="{DynamicResource BodyMediumTextBlockStyle}"
                                       Text="{Binding Source={StaticResource Loc}, Path=Labels.GeneralSettings_LanguageDescription}" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Height="64"
                    Margin="0,0,0,4"
                    Padding="16,0"
                    Background="{DynamicResource Brushes.SurfaceContainer}"
                    BorderBrush="{DynamicResource Brushes.OutlineInner}"
                    BorderThickness="1"
                    CornerRadius="4">
                <DockPanel LastChildFill="True">
                    <ComboBox x:Name="ThemesComboBox"
                              Margin="4"
                              VerticalAlignment="Center"
                              DockPanel.Dock="Right"
                              SelectedIndex="0"
                              SelectedItem="{Binding AppTheme}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <i:Interaction.Triggers>
                                        <i:DataTrigger Binding="{Binding}" Value="{x:Static pm:AppTheme.Light}">
                                            <ub:SetBindingAction Binding="{Binding Source={StaticResource Loc}, Path=Labels.AppTheme_Light}" PropertyName="Text" />
                                        </i:DataTrigger>
                                        <i:DataTrigger Binding="{Binding}" Value="{x:Static pm:AppTheme.Dark}">
                                            <ub:SetBindingAction Binding="{Binding Source={StaticResource Loc}, Path=Labels.AppTheme_Dark}" PropertyName="Text" />
                                        </i:DataTrigger>
                                        <i:DataTrigger Binding="{Binding}" Value="{x:Static pm:AppTheme.FollowSystem}">
                                            <ub:SetBindingAction Binding="{Binding Source={StaticResource Loc}, Path=Labels.AppTheme_FollowSystem}" PropertyName="Text" />
                                        </i:DataTrigger>
                                    </i:Interaction.Triggers>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <ComboBox.ItemsSource>
                            <x:Array Type="{x:Type pm:AppTheme}">
                                <x:Static Member="pm:AppTheme.Light" />
                                <x:Static Member="pm:AppTheme.Dark" />
                                <x:Static Member="pm:AppTheme.FollowSystem" />
                            </x:Array>
                        </ComboBox.ItemsSource>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="24"
                                 Height="24"
                                 Margin="0,0,16,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="M7.5,2C5.71,3.15 4.5,5.18 4.5,7.5C4.5,9.82 5.71,11.85 7.53,13C4.46,13 2,10.54 2,7.5A5.5,5.5 0 0,1 7.5,2M19.07,3.5L20.5,4.93L4.93,20.5L3.5,19.07L19.07,3.5M12.89,5.93L11.41,5L9.97,6L10.39,4.3L9,3.24L10.75,3.12L11.33,1.47L12,3.1L13.73,3.13L12.38,4.26L12.89,5.93M9.59,9.54L8.43,8.81L7.31,9.59L7.65,8.27L6.56,7.44L7.92,7.35L8.37,6.06L8.88,7.33L10.24,7.36L9.19,8.23L9.59,9.54M19,13.5A5.5,5.5 0 0,1 13.5,19C12.28,19 11.15,18.6 10.24,17.93L17.93,10.24C18.6,11.15 19,12.28 19,13.5M14.6,20.08L17.37,18.93L17.13,22.28L14.6,20.08M18.93,17.38L20.08,14.61L22.28,17.15L18.93,17.38M20.08,12.42L18.94,9.64L22.28,9.88L20.08,12.42M9.63,18.93L12.4,20.08L9.87,22.27L9.63,18.93Z" Fill="{DynamicResource Brushes.OnSurface}" />
                            </Canvas>
                        </Viewbox>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center"
                                       Style="{DynamicResource BodyLargeTextBlockStyle}"
                                       Text="{Binding Source={StaticResource Loc}, Path=Labels.GeneralSettings_Theme}" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brushes.OnSurfaceVariant}"
                                       Style="{DynamicResource BodyMediumTextBlockStyle}"
                                       Text="{Binding Source={StaticResource Loc}, Path=Labels.GeneralSettings_ThemeDescription}" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Height="64"
                    Margin="0,0,0,4"
                    Padding="16,0"
                    Background="{DynamicResource Brushes.SurfaceContainer}"
                    BorderBrush="{DynamicResource Brushes.OutlineInner}"
                    BorderThickness="1"
                    CornerRadius="4">
                <DockPanel LastChildFill="True">
                    <CheckBox VerticalAlignment="Center"
                              DockPanel.Dock="Right"
                              IsChecked="{Binding HardwareAcceleration}"
                              Style="{DynamicResource ToggleSwitchCheckBox}" />
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="24"
                                 Height="24"
                                 Margin="0,0,16,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="M2 7H4.5V17H3V8.5H2M22 7V16H14V17H7V16H6V7M10 9H8V12H10M13 9H11V12H13M20 9H15V14H20V9Z" Fill="{DynamicResource Brushes.OnSurface}" />
                            </Canvas>
                        </Viewbox>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center"
                                       Style="{DynamicResource BodyLargeTextBlockStyle}"
                                       Text="{Binding Source={StaticResource Loc}, Path=Labels.GeneralSettings_HardwareAcceleration}" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brushes.OnSurfaceVariant}"
                                       Style="{DynamicResource BodyMediumTextBlockStyle}"
                                       Text="{Binding Source={StaticResource Loc}, Path=Labels.GeneralSettings_HardwareAccelerationDescription}" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Height="64"
                    Margin="0,0,0,4"
                    Padding="16,0"
                    Background="{DynamicResource Brushes.SurfaceContainer}"
                    BorderBrush="{DynamicResource Brushes.OutlineInner}"
                    BorderThickness="1"
                    CornerRadius="4">
                <DockPanel LastChildFill="True">
                    <CheckBox VerticalAlignment="Center"
                              DockPanel.Dock="Right"
                              IsChecked="{Binding RunAtBoot}"
                              Style="{DynamicResource ToggleSwitchCheckBox}" />
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="24"
                                 Height="24"
                                 Margin="0,0,16,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="M2,3H11V12H2V3M11,22H2V13H11V22M21,3V12H12V3H21M21,22H12V13H21V22Z" Fill="{DynamicResource Brushes.OnSurface}" />
                            </Canvas>
                        </Viewbox>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center"
                                       Style="{DynamicResource BodyLargeTextBlockStyle}"
                                       Text="{Binding Source={StaticResource Loc}, Path=Labels.GeneralSettings_RunAtBoot}" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brushes.OnSurfaceVariant}"
                                       Style="{DynamicResource BodyMediumTextBlockStyle}"
                                       Text="{Binding Source={StaticResource Loc}, Path=Labels.GeneralSettings_RunAtBootDescription}" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>