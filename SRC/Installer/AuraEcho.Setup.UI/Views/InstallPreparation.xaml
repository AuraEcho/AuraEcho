<UserControl x:Class="AuraEcho.Setup.UI.Views.InstallPreparation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:viewmodels="clr-namespace:AuraEcho.Setup.UI.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:InstallPreparationViewModel}"
             d:DesignHeight="500"
             d:DesignWidth="750"
             d:Foreground="{DynamicResource Brushes.OnSurface}"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">
    <Grid Margin="24">
        <StackPanel Grid.Row="0"
                    Margin="0,60,0,0"
                    VerticalAlignment="Bottom">
            <StackPanel x:Name="CustomInstallationLayout"
                        d:Visibility="Visible"
                        Visibility="Hidden">
                <StackPanel Height="40"
                            Margin="0,0,0,12"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Text="安装在" />
                    <Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       MaxWidth="500"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       d:Text="C:\Program Files\AuraEcho"
                                       FontSize="14"
                                       Text="{Binding TargetInstallFolder}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding TargetInstallFolder}" />
                            <Button Grid.Column="1"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Click="SelectFolderButton_Click"
                                    Style="{DynamicResource IconButtonStyle}">
                                <Viewbox Width="16" Height="16">
                                    <Canvas Width="16"
                                            Height="16"
                                            UseLayoutRounding="False">
                                        <Path Data="M 1.5 4.5 V 2.5 H 6.5 L 8.5 4.5 H 14.5 V 13.5 H 1.5 V 4.5 Z"
                                              Stroke="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}}, Path=Foreground}"
                                              StrokeDashCap="Flat"
                                              StrokeLineJoin="Round"
                                              StrokeThickness="1" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
                <StackPanel Margin="0,0,0,24"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                    <CheckBox Margin="0,0,48,0"
                              Content="创建桌面图标"
                              IsChecked="{Binding IsCreateDesktopFolderShortcut}" />
                    <CheckBox Content="开机默认启动 " IsChecked="{Binding IsRunAtBoot}" />
                </StackPanel>
            </StackPanel>
            <Button Width="200"
                    Height="48"
                    Margin="0,0,0,52"
                    HorizontalAlignment="Center"
                    Command="{Binding InstallCommand}"
                    Content="开始安装"
                    FontSize="16"
                    Style="{DynamicResource PrimaryButtonStyle}"
                    TextOptions.TextFormattingMode="Display" />
            <Grid>
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <TextBlock FontSize="14">
                        <TextBlock Foreground="{DynamicResource Brushes.OnSurfaceVariant}" Text="点击开始安装，即代表您已同意" />
                        <Hyperlink Command="{Binding OpenEULACommand}">
                            最终用户许可协议
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <TextBlock FontSize="14">
                        <Hyperlink x:Name="CustomInstallationHyperLink" Click="CustomInstallationHyperLink_Click">
                            <Run x:Name="CustomInstallationRun">自定义安装</Run>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
