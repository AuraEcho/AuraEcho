<UserControl x:Class="AuraEcho.Views.Purchase"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:acm="clr-namespace:AuraEcho.Api.Models.V1.Common;assembly=AuraEcho.Api.Models"
             xmlns:apiOrder="clr-namespace:AuraEcho.Api.Models.V1.Order;assembly=AuraEcho.Api.Models"
             xmlns:converters="clr-namespace:AuraEcho.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:AuraEcho.Core.Models;assembly=AuraEcho.Core"
             xmlns:ocm="clr-namespace:AuraEcho.Api.Models.V1.Order;assembly=AuraEcho.Api.Models"
             xmlns:pcap="clr-namespace:AuraEcho.PluginContracts.AttachedProperties;assembly=AuraEcho.PluginContracts"
             xmlns:pcm="clr-namespace:AuraEcho.PluginContracts.Models;assembly=AuraEcho.PluginContracts"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:ui="http://ui.auraecho.com/"
             xmlns:viewmodels="clr-namespace:AuraEcho.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:PurchaseViewModel}"
             d:DesignHeight="640"
             d:DesignWidth="982"
             d:Foreground="{DynamicResource Brushes.OnSurface}"
             prism:ViewModelLocator.AutoWireViewModel="True"
             UseLayoutRounding="True"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ui:BindingProxy x:Key="BindingProxy" Data="{Binding}" />
        <converters:QRCodeToBitmapConverter x:Key="QRCodeToBitmap" />
        <converters:PaymentChannelColorConverter x:Key="PaymentChannelColor" />
        <converters:PaymentChannelBrushConverter x:Key="PaymentChannelBrush" />
        <ui:EnumToBooleanConverter x:Key="EnumToBoolean" />
        <DataTemplate x:Key="SkuTemplate" DataType="{x:Type models:Sku}">
            <RadioButton Width="108"
                         Command="{Binding Source={StaticResource BindingProxy}, Path=Data.SelectSkuCommand}"
                         CommandParameter="{Binding}"
                         GroupName="SkuGroup"
                         Style="{DynamicResource CardRadioButtonStyle}">
                <i:Interaction.Triggers>
                    <i:DataTrigger Binding="{Binding Source={StaticResource BindingProxy}, Path=Data.SelectedSku}" Value="{Binding}">
                        <i:ChangePropertyAction PropertyName="IsChecked" Value="True" />
                    </i:DataTrigger>
                </i:Interaction.Triggers>
                <Border CornerRadius="4">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Margin="0,0,0,8"
                                   HorizontalAlignment="Center"
                                   d:Text="SKU名称"
                                   FontSize="{DynamicResource FontSize.Title.Small}"
                                   Foreground="{DynamicResource Brushes.OnSurface}">
                            <i:Interaction.Triggers>
                                <i:DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type RadioButton}}, Path=IsChecked}" Value="False">
                                    <i:ChangePropertyAction PropertyName="FontWeight" Value="Regular" />
                                </i:DataTrigger>
                                <i:DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type RadioButton}}, Path=IsChecked}" Value="True">
                                    <i:ChangePropertyAction PropertyName="FontWeight" Value="SemiBold" />
                                </i:DataTrigger>
                                <i:DataTrigger Binding="{Binding Type}" Value="{x:Static pcm:LicenseType.Monthly}">
                                    <ui:SetBindingAction PropertyName="Text" Binding="{Binding Source={StaticResource R}, Path=Labels.Purchase_MonthlyLicense}" />
                                </i:DataTrigger>
                                <i:DataTrigger Binding="{Binding Type}" Value="{x:Static pcm:LicenseType.Yearly}">
                                    <ui:SetBindingAction PropertyName="Text" Binding="{Binding Source={StaticResource R}, Path=Labels.Purchase_YearlyLicense}" />
                                </i:DataTrigger>
                                <i:DataTrigger Binding="{Binding Type}" Value="{x:Static pcm:LicenseType.Lifetime}">
                                    <ui:SetBindingAction PropertyName="Text" Binding="{Binding Source={StaticResource R}, Path=Labels.Purchase_LifetimeLicense}" />
                                </i:DataTrigger>
                            </i:Interaction.Triggers>
                        </TextBlock>

                        <TextBlock Margin="0,0,0,4" HorizontalAlignment="Center">
                            <Run FontSize="{DynamicResource FontSize.Body.Large}" Text="￥" /><Run d:Text="0.5"
                                 FontSize="{DynamicResource FontSize.Headline.Medium}"
                                 FontWeight="SemiBold"
                                 Text="{Binding SalePrice, StringFormat={}{0:0.##}}" />
                        </TextBlock>
                        <TextBlock HorizontalAlignment="Center"
                                   d:Text="￥2.00"
                                   FontSize="{DynamicResource FontSize.Body.Medium}"
                                   Foreground="{DynamicResource Brushes.OnSurfaceVariant}"
                                   Text="{Binding OriginalPrice, StringFormat=￥{0:0.##}}"
                                   TextDecorations="Strikethrough" />

                    </StackPanel>
                </Border>
            </RadioButton>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Background="{DynamicResource Brushes.Scrim}">
        <Grid MinWidth="590"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">

            <Border Background="{DynamicResource Brushes.SurfaceContainerHighest}"
                    BorderBrush="{DynamicResource Brushes.OutlineShadow}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                                      Direction="270"
                                      Opacity="0.15"
                                      ShadowDepth="8" />
                </Border.Effect>
                <Grid RowDefinitions="Auto, *">
                    <!-- Banner -->
                    <Border Grid.Row="0"
                            Height="108"
                            Background="#e76a8d"
                            CornerRadius="8, 8, 0, 0">
                        <Grid>
                            <Border>
                                <Border.Background>
                                    <ImageBrush ImageSource="/Assets/Images/pay_banner_shapes.png" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <Border Margin="0,0,24,0"
                                    Padding="12"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="#44000000"
                                    CornerRadius="8">

                                <StackPanel Width="294"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            TextBlock.Foreground="White">
                                    <TextBlock Margin="0,0,0,8"
                                               d:Text="您的订阅将直接支持{插件名称}的持续开发与维护，感谢!"
                                               FontWeight="Regular"
                                               Style="{DynamicResource BodyMediumTextBlockStyle}"
                                               TextWrapping="Wrap">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}{1}{2}">
                                                <Binding Path="Labels.Purchase_SubscriptionSupportMessagePrefix" Source="{StaticResource R}" />
                                                <Binding Path="CurrentPlugin.Name" />
                                                <Binding Path="Labels.Purchase_SubscriptionSupportMessageSuffix" Source="{StaticResource R}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock HorizontalAlignment="Right"
                                               d:Text="—— Suencesoft"
                                               FontWeight="Regular"
                                               Style="{DynamicResource BodyMediumTextBlockStyle}"
                                               Text="{Binding CurrentPlugin.Author, StringFormat=—— {0}}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- MainContent -->
                    <Border Grid.Row="1" Padding="24,16,24,24">
                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, *">

                            <Grid Grid.Row="0"
                                  Grid.Column="0"
                                  Grid.ColumnSpan="2">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="42"
                                            Height="42"
                                            Margin="0,0,8,0"
                                            d:Background="Gray"
                                            CornerRadius="4"
                                            DockPanel.Dock="Left">
                                        <Border.Background>
                                            <ImageBrush pcap:WebImageHelper.DecodePixelWidth="96"
                                                        pcap:WebImageHelper.Url="{Binding CurrentPlugin.IconFileUrl}"
                                                        Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,4"
                                                   d:Text="插件名称"
                                                   Style="{DynamicResource TitleSmallTextBlockStyle}"
                                                   Text="{Binding CurrentPlugin.Name}" />
                                        <TextBlock FontSize="{DynamicResource FontSize.Body.Medium}" Foreground="{DynamicResource Brushes.OnSurfaceVariant}">
                                            <i:Interaction.Triggers>
                                                <i:DataTrigger Binding="{Binding CurrentPluginLicense}" Value="{x:Null}">
                                                    <i:ChangePropertyAction PropertyName="Visibility"
                                                                            TargetName="HasnotLicenseRun"
                                                                            Value="{x:Static Visibility.Visible}" />
                                                    <i:ChangePropertyAction PropertyName="Visibility"
                                                                            TargetName="HasLicenseRun"
                                                                            Value="{x:Static Visibility.Collapsed}" />
                                                </i:DataTrigger>
                                                <i:DataTrigger Binding="{Binding CurrentPluginLicense}"
                                                               Comparison="NotEqual"
                                                               Value="{x:Null}">
                                                    <i:ChangePropertyAction PropertyName="Visibility"
                                                                            TargetName="HasnotLicenseRun"
                                                                            Value="{x:Static Visibility.Collapsed}" />
                                                    <i:ChangePropertyAction PropertyName="Visibility"
                                                                            TargetName="HasLicenseRun"
                                                                            Value="{x:Static Visibility.Visible}" />
                                                </i:DataTrigger>
                                            </i:Interaction.Triggers>
                                            <TextBlock x:Name="HasnotLicenseRun" d:Text="开通订阅，解锁{插件名称}所有功能。">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0}{1}{2}">
                                                        <Binding Path="Labels.Purchase_SubscribeToUnlockPrefix" Source="{StaticResource R}" />
                                                        <Binding Path="CurrentPlugin.Name" />
                                                        <Binding Path="Labels.Purchase_SubscribeToUnlockSuffix" Source="{StaticResource R}" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock x:Name="HasLicenseRun">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0}{1:yyyy/MM/dd}{2}">
                                                        <Binding Path="Labels.Purchase_SubscriptionExpiryPrefix" Source="{StaticResource R}" />
                                                        <Binding Path="CurrentPluginLicense.ExpiredAt" />
                                                        <Binding Path="Labels.Purchase_SubscriptionExpirySuffix" Source="{StaticResource R}" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </TextBlock>

                                    </StackPanel>
                                </StackPanel>
                                <Button Width="45"
                                        Height="36"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        BorderThickness="0"
                                        Command="{Binding CloseCommand}"
                                        FontSize="15"
                                        IsTabStop="False"
                                        Style="{DynamicResource IconButtonStyle}"
                                        ToolTip="{Binding Source={StaticResource R}, Path=Labels.Window_Close}"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Button.RenderTransform>
                                        <TranslateTransform X="8" Y="-8" />
                                    </Button.RenderTransform>
                                    <Viewbox Width="20" Height="20">
                                        <Canvas Width="16" Height="16">
                                            <Path Data="M 3.14645 3.14645 C 3.34171 2.95118 3.65829 2.95118 3.85355 3.14645 L 8 7.293 L 12.1464 3.14645 C 12.32 2.97288 12.5894 2.9536 12.7843 3.08859 L 12.8536 3.14645 C 13.0488 3.34171 13.0488 3.65829 12.8536 3.85355 L 8.707 8 L 12.8536 12.1464 C 13.0271 12.32 13.0464 12.5894 12.9114 12.7843 L 12.8536 12.8536 C 12.6583 13.0488 12.3417 13.0488 12.1464 12.8536 L 8 8.707 L 3.85355 12.8536 C 3.67999 13.0271 3.41056 13.0464 3.21569 12.9114 L 3.14645 12.8536 C 2.95118 12.6583 2.95118 12.3417 3.14645 12.1464 L 7.293 8 L 3.14645 3.85355 C 2.97288 3.67999 2.9536 3.41056 3.08859 3.21569 L 3.14645 3.14645 Z" Fill="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Button}}, Path=Foreground}" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                            </Grid>

                            <StackPanel Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,16,16,0">
                                <TextBlock Margin="0,0,0,8"
                                           Style="{DynamicResource BodyMediumTextBlockStyle}"
                                           Text="{Binding Source={StaticResource R}, Path=Labels.Purchase_ChooseSubscription}" />
                                <ItemsControl Height="132"
                                              Margin="0,0,0,16"
                                              d:ItemsSource="{d:SampleData ItemCount=3}"
                                              ItemTemplate="{StaticResource SkuTemplate}"
                                              ItemsSource="{Binding Skus}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel IsItemsHost="True" Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="{x:Type ContentPresenter}">
                                            <Setter Property="Margin" Value="0,0,8,0" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Margin="0,0,0,8"
                                               Style="{DynamicResource BodyMediumTextBlockStyle}"
                                               Text="{Binding Source={StaticResource R}, Path=Labels.Purchase_PaymentMethod}" />
                                    <RadioButton Height="40"
                                                 Margin="0,0,0,4"
                                                 HorizontalContentAlignment="Left"
                                                 GroupName="PaymentChannelGroup"
                                                 IsChecked="{Binding PaymentChannel, Converter={StaticResource EnumToBoolean}, ConverterParameter={x:Static apiOrder:PaymentChannel.Wxpay}}"
                                                 Style="{DynamicResource CardRadioButtonStyle}"
                                                 UseLayoutRounding="True">
                                        <StackPanel Margin="4,0,0,0" Orientation="Horizontal">
                                            <Border Width="24"
                                                    Height="24"
                                                    Margin="0,0,8,0">
                                                <Border.Background>
                                                    <ImageBrush>
                                                        <ImageBrush.ImageSource>
                                                            <BitmapImage DecodePixelHeight="48"
                                                                         DecodePixelWidth="48"
                                                                         UriSource="/Assets/Images/wechat_logo.png" />
                                                        </ImageBrush.ImageSource>
                                                    </ImageBrush>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock VerticalAlignment="Center"
                                                       Style="{DynamicResource BodyMediumTextBlockStyle}"
                                                       Text="{Binding Source={StaticResource R}, Path=Labels.Purchase_WeChatPay}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Height="40"
                                                 HorizontalContentAlignment="Left"
                                                 GroupName="PaymentChannelGroup"
                                                 IsChecked="{Binding PaymentChannel, Converter={StaticResource EnumToBoolean}, ConverterParameter={x:Static apiOrder:PaymentChannel.Alipay}}"
                                                 Style="{DynamicResource CardRadioButtonStyle}">
                                        <StackPanel Margin="4,0,0,0" Orientation="Horizontal">
                                            <Border Width="24"
                                                    Height="24"
                                                    Margin="0,0,8,0">
                                                <Border.Background>
                                                    <ImageBrush>
                                                        <ImageBrush.ImageSource>
                                                            <BitmapImage DecodePixelHeight="48"
                                                                         DecodePixelWidth="48"
                                                                         UriSource="/Assets/Images/alipay_logo.png" />
                                                        </ImageBrush.ImageSource>
                                                    </ImageBrush>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock VerticalAlignment="Center"
                                                       Style="{DynamicResource BodyMediumTextBlockStyle}"
                                                       Text="{Binding Source={StaticResource R}, Path=Labels.Purchase_Alipay}" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </StackPanel>

                            <Grid Grid.Row="0"
                                  Grid.RowSpan="2"
                                  Grid.Column="1"
                                  Width="180"
                                  RowDefinitions="*, Auto">
                                <StackPanel Grid.Row="0" VerticalAlignment="Center">
                                    <TextBlock Margin="0,0,0,0"
                                               HorizontalAlignment="Center"
                                               Foreground="#c38542"
                                               Style="{DynamicResource HeadlineMediumTextBlockStyle}">
                                        <Run FontSize="{DynamicResource FontSize.Title.Large}" Text="￥" /><Run d:Text="0.5" Text="{Binding SelectedSku.SalePrice, StringFormat={}{0:0.##}}" />
                                    </TextBlock>
                                    <TextBlock Margin="0,0,0,8"
                                               HorizontalAlignment="Center"
                                               d:Text="￥2.00"
                                               FontSize="{DynamicResource FontSize.Body.Medium}"
                                               Foreground="{DynamicResource Brushes.OnSurfaceVariant}"
                                               Text="{Binding SelectedSku.OriginalPrice, StringFormat=￥{0:0.##}}"
                                               TextDecorations="Strikethrough" />
                                    <Border Margin="0,0,0,12"
                                            Padding="6"
                                            HorizontalAlignment="Center"
                                            BorderBrush="{Binding ElementName=QRCodeBorder, Path=BorderBrush}"
                                            BorderThickness="2"
                                            CornerRadius="8">
                                        <Grid Width="128" Height="128">

                                            <Border Background="White" CornerRadius="4">
                                                <Grid>
                                                    <Grid.Resources>
                                                        <Storyboard x:Key="ScanAnimation" RepeatBehavior="Forever">
                                                            <DoubleAnimationUsingKeyFrames BeginTime="0:0:0.8"
                                                                                           Storyboard.TargetName="ScanBorder"
                                                                                           Storyboard.TargetProperty="Opacity">
                                                                <DoubleAnimationUsingKeyFrames.KeyFrames>
                                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0" />
                                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="1" />
                                                                    <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="1" />
                                                                    <EasingDoubleKeyFrame KeyTime="0:0:1.5" Value="0" />
                                                                </DoubleAnimationUsingKeyFrames.KeyFrames>
                                                            </DoubleAnimationUsingKeyFrames>
                                                            <DoubleAnimation BeginTime="0:0:0.8"
                                                                             Storyboard.TargetName="ScanBorderTransform"
                                                                             Storyboard.TargetProperty="Y"
                                                                             From="-128"
                                                                             To="0"
                                                                             Duration="0:0:1.5" />
                                                        </Storyboard>
                                                    </Grid.Resources>

                                                    <Image Margin="8" Source="{Binding QRCode, Converter={StaticResource QRCodeToBitmap}}" />
                                                    <Border>
                                                        <i:Interaction.Triggers>
                                                            <i:DataTrigger Binding="{Binding IsOrderCreating}" Value="True">
                                                                <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Hidden}" />
                                                            </i:DataTrigger>
                                                            <i:DataTrigger Binding="{Binding IsOrderCreating}" Value="False">
                                                                <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Visible}" />
                                                            </i:DataTrigger>
                                                        </i:Interaction.Triggers>
                                                        <Border x:Name="ScanBorder"
                                                                d:Visibility="Collapsed"
                                                                BorderThickness="0,0,0,2"
                                                                Opacity="0">
                                                            <i:Interaction.Triggers>
                                                                <i:DataTrigger Binding="{Binding QRCodeIsValid}" Value="True">
                                                                    <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Visible}" />
                                                                    <i:ControlStoryboardAction Storyboard="{StaticResource ScanAnimation}" />
                                                                </i:DataTrigger>
                                                                <i:DataTrigger Binding="{Binding QRCodeIsValid}" Value="False">
                                                                    <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Hidden}" />
                                                                    <i:ControlStoryboardAction ControlStoryboardOption="Stop" Storyboard="{StaticResource ScanAnimation}" />
                                                                </i:DataTrigger>
                                                            </i:Interaction.Triggers>
                                                            <Border.BorderBrush>
                                                                <LinearGradientBrush StartPoint="0, 0" EndPoint="1, 0">
                                                                    <GradientStop Offset="0" Color="Transparent" />
                                                                    <GradientStop Offset="0.1" Color="{Binding PaymentChannel, Converter={StaticResource PaymentChannelColor}}" />
                                                                    <GradientStop Offset="0.9" Color="{Binding PaymentChannel, Converter={StaticResource PaymentChannelColor}}" />
                                                                    <GradientStop Offset="1" Color="Transparent" />
                                                                </LinearGradientBrush>
                                                            </Border.BorderBrush>
                                                            <Border.Background>
                                                                <RadialGradientBrush Center="0.5, 1.2" GradientOrigin="0.5, 1.2" RadiusX="1" RadiusY="0.4">
                                                                    <GradientStop Offset="0.3" Color="{Binding PaymentChannel, Converter={StaticResource PaymentChannelColor}}" />
                                                                    <GradientStop Offset="1" Color="Transparent" />
                                                                </RadialGradientBrush>
                                                            </Border.Background>
                                                            <Border.RenderTransform>
                                                                <TranslateTransform x:Name="ScanBorderTransform" Y="-128" />
                                                            </Border.RenderTransform>
                                                        </Border>
                                                    </Border>
                                                </Grid>
                                            </Border>


                                            <Border Background="#BB000000" CornerRadius="4">
                                                <i:Interaction.Triggers>
                                                    <i:DataTrigger Binding="{Binding IsOrderCreating}" Value="True">
                                                        <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Visible}" />
                                                    </i:DataTrigger>
                                                    <i:DataTrigger Binding="{Binding IsOrderCreating}" Value="False">
                                                        <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Hidden}" />
                                                    </i:DataTrigger>
                                                </i:Interaction.Triggers>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Viewbox Width="36" Height="36">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z" Fill="#FFFFFF" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </StackPanel>
                                            </Border>
                                            <Border>
                                                <i:Interaction.Triggers>
                                                    <i:DataTrigger Binding="{Binding IsOrderCreating}" Value="True">
                                                        <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Hidden}" />
                                                    </i:DataTrigger>
                                                    <i:DataTrigger Binding="{Binding IsOrderCreating}" Value="False">
                                                        <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Visible}" />
                                                    </i:DataTrigger>
                                                </i:Interaction.Triggers>
                                                <Border Background="#BB000000" CornerRadius="4">
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="MouseUp">
                                                            <i:InvokeCommandAction Command="{Binding RefreshPayQRCodeCommand}" />
                                                        </i:EventTrigger>
                                                        <i:DataTrigger Binding="{Binding QRCodeIsValid}" Value="True">
                                                            <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Hidden}" />
                                                        </i:DataTrigger>
                                                        <i:DataTrigger Binding="{Binding QRCodeIsValid}" Value="False">
                                                            <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Visible}" />
                                                        </i:DataTrigger>
                                                    </i:Interaction.Triggers>
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                Margin="8">
                                                        <TextBlock Margin="0,0,0,8"
                                                                   Foreground="#FFFFFF"
                                                                   TextWrapping="Wrap"
                                                                   Style="{DynamicResource TitleMediumTextBlockStyle}"
                                                                   Text="{Binding Source={StaticResource R}, Path=Labels.Purchase_QRCodeExpired}" />
                                                        <TextBlock Foreground="#FFFFFF"
                                                                   TextWrapping="Wrap"
                                                                   Style="{DynamicResource BodyMediumTextBlockStyle}"
                                                                   Text="{Binding Source={StaticResource R}, Path=Labels.Purchase_ClickQRToRefresh}" />
                                                    </StackPanel>
                                                </Border>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <Grid HorizontalAlignment="Center">
                                        <Border x:Name="QRCodeBorder"
                                                HorizontalAlignment="Center"
                                                d:BorderBrush="#4377FA"
                                                BorderBrush="{Binding PaymentChannel, Converter={StaticResource PaymentChannelBrush}}"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <i:Interaction.Triggers>
                                                <i:DataTrigger Binding="{Binding PaymentChannel}" Value="{x:Static apiOrder:PaymentChannel.Alipay}">
                                                    <i:ChangePropertyAction PropertyName="Text"
                                                                            TargetName="PaymentChannelTipText"
                                                                            Value="{Binding Source={StaticResource R}, Path=Labels.Purchase_AlipayScanTip}" />
                                                    <i:ChangePropertyAction PropertyName="Background" TargetName="PaymentChannelTipIcon">
                                                        <i:ChangePropertyAction.Value>
                                                            <ImageBrush>
                                                                <ImageBrush.ImageSource>
                                                                    <BitmapImage DecodePixelHeight="32"
                                                                                 DecodePixelWidth="32"
                                                                                 UriSource="/Assets/Images/alipay_logo.png" />
                                                                </ImageBrush.ImageSource>
                                                            </ImageBrush>
                                                        </i:ChangePropertyAction.Value>
                                                    </i:ChangePropertyAction>
                                                </i:DataTrigger>
                                                <i:DataTrigger Binding="{Binding PaymentChannel}" Value="{x:Static apiOrder:PaymentChannel.Wxpay}">
                                                    <i:ChangePropertyAction PropertyName="Text"
                                                                            TargetName="PaymentChannelTipText"
                                                                            Value="{Binding Source={StaticResource R}, Path=Labels.Purchase_WeChatScanTip}" />
                                                    <i:ChangePropertyAction PropertyName="Background" TargetName="PaymentChannelTipIcon">
                                                        <i:ChangePropertyAction.Value>
                                                            <ImageBrush>
                                                                <ImageBrush.ImageSource>
                                                                    <BitmapImage DecodePixelHeight="32"
                                                                                 DecodePixelWidth="32"
                                                                                 UriSource="/Assets/Images/wechat_logo.png" />
                                                                </ImageBrush.ImageSource>
                                                            </ImageBrush>
                                                        </i:ChangePropertyAction.Value>
                                                    </i:ChangePropertyAction>
                                                </i:DataTrigger>
                                            </i:Interaction.Triggers>
                                            <StackPanel Orientation="Horizontal">
                                                <Border x:Name="PaymentChannelTipIcon"
                                                        Width="16"
                                                        Height="16"
                                                        Margin="0,0,4,0">
                                                    <d:Border.Background>
                                                        <ImageBrush>
                                                            <ImageBrush.ImageSource>
                                                                <BitmapImage DecodePixelHeight="32"
                                                                             DecodePixelWidth="32"
                                                                             UriSource="/Assets/Images/alipay_logo.png" />
                                                            </ImageBrush.ImageSource>
                                                        </ImageBrush>
                                                    </d:Border.Background>
                                                </Border>
                                                <TextBlock x:Name="PaymentChannelTipText"
                                                           Margin="0,0,4,0"
                                                           VerticalAlignment="Center"
                                                           d:Text="请使用支付宝扫码支付"
                                                           Foreground="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Border}, Path=BorderBrush}"
                                                           Style="{DynamicResource BodySmallTextBlockStyle}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                                <TextBlock Grid.Row="1"
                                           HorizontalAlignment="Center"
                                           FontSize="11"
                                           TextWrapping="Wrap">
                                    <Run Foreground="{DynamicResource Brushes.OnSurfaceVariant}" Text="{Binding Source={StaticResource R}, Path=Labels.Purchase_SubscriptionTermsPrefix, Mode=OneWay}" /><Hyperlink Command="{Binding OpenSubscriptionTermsCommand}"
                                               Cursor="Hand"
                                               Foreground="{DynamicResource Brushes.OnSurface}">
                                        <Run Text="{Binding Source={StaticResource R}, Path=Labels.Purchase_SubscriptionTermsLink, Mode=OneWay}" />
                                    </Hyperlink><Run Foreground="{DynamicResource Brushes.OnSurfaceVariant}" Text="{Binding Source={StaticResource R}, Path=Labels.Purchase_SubscriptionTermsSuffix, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>
                    <!-- 支付成功 -->
                    <Border Grid.Row="1"
                            Padding="24"
                            Background="{DynamicResource Brushes.SurfaceContainerHighest}"
                            Visibility="Hidden">
                        <Border.Resources>
                            <Storyboard x:Key="PaidIconAnimation">
                                <DoubleAnimation FillBehavior="HoldEnd"
                                                 Storyboard.TargetName="IconPath"
                                                 Storyboard.TargetProperty="(Path.StrokeDashOffset)"
                                                 From="-12"
                                                 To="0"
                                                 Duration="0:0:.3" />
                            </Storyboard>
                        </Border.Resources>
                        <i:Interaction.Triggers>
                            <i:DataTrigger Binding="{Binding CurrentOrderInfo.Status}" Value="{x:Static acm:OrderStatus.Paid}">
                                <i:ChangePropertyAction PropertyName="Visibility" Value="Visible" />
                                <i:ControlStoryboardAction Storyboard="{StaticResource PaidIconAnimation}" />
                            </i:DataTrigger>
                        </i:Interaction.Triggers>
                        <Grid RowDefinitions="*, Auto">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="64"
                                        Height="64"
                                        Margin="0,0,0,12"
                                        Background="{DynamicResource Brushes.Success}"
                                        CornerRadius="100">
                                    <Viewbox Width="48" Height="48">
                                        <Canvas Width="16" Height="16">
                                            <Path x:Name="IconPath"
                                                  d:StrokeDashOffset="0"
                                                  Data="M 13.33 4 L 6 11.33 L 2.67 8"
                                                  Stroke="White"
                                                  StrokeDashArray="12"
                                                  StrokeDashCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeThickness="1.5" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <TextBlock Margin="0,0,0,12"
                                           HorizontalAlignment="Center"
                                           Style="{DynamicResource DisplaySmallTextBlockStyle}"
                                           Text="{Binding Source={StaticResource R}, Path=Labels.Purchase_PaymentSuccess}" />
                                <TextBlock Margin="0,0,0,12"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource Brushes.OnSurfaceVariant}"
                                           Style="{DynamicResource BodyLargeTextBlockStyle}"
                                           Text="{Binding Source={StaticResource R}, Path=Labels.Purchase_PaymentSuccessMessage}" />

                                <Border Width="320"
                                        Margin="0,0,0,24"
                                        Padding="12"
                                        Background="{DynamicResource Brushes.SurfaceContainer}"
                                        CornerRadius="4">
                                    <StackPanel TextBlock.FontSize="{DynamicResource FontSize.Body.Medium}">
                                        <DockPanel Margin="0,0,0,4" LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Left"
                                                       Foreground="{DynamicResource Brushes.OnSurfaceVariant}"
                                                       Text="{Binding Source={StaticResource R}, Path=Labels.Purchase_OrderNumber}" />
                                            <TextBlock HorizontalAlignment="Right"
                                                       d:Text="2026061116224445384999291"
                                                       Text="{Binding CurrentOrderInfo.OrderNumber}" />
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,4" LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Left"
                                                       Foreground="{DynamicResource Brushes.OnSurfaceVariant}"
                                                       Text="{Binding Source={StaticResource R}, Path=Labels.Purchase_PaymentTime}" />
                                            <TextBlock HorizontalAlignment="Right"
                                                       d:Text="2026/06/10 10:06:33"
                                                       Text="{Binding CurrentOrderInfo.PayTime, StringFormat={}{0:yyyy/MM/dd HH:mm:ss}}" />
                                        </DockPanel>
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Left"
                                                       Foreground="{DynamicResource Brushes.OnSurfaceVariant}"
                                                       Text="{Binding Source={StaticResource R}, Path=Labels.Purchase_PaymentMethod}" />
                                            <TextBlock HorizontalAlignment="Right" d:Text="{Binding Source={StaticResource R}, Path=Labels.Purchase_WeChatPay}">
                                                <i:Interaction.Triggers>
                                                    <i:DataTrigger Binding="{Binding CurrentOrderInfo.PaymentMethod}" Value="{x:Static ocm:PaymentChannel.Alipay}">
                                                        <ui:SetBindingAction PropertyName="Text" Binding="{Binding Source={StaticResource R}, Path=Labels.Purchase_Alipay}" />
                                                    </i:DataTrigger>
                                                    <i:DataTrigger Binding="{Binding CurrentOrderInfo.PaymentMethod}" Value="{x:Static ocm:PaymentChannel.Wxpay}">
                                                        <ui:SetBindingAction PropertyName="Text" Binding="{Binding Source={StaticResource R}, Path=Labels.Purchase_WeChatPay}" />
                                                    </i:DataTrigger>
                                                </i:Interaction.Triggers>
                                            </TextBlock>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <Button Grid.Row="1"
                                        Width="168"
                                        Height="40"
                                        HorizontalAlignment="Center"
                                        Command="{Binding OkCommand}"
                                        Content="{Binding Source={StaticResource R}, Path=Labels.Purchase_DoneButton}"
                                        FontSize="{DynamicResource FontSize.Label.Large}"
                                        Style="{DynamicResource PrimaryButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <Image Height="128"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Source="/Assets/Images/pay_banner.png">
                <Image.RenderTransform>
                    <TranslateTransform X="1" Y="-19" />
                </Image.RenderTransform>
            </Image>
        </Grid>
    </Grid>
</UserControl>
