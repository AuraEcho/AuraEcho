		<ProjectReference Include="..\AuraEcho.FishyTime.Themes\AuraEcho.FishyTime.Themes.csproj" />
	</ItemGroup>
	<ItemGroup>
		<Compile Update="Strings\FishyTimeStrings.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>FishyTimeStrings.resx</DependentUpon>
		</Compile>
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Update="Strings\FishyTimeStrings.resx">
