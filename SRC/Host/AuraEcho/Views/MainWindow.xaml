<Window x:Class="AuraEcho.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:auraecho="http://ui.auraecho.com/"
        xmlns:constants="clr-namespace:AuraEcho.PluginContracts.Constants;assembly=AuraEcho.PluginContracts"
        xmlns:cv="clr-namespace:AuraEcho.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:AuraEcho.Models"
        xmlns:pcap="clr-namespace:AuraEcho.PluginContracts.AttachedProperties;assembly=AuraEcho.PluginContracts"
        xmlns:pm="clr-namespace:AuraEcho.PluginContracts.Models;assembly=AuraEcho.PluginContracts"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:selectors="clr-namespace:AuraEcho.Selectors"
        xmlns:viewmodels="clr-namespace:AuraEcho.ViewModels"
        xmlns:views="clr-namespace:AuraEcho.Views"
        Title="{Binding Source={StaticResource R}, Path=Labels.AppName}"
        Width="960"
        Height="640"
        MinWidth="480"
        MinHeight="320"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel}"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Background="{DynamicResource Brushes.SurfaceContainerLowest}"
        Closing="Window_Closing"
        Foreground="{DynamicResource Brushes.OnSurface}"
        Loaded="Window_Loaded"
        MouseDown="MainWindow_MouseDown"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">
    <Window.Resources>
        <auraecho:BindingProxy x:Key="BindingProxy" Data="{Binding}" />
        <Storyboard x:Key="ShowMask">
            <DoubleAnimation Storyboard.TargetName="AppContainer"
                             Storyboard.TargetProperty="(Grid.Effect).Progress"
                             To="0"
                             Duration="0:0:.5">
                <DoubleAnimation.EasingFunction>
                    <CircleEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation BeginTime="0:0:.5"
                             Storyboard.TargetName="AppContainer"
                             Storyboard.TargetProperty="(Grid.Effect).Progress"
                             From="0"
                             To="0"
                             Duration="0:0:.5" />
        </Storyboard>
        <Storyboard x:Key="HideMask">
            <DoubleAnimation Storyboard.TargetName="AppContainer"
                             Storyboard.TargetProperty="(Grid.Effect).Progress"
                             To="100"
                             Duration="0:0:.5">
                <DoubleAnimation.EasingFunction>
                    <CircleEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <DataTemplate x:Key="AppUpdatePendingRestartTemplate" DataType="{x:Type models:AppUpdatePendingRestart}">
            <Grid Margin="8,6" ColumnDefinitions="Auto, *">
                <Rectangle Grid.Column="0"
                           Width="64"
                           Height="64"
                           Margin="0,0,12,0"
                           RadiusX="16"
                           RadiusY="16">
                    <Rectangle.Fill>
                        <ImageBrush>
                            <ImageBrush.ImageSource>
                                <BitmapImage CacheOption="OnLoad"
                                             DecodePixelWidth="64"
                                             UriSource="/Assets/Images/auraecho.png" />
                            </ImageBrush.ImageSource>
                        </ImageBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontWeight="Bold"
                               Style="{DynamicResource TitleSmallTextBlockStyle}"
                               Text="{Binding Title}" />
                    <TextBlock Foreground="{DynamicResource Brushes.OnSurfaceVariant}" Style="{DynamicResource BodyMediumTextBlockStyle}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}{1}">
                                <Binding Path="Labels.MainWindow_CurrentVersionPrefix" Source="{StaticResource R}" />
                                <Binding Path="Data.CurrentVersion" Source="{StaticResource BindingProxy}" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0"
                                   Foreground="{DynamicResource Brushes.OnSurfaceVariant}"
                                   Style="{DynamicResource BodyMediumTextBlockStyle}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0}{1}">
                                    <Binding Path="Labels.MainWindow_LatestVersionPrefix" Source="{StaticResource R}" />
                                    <Binding Path="LatestVersion" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource Brushes.Primary}"
                                   Style="{DynamicResource BodyMediumTextBlockStyle}"
                                   Text="{Binding Source={StaticResource R}, Path=Labels.MainWindow_PendingRestart}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="PluginUpdatePendingRestartTemplate" DataType="{x:Type models:PluginUpdatePendingRestart}">
            <Grid Margin="8,6" ColumnDefinitions="Auto, *">
                <Rectangle Grid.Column="0"
                           Width="64"
                           Height="64"
                           Margin="0,0,12,0"
                           RadiusX="16"
                           RadiusY="16">
                    <Rectangle.Fill>
                        <ImageBrush ImageSource="{Binding IconPath}" />
                    </Rectangle.Fill>
                </Rectangle>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontWeight="Bold"
                               Style="{DynamicResource TitleSmallTextBlockStyle}"
                               Text="{Binding Title}" />
                    <TextBlock Foreground="{DynamicResource Brushes.OnSurfaceVariant}"
                               Style="{DynamicResource BodyMediumTextBlockStyle}"
                               Text="{Binding Source={StaticResource R}, Path=Labels.MainWindow_CurrentVersionPrefix, StringFormat={}{0}1.2.0}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0"
                                   Foreground="{DynamicResource Brushes.OnSurfaceVariant}"
                                   Style="{DynamicResource BodyMediumTextBlockStyle}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0}{1}">
                                    <Binding Path="Labels.MainWindow_LatestVersionPrefix" Source="{StaticResource R}" />
                                    <Binding Path="LatestVersion" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource Brushes.Primary}"
                                   Style="{DynamicResource BodyMediumTextBlockStyle}"
                                   Text="{Binding Source={StaticResource R}, Path=Labels.MainWindow_PendingRestart}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="PluginUninstallPendingRestartTemplate" DataType="{x:Type models:PluginUninstallPendingRestart}">
            <Grid Margin="8,6" ColumnDefinitions="Auto, *">
                <Rectangle Grid.Column="0"
                           Width="64"
                           Height="64"
                           Margin="0,0,12,0"
                           RadiusX="16"
                           RadiusY="16">
                    <Rectangle.Fill>
                        <ImageBrush ImageSource="{Binding IconPath}" />
                    </Rectangle.Fill>
                </Rectangle>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontWeight="Bold"
                               Style="{DynamicResource TitleSmallTextBlockStyle}"
                               Text="{Binding Title}" />
                    <TextBlock Foreground="{DynamicResource Brushes.OnSurfaceVariant}"
                               Style="{DynamicResource BodyMediumTextBlockStyle}"
                               Text="{Binding Source={StaticResource R}, Path=Labels.MainWindow_UninstallPending}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Width="220" TextWrapping="Wrap">
                            <TextBlock Margin="0,0,8,0"
                                       Foreground="{DynamicResource Brushes.OnSurfaceVariant}"
                                       Style="{DynamicResource BodyMediumTextBlockStyle}"
                                       Text="{Binding Source={StaticResource R}, Path=Labels.MainWindow_ApplyAfterRestart}" />
                            <TextBlock Foreground="{DynamicResource Brushes.Primary}"
                                       Style="{DynamicResource BodyMediumTextBlockStyle}"
                                       Text="{Binding Source={StaticResource R}, Path=Labels.MainWindow_PendingRestart}"
                                       Visibility="Collapsed" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding AutoSignInCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Window.InputBindings>
        <!--
            为什么不使用 Applications.NotACommand?
            不知道为什么，使用 ApplicationCommands.NotACommand 不生效，所以使用了一个程序未进行处理的其他命令
        -->
        <KeyBinding Command="{x:Static ApplicationCommands.Paste}" Gesture="Alt+Space" />
        <KeyBinding Command="{x:Static ApplicationCommands.Paste}" Gesture="Alt+F4" />
    </Window.InputBindings>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      CornerRadius="0"
                      GlassFrameThickness="0,0,0,1"
                      ResizeBorderThickness="4"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid x:Name="AppContainer">
        <i:Interaction.Triggers>
            <i:DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}, Path=WindowState}" Value="{x:Static WindowState.Maximized}">
                <i:ChangePropertyAction PropertyName="Margin" Value="8" />
            </i:DataTrigger>
            <i:DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}, Path=WindowState}"
                           Comparison="NotEqual"
                           Value="{x:Static WindowState.Maximized}">
                <i:ChangePropertyAction PropertyName="Margin" Value="0" />
            </i:DataTrigger>
        </i:Interaction.Triggers>

        <Grid x:Name="HomeContainer"
              Background="Transparent"
              RowDefinitions="Auto, *">

            <!-- 首页区域 -->
            <ContentControl Grid.Row="0"
                            Grid.RowSpan="2"
                            prism:RegionManager.RegionName="{x:Static constants:HostRegionNames.HomeRegion}" />
            <!-- 内容区域 -->
            <ContentControl Grid.Row="0"
                            Grid.RowSpan="2"
                            prism:RegionManager.RegionName="{x:Static constants:HostRegionNames.MainRegion}" />

            <!--#region 窗口标题栏-->
            <Grid x:Name="AppTitleContainer"
                  Grid.Row="0"
                  Grid.RowSpan="2"
                  Height="36"
                  VerticalAlignment="Top"
                  Background="Transparent"
                  ColumnDefinitions="Auto, *, Auto">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseLeftButtonDown">
                        <i:CallMethodAction MethodName="DragMove" TargetObject="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BackButton"
                            Width="44"
                            Margin="4,4,4,0"
                            Padding="0,0,4,0"
                            auraecho:ControlHelper.CornerRadius="2"
                            Command="{Binding GoBackCommand}"
                            Style="{DynamicResource IconButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Resources>
                            <Storyboard x:Key="BackButtonPressStoryboard">
                                <DoubleAnimation Storyboard.TargetName="BackIconViewBox"
                                                 Storyboard.TargetProperty="(Viewbox.RenderTransform).(TranslateTransform.X)"
                                                 From="0"
                                                 To="5"
                                                 Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CircleEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                            <Storyboard x:Key="BackButtonReleaseStoryboard">
                                <DoubleAnimation Storyboard.TargetName="BackIconViewBox"
                                                 Storyboard.TargetProperty="(Viewbox.RenderTransform).(TranslateTransform.X)"
                                                 From="5"
                                                 To="0"
                                                 Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </Button.Resources>
                        <i:Interaction.Triggers>
                            <i:DataTrigger Binding="{Binding NavigationService.CanGoBack}" Value="True">
                                <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Visible}" />
                            </i:DataTrigger>
                            <i:DataTrigger Binding="{Binding NavigationService.CanGoBack}" Value="False">
                                <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Collapsed}" />
                            </i:DataTrigger>
                            <i:DataTrigger Binding="{Binding ElementName=BackButton, Path=IsPressed}" Value="True">
                                <i:ControlStoryboardAction Storyboard="{StaticResource BackButtonPressStoryboard}" />
                            </i:DataTrigger>
                            <i:DataTrigger Binding="{Binding ElementName=BackButton, Path=IsPressed}" Value="False">
                                <i:ControlStoryboardAction Storyboard="{StaticResource BackButtonReleaseStoryboard}" />
                            </i:DataTrigger>
                        </i:Interaction.Triggers>
                        <Border Padding="4,4,0,4" ClipToBounds="True">
                            <Viewbox x:Name="BackIconViewBox"
                                     Width="14"
                                     Height="14">
                                <Viewbox.RenderTransform>
                                    <TranslateTransform X="0" />
                                </Viewbox.RenderTransform>
                                <Canvas Width="14" Height="14">
                                    <Path Stroke="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Button}}, Path=Foreground}"
                                          StrokeDashCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="1.2">
                                        <Path.Data>
                                            <PathGeometry Figures="M 6.5 0.65 L 0.8 6.29 C 0.6 6.49 0.6 6.81 0.8 7 L 6.5 12.65 M 1.41 6.7 H 12.44" FillRule="Nonzero" />
                                        </Path.Data>
                                    </Path>
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </Button>
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">

                        <Image Height="20"
                               VerticalAlignment="Center"
                               Source="/Assets/Icons/AuraEcho.ico">
                            <i:Interaction.Triggers>
                                <i:DataTrigger Binding="{Binding NavigationService.CanGoBack}" Value="True">
                                    <i:ChangePropertyAction PropertyName="Margin">
                                        <i:ChangePropertyAction.Value>
                                            <Thickness>2, 0, 8, 0</Thickness>
                                        </i:ChangePropertyAction.Value>
                                    </i:ChangePropertyAction>
                                </i:DataTrigger>
                                <i:DataTrigger Binding="{Binding NavigationService.CanGoBack}" Value="False">
                                    <i:ChangePropertyAction PropertyName="Margin">
                                        <i:ChangePropertyAction.Value>
                                            <Thickness>8, 0</Thickness>
                                        </i:ChangePropertyAction.Value>
                                    </i:ChangePropertyAction>
                                </i:DataTrigger>
                            </i:Interaction.Triggers>
                        </Image>
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brushes.OnSurface}"
                                   Style="{DynamicResource BodySmallTextBlockStyle}"
                                   Text="{Binding Source={StaticResource R}, Path=Labels.AppName}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ToggleButton x:Name="RestartTipsButton"
                                  Width="47"
                                  Padding="0"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Foreground="{DynamicResource Brushes.Primary}"
                                  ToolTip="{Binding Source={StaticResource R}, Path=Labels.MainWindow_PendingRestart}"
                                  WindowChrome.IsHitTestVisibleInChrome="True">
                        <i:Interaction.Triggers>
                            <i:DataTrigger Binding="{Binding PendingRestartItems.Count}" Value="0">
                                <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Collapsed}" />
                            </i:DataTrigger>
                            <i:DataTrigger Binding="{Binding PendingRestartItems.Count}"
                                           Comparison="NotEqual"
                                           Value="0">
                                <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Visible}" />
                            </i:DataTrigger>
                        </i:Interaction.Triggers>
                        <ToggleButton.IsHitTestVisible>
                            <Binding Delay="10"
                                     ElementName="PendingRestartPopup"
                                     Path="IsOpen">
                                <Binding.Converter>
                                    <auraecho:ReverseBooleanConverter />
                                </Binding.Converter>
                            </Binding>
                        </ToggleButton.IsHitTestVisible>
                        <Viewbox x:Name="RestartPendingIcon"
                                 Width="24"
                                 Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Data="M10 4.03V.633L5 5.63L10 10.63V6.03C11.5 6.03 13.11 6.63 14.21 7.73C16.5 10.13 16.5 13.93 14.21 16.23C12.91 17.53 11.11 18.13 9.4 17.93L8.9 19.93C11.31 20.23 13.81 19.53 15.61 17.63C18.7 14.53 18.7 9.43 15.61 6.33C14.11 4.83 12.11 4.03 10 4.03M4.31 17.63C5.11 18.43 6 19.03 7 19.43L7.61 17.43C6.91 17.13 6.31 16.73 5.81 16.23C3.91 14.43 3.5 11.63 4.61 9.43L3.11 7.93C1.31 11.03 1.71 15.03 4.31 17.63M20 13H22V7H20V13M20 17H22V15H20V17Z" Fill="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ToggleButton}}, Path=Foreground}" />
                            </Canvas>
                        </Viewbox>
                    </ToggleButton>
                    <ToggleButton x:Name="OptionsToggleButton"
                                  Width="47"
                                  Padding="0"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Foreground="{DynamicResource Brushes.OnSurface}"
                                  ToolTip="{Binding ClientSession.CurrentUser.UserName}"
                                  WindowChrome.IsHitTestVisibleInChrome="True">
                        <ToggleButton.IsHitTestVisible>
                            <Binding Delay="10"
                                     ElementName="OptionsPopup"
                                     Path="IsOpen">
                                <Binding.Converter>
                                    <auraecho:ReverseBooleanConverter />
                                </Binding.Converter>
                            </Binding>
                        </ToggleButton.IsHitTestVisible>
                        <i:Interaction.Triggers>
                            <i:DataTrigger Binding="{Binding ClientSession.CurrentUser}" Value="{x:Null}">
                                <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Collapsed}" />
                            </i:DataTrigger>
                            <i:DataTrigger Binding="{Binding ClientSession.CurrentUser}"
                                           Comparison="NotEqual"
                                           Value="{x:Null}">
                                <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Visible}" />
                            </i:DataTrigger>
                        </i:Interaction.Triggers>
                        <Border x:Name="AvatarContainer">
                            <Grid>
                                <Border x:Name="TitleDefaultAvatarBorder"
                                        Width="28"
                                        Height="28"
                                        BorderBrush="{DynamicResource Brushes.OutlineInner}"
                                        BorderThickness="1"
                                        CornerRadius="20"
                                        Visibility="Visible">
                                    <Border.RenderTransform>
                                        <TranslateTransform Y="0" />
                                    </Border.RenderTransform>
                                    <Border.Background>
                                        <ImageBrush>
                                            <ImageBrush.ImageSource>
                                                <BitmapImage DecodePixelHeight="56"
                                                             DecodePixelWidth="56"
                                                             UriSource="/Assets/Images/auraecho.png" />
                                            </ImageBrush.ImageSource>
                                        </ImageBrush>
                                    </Border.Background>
                                </Border>
                                <Border x:Name="TitleAvatarBorder"
                                        Width="28"
                                        Height="28"
                                        BorderBrush="{DynamicResource Brushes.OutlineInner}"
                                        BorderThickness="1"
                                        CornerRadius="20">
                                    <Border.RenderTransform>
                                        <TranslateTransform Y="0" />
                                    </Border.RenderTransform>
                                    <Border.Background>
                                        <ImageBrush pcap:WebImageHelper.DecodePixelWidth="56"
                                                    pcap:WebImageHelper.Url="{Binding ClientSession.CurrentUser.AvatarFileUrl}"
                                                    Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                    </ToggleButton>
                    <Button Width="47"
                            auraecho:ControlHelper.CornerRadius="0"
                            IsTabStop="False"
                            Style="{DynamicResource IconButtonStyle}"
                            ToolTip="{Binding Source={StaticResource R}, Path=Labels.Window_Minimize}"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Click">
                                <i:ChangePropertyAction PropertyName="WindowState"
                                                        TargetObject="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                                                        Value="Minimized" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <Canvas Width="16" Height="16">
                            <Rectangle Canvas.Left="2.0"
                                       Canvas.Top="8.0"
                                       Width="12.0"
                                       Height="1.0"
                                       Fill="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Button}}, Path=Foreground}"
                                       RadiusX="0.5"
                                       RadiusY="0.5" />
                        </Canvas>
                    </Button>
                    <Button x:Name="MinMaxWindowButton"
                            Width="47"
                            auraecho:ControlHelper.CornerRadius="0"
                            Click="MaxWin_MouseClick"
                            IsTabStop="False"
                            Style="{DynamicResource IconButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True">

                        <Grid>
                            <i:Interaction.Triggers>
                                <i:DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}, Path=WindowState}" Value="{x:Static WindowState.Normal}">
                                    <i:ChangePropertyAction PropertyName="Visibility"
                                                            TargetName="MaxWindowIcon"
                                                            Value="{x:Static Visibility.Visible}" />
                                    <auraecho:SetBindingAction Binding="{Binding Source={StaticResource R}, Path=Labels.Window_Maximize}"
                                                               PropertyName="ToolTip"
                                                               TargetName="MinMaxWindowButton" />
                                    <i:ChangePropertyAction PropertyName="Visibility"
                                                            TargetName="RestoreWindowIcon"
                                                            Value="{x:Static Visibility.Hidden}" />
                                </i:DataTrigger>
                                <i:DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}, Path=WindowState}"
                                               Comparison="NotEqual"
                                               Value="{x:Static WindowState.Normal}">
                                    <i:ChangePropertyAction PropertyName="Visibility"
                                                            TargetName="MaxWindowIcon"
                                                            Value="{x:Static Visibility.Hidden}" />
                                    <auraecho:SetBindingAction Binding="{Binding Source={StaticResource R}, Path=Labels.Window_Reduction}"
                                                               PropertyName="ToolTip"
                                                               TargetName="MinMaxWindowButton" />
                                    <i:ChangePropertyAction PropertyName="Visibility"
                                                            TargetName="RestoreWindowIcon"
                                                            Value="{x:Static Visibility.Visible}" />
                                </i:DataTrigger>
                            </i:Interaction.Triggers>
                            <Viewbox x:Name="MaxWindowIcon"
                                     Width="12"
                                     Height="12"
                                     Visibility="Hidden">
                                <Canvas Width="10" Height="10">
                                    <Path Data="M 10 1 C 10 0.45 9.55 0 9 0 H 1 C 0.45 0 0 0.45 0 1 V 9 C 0 9.55 0.45 10 1 10 H 9 C 9.55 10 10 9.55 10 9 V 1 Z M 1 1 H 9 V 9 H 1 V 1 Z" Fill="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Button}}, Path=Foreground}" />
                                </Canvas>
                            </Viewbox>

                            <Viewbox x:Name="RestoreWindowIcon"
                                     Width="16"
                                     Height="16">
                                <Canvas Width="16.0" Height="16.0">
                                    <Rectangle Canvas.Left="2.5"
                                               Canvas.Top="4.5"
                                               Width="9.0"
                                               Height="9.0"
                                               RadiusX="0.5"
                                               RadiusY="0.5"
                                               Stroke="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Button}}, Path=Foreground}"
                                               StrokeDashCap="Flat"
                                               StrokeThickness="1.0" />
                                    <Path Stroke="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Button}}, Path=Foreground}"
                                          StrokeDashCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="1.0">
                                        <Path.Data>
                                            <PathGeometry Figures="M 5.5 4.48421 L 5.5 3 C 5.5 2.72386 5.72386 2.5 6 2.5 H 13 C 13.2761 2.5 13.5 2.72386 13.5 3 V 10 C 13.5 10.2761 13.2761 10.5 13 10.5 H 11.5102" FillRule="Nonzero" />
                                        </Path.Data>
                                    </Path>
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Button>
                    <Button Width="47"
                            auraecho:ControlHelper.CornerRadius="0"
                            BorderThickness="0"
                            Click="CloseWindowButton_Click"
                            IsTabStop="False"
                            Style="{DynamicResource IconButtonStyle}"
                            ToolTip="{Binding Source={StaticResource R}, Path=Labels.Window_Close}"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Canvas Width="16" Height="16">
                            <Path Data="M 3.14645 3.14645 C 3.34171 2.95118 3.65829 2.95118 3.85355 3.14645 L 8 7.293 L 12.1464 3.14645 C 12.32 2.97288 12.5894 2.9536 12.7843 3.08859 L 12.8536 3.14645 C 13.0488 3.34171 13.0488 3.65829 12.8536 3.85355 L 8.707 8 L 12.8536 12.1464 C 13.0271 12.32 13.0464 12.5894 12.9114 12.7843 L 12.8536 12.8536 C 12.6583 13.0488 12.3417 13.0488 12.1464 12.8536 L 8 8.707 L 3.85355 12.8536 C 3.67999 13.0271 3.41056 13.0464 3.21569 12.9114 L 3.14645 12.8536 C 2.95118 12.6583 2.95118 12.3417 3.14645 12.1464 L 7.293 8 L 3.14645 3.85355 C 2.97288 3.67999 2.9536 3.41056 3.08859 3.21569 L 3.14645 3.14645 Z" Fill="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Button}}, Path=Foreground}" />
                        </Canvas>
                    </Button>

                    <Popup x:Name="PendingRestartPopup"
                           AllowsTransparency="True"
                           HorizontalOffset="-240"
                           IsOpen="{Binding ElementName=RestartTipsButton, Path=IsChecked}"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=RestartTipsButton}"
                           StaysOpen="False"
                           UseLayoutRounding="True"
                           VerticalOffset="4">
                        <Popup.Resources>
                            <Storyboard x:Key="ShowPendingRestartItemsStoryboard">
                                <DoubleAnimation Storyboard.TargetName="PendingRestartItemsLayout"
                                                 Storyboard.TargetProperty="(Border.RenderTransform).(TranslateTransform.Y)"
                                                 From="-100"
                                                 To="0"
                                                 Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <CircleEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </Popup.Resources>
                        <i:Interaction.Triggers>
                            <i:DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Popup}}, Path=IsOpen}" Value="True">
                                <i:ControlStoryboardAction Storyboard="{StaticResource ShowPendingRestartItemsStoryboard}" />
                            </i:DataTrigger>
                        </i:Interaction.Triggers>
                        <Border x:Name="PendingRestartItemsLayout"
                                MinWidth="290"
                                MaxHeight="480"
                                Padding="8"
                                Background="{DynamicResource Brushes.SurfaceContainerHighest}"
                                BorderBrush="{DynamicResource Brushes.OutlineShadow}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20"
                                                  Direction="270"
                                                  Opacity="0.15"
                                                  ShadowDepth="6" />
                            </Border.Effect>
                            <Border.RenderTransform>
                                <TranslateTransform />
                            </Border.RenderTransform>
                            <Grid RowDefinitions="Auto, *, Auto">
                                <TextBlock Margin="0,0,0,8"
                                           FontSize="{DynamicResource FontSize.Body.Medium}"
                                           Foreground="{DynamicResource Brushes.OnSurfaceVariant}"
                                           Text="{Binding Source={StaticResource R}, Path=Labels.MainWindow_RestartToUpdate}" />
                                <ScrollViewer Grid.Row="1" Margin="0,0,0,12">
                                    <ItemsControl ItemsSource="{Binding PendingRestartItems}">
                                        <ItemsControl.ItemTemplateSelector>
                                            <selectors:PendingRestartItemTemplateSelector AppUpdateTemplate="{StaticResource AppUpdatePendingRestartTemplate}"
                                                                                          PluginUninstallTemplate="{StaticResource PluginUninstallPendingRestartTemplate}"
                                                                                          PluginUpdateTemplate="{StaticResource PluginUpdatePendingRestartTemplate}" />
                                        </ItemsControl.ItemTemplateSelector>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="{x:Type ContentPresenter}">
                                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Button Grid.Row="2"
                                        Padding="0,8"
                                        Command="{Binding Source={StaticResource BindingProxy}, Path=Data.RequestRestartAppCommand}"
                                        Content="{Binding Source={StaticResource R}, Path=Labels.MainWindow_RestartNow}"
                                        FontSize="{DynamicResource FontSize.Label.Medium}"
                                        Style="{DynamicResource PrimaryButtonStyle}" />
                            </Grid>
                        </Border>
                    </Popup>

                    <Popup x:Name="OptionsPopup"
                           AllowsTransparency="True"
                           ClipToBounds="True"
                           HorizontalOffset="-253"
                           IsOpen="{Binding ElementName=OptionsToggleButton, Path=IsChecked}"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=OptionsToggleButton}"
                           StaysOpen="False"
                           UseLayoutRounding="True"
                           VerticalOffset="4">
                        <Popup.Resources>
                            <Storyboard x:Key="ShowOptionsStoryboard">
                                <DoubleAnimation Storyboard.TargetName="OptionsLayout"
                                                 Storyboard.TargetProperty="(Border.RenderTransform).(TranslateTransform.Y)"
                                                 From="-100"
                                                 To="0"
                                                 Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <CircleEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </Popup.Resources>
                        <i:Interaction.Triggers>
                            <i:DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Popup}}, Path=IsOpen}" Value="True">
                                <i:ControlStoryboardAction Storyboard="{StaticResource ShowOptionsStoryboard}" />
                            </i:DataTrigger>
                        </i:Interaction.Triggers>
                        <Border x:Name="OptionsLayout"
                                Width="300"
                                Background="{DynamicResource Brushes.SurfaceContainerHighest}"
                                BorderBrush="{DynamicResource Brushes.OutlineShadow}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20"
                                                  Direction="270"
                                                  Opacity="0.15"
                                                  ShadowDepth="6" />
                            </Border.Effect>
                            <Border.RenderTransform>
                                <TranslateTransform />
                            </Border.RenderTransform>
                            <StackPanel>
                                <Grid Margin="12" ColumnDefinitions="Auto, *">
                                    <Border x:Name="PopupDefaultAvatarBorder"
                                            Width="48"
                                            Height="48"
                                            VerticalAlignment="Top"
                                            BorderBrush="{DynamicResource Brushes.OutlineInner}"
                                            BorderThickness="1"
                                            CornerRadius="40">
                                        <Border.Background>
                                            <ImageBrush>
                                                <ImageBrush.ImageSource>
                                                    <BitmapImage DecodePixelHeight="96"
                                                                 DecodePixelWidth="96"
                                                                 UriSource="/Assets/Images/auraecho.png" />
                                                </ImageBrush.ImageSource>
                                            </ImageBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border x:Name="PopupAvatarBorder"
                                            Width="48"
                                            Height="48"
                                            VerticalAlignment="Top"
                                            BorderBrush="{DynamicResource Brushes.OutlineInner}"
                                            BorderThickness="1"
                                            CornerRadius="40">
                                        <Border.Background>
                                            <ImageBrush pcap:WebImageHelper.DecodePixelHeight="96"
                                                        pcap:WebImageHelper.Url="{Binding ClientSession.CurrentUser.AvatarFileUrl}"
                                                        Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Margin="12,0,0,4"
                                                   FontSize="{DynamicResource FontSize.Body.Large}"
                                                   Foreground="{DynamicResource Brushes.OnSurface}"
                                                   Text="{Binding ClientSession.CurrentUser.UserName}"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.ToolTip>
                                                <ToolTip Content="{Binding ClientSession.CurrentUser.UserName}"
                                                         FontSize="{DynamicResource FontSize.Label.Small}"
                                                         HorizontalOffset="-10"
                                                         Placement="Top" />
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                        <TextBlock Margin="12,0,0,4"
                                                   FontSize="{DynamicResource FontSize.Body.Small}"
                                                   Foreground="{DynamicResource Brushes.OnSurfaceVariant}"
                                                   Text="{Binding ClientSession.CurrentUser.Email}" />
                                        <Button Margin="8,0,0,0"
                                                HorizontalAlignment="Left"
                                                Command="{Binding SignOutCommand}"
                                                Content="{Binding Source={StaticResource R}, Path=Labels.MainWindow_SignOut}"
                                                FontSize="{DynamicResource FontSize.Label.Medium}"
                                                Foreground="{DynamicResource Brushes.Primary}"
                                                Style="{DynamicResource IconButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                                <Line Stretch="Fill"
                                      Stroke="{DynamicResource Brushes.OutlineVariant}"
                                      X1="0"
                                      X2="1"
                                      Y1="0"
                                      Y2="0" />
                                <StackPanel Margin="4">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="Click" SourceName="SettginsButton">
                                            <i:ChangePropertyAction PropertyName="IsOpen"
                                                                    TargetName="OptionsPopup"
                                                                    Value="False" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                    <Button x:Name="SettginsButton"
                                            Height="36"
                                            Padding="8,0"
                                            HorizontalContentAlignment="Left"
                                            BorderThickness="0"
                                            Command="{Binding NavigationToSettingsCommand}"
                                            FontSize="{DynamicResource FontSize.Label.Medium}"
                                            Style="{DynamicResource IconButtonStyle}">

                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="24"
                                                     Height="24"
                                                     Margin="0,0,8,0">
