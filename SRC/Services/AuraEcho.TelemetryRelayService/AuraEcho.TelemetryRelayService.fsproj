<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
	  <TargetFramework>net10.0-windows</TargetFramework>
	  <RuntimeIdentifier>win-x64</RuntimeIdentifier>
	  <AssemblyName>$(MSBuildProjectName.Replace(".", ""))</AssemblyName>
	  <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
	  <Version Condition="'$(TelemetryRelayServiceVersion)' != ''">$(TelemetryRelayServiceVersion)</Version>
	  <Product>灵光回声</Product>
	  <Copyright>© Suencesoft. All rights reserved.</Copyright>
  </PropertyGroup>


  <ItemGroup>
    <Compile Include="Workflows.fs" />
    <Compile Include="Worker.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.1" />
		<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.9" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\Shared\AuraEcho.Telemetry\AuraEcho.Telemetry.csproj" />
      <ProjectReference Include="..\..\Shared\AuraEcho.Logging\AuraEcho.Logging.csproj" />
	</ItemGroup>
</Project>
