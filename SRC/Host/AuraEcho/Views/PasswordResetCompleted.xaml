<UserControl x:Class="AuraEcho.Views.PasswordResetCompleted"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:AuraEcho.Core.Models;assembly=AuraEcho.Core"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:ui="http://ui.auraecho.com/"
             xmlns:viewmodels="clr-namespace:AuraEcho.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:PasswordResetCompletedViewModel}"
             d:DesignHeight="640"
             d:DesignWidth="960"
             d:Foreground="{DynamicResource Brushes.OnSurface}"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{DynamicResource Brushes.SurfaceContainerLowest}"
             mc:Ignorable="d">
    <Grid Background="{DynamicResource Brushes.Special.Background}">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <Grid>
                    <Border Width="80"
                            Height="80"
                            Margin="0,0,0,12"
                            Background="#7F9A3BFF"
                            CornerRadius="8"
                            Visibility="Visible">
                        <Border.Effect>
                            <BlurEffect Radius="100" />
                        </Border.Effect>
                    </Border>
                    <Border Width="80"
                            Height="80"
                            Margin="0,0,0,12"
                            CornerRadius="8">
                        <Border.Background>
                            <ImageBrush ImageSource="/Assets/Images/auraecho.png" />
                        </Border.Background>
                        <Border BorderThickness="1" CornerRadius="8">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0.5, 0.5" EndPoint="1, 0">
                                    <GradientStop Offset="0" Color="#00FFFFFF" />
                                    <GradientStop Offset="1" Color="#FFFFFFFF" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                        </Border>
                    </Border>
                </Grid>
                <TextBlock Margin="0,0,0,40"
                           HorizontalAlignment="Center"
                           FontFamily="Microsoft YaHei UI"
                           Foreground="{DynamicResource Brushes.Special.OnSurfaceLinear}"
                           Style="{DynamicResource DisplayLargeTextBlockStyle}"
                           Text="{Binding Source={StaticResource Loc}, Path=Labels.PasswordResetCompleted_Title}" />
                <Grid Width="400" Height="320">
                    <Border VerticalAlignment="Top"
                            Background="{DynamicResource Brushes.Special.OnSpecialBackground}"
                            BorderBrush="{DynamicResource Brushes.Special.HighlightOutline}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel Margin="24" TextBlock.FontSize="16">
                            <DockPanel Margin="0,0,0,24" LastChildFill="True">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Loaded">
                                        <i:ControlStoryboardAction>
                                            <i:ControlStoryboardAction.Storyboard>
                                                <Storyboard>
                                                    <DoubleAnimation FillBehavior="HoldEnd"
                                                                     Storyboard.TargetName="IconPath"
                                                                     Storyboard.TargetProperty="(Path.StrokeDashOffset)"
                                                                     From="-12"
                                                                     To="0"
                                                                     Duration="0:0:.3" />
                                                </Storyboard>
                                            </i:ControlStoryboardAction.Storyboard>
                                        </i:ControlStoryboardAction>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                                <Viewbox Width="48"
                                         Height="48"
                                         Margin="0,0,8,0">
                                    <Canvas Width="16" Height="16">
                                        <Path x:Name="IconPath"
                                              d:StrokeDashOffset="0"
                                              Data="M 13.33 4 L 6 11.33 L 2.67 8"
                                              Stroke="#00B815"
                                              StrokeDashArray="12"
                                              StrokeDashCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeThickness="1.5" />
                                    </Canvas>
                                </Viewbox>
                                <StackPanel DockPanel.Dock="Right">
                                    <TextBlock Margin="0,0,0,2" Text="{Binding Source={StaticResource Loc}, Path=Labels.PasswordResetCompleted_SuccessMessage}" />
                                    <TextBlock Text="{Binding Source={StaticResource Loc}, Path=Labels.PasswordResetCompleted_LoginPrompt}" />
                                </StackPanel>
                            </DockPanel>
                            <Button Height="44"
                                    Command="{Binding BackToSignInCommand}"
                                    Content="{Binding Source={StaticResource Loc}, Path=Labels.PasswordResetCompleted_ReLoginButton}"
                                    FontSize="16"
                                    Style="{DynamicResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
