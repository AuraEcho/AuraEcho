<Project Sdk="Microsoft.NET.Sdk.Worker">

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<AssemblyName>$(MSBuildProjectName.Replace(".", ""))</AssemblyName>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<Version Condition="'$(LauncherServiceVersion)' != ''">$(LauncherServiceVersion)</Version>
		<Product>灵光回声</Product>
		<Copyright>© Suencesoft. All rights reserved.</Copyright>
	</PropertyGroup>


	<ItemGroup>
		<Compile Include="NativeMethods.fs" />
		<Compile Include="TokenHelper.fs" />
		<Compile Include="UserSessionProcessLauncher.fs" />
		<Compile Include="Worker.fs" />
		<Compile Include="Program.fs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.1" />
		<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.9" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Shared\AuraEcho.Core\AuraEcho.Core.csproj" />
	</ItemGroup>
</Project>
