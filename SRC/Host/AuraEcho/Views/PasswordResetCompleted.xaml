<UserControl x:Class="AuraEcho.Views.PasswordResetCompleted"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:AuraEcho.Core.Models;assembly=AuraEcho.Core"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:ui="http://ui.auraecho.com/"
             d:DesignHeight="640"
             d:DesignWidth="960"
             d:Foreground="{DynamicResource Themes.Brushes.OnBackground}"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="Black"
             mc:Ignorable="d">
    <Grid Background="{DynamicResource Themes.Background}">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <Grid>
                    <Border Width="80"
                            Height="80"
                            Margin="0,0,0,12"
                            Background="#FF9A3BFF"
                            CornerRadius="8">
                        <Border.Effect>
                            <BlurEffect Radius="40" />
                        </Border.Effect>
                    </Border>
                    <Border Width="80"
                            Height="80"
                            Margin="0,0,0,12"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Border.Background>
                            <ImageBrush ImageSource="/Assets/Images/auraecho.png" />
                        </Border.Background>
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="1, 0" EndPoint="0.5, 0.5">
                                <GradientStop Offset="0" Color="White" />
                                <GradientStop Offset="1" Color="#00FFFFFF" />
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                    </Border>
                </Grid>
                <TextBlock Margin="0,0,0,40"
                           HorizontalAlignment="Center"
                           FontFamily="Microsoft YaHei UI"
                           FontSize="52"
                           FontWeight="Bold"
                           Text="密码已重置">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0, 0" EndPoint="0, 1">
                            <GradientStop Offset="0.2" Color="White" />
                            <GradientStop Offset="1" Color="#00FFFFFF" />
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>
                <Grid Width="400" Height="320">
                    <Border VerticalAlignment="Top"
                            Background="#33000000"
                            BorderThickness="1"
                            CornerRadius="8"
                            BorderBrush="{DynamicResource Themes.BorderBrush}">
                        <StackPanel Margin="24" TextBlock.FontSize="16">
                            <DockPanel Margin="0,0,0,36" LastChildFill="True">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Loaded">
                                        <i:ControlStoryboardAction>
                                            <i:ControlStoryboardAction.Storyboard>
                                                <Storyboard>
                                                    <DoubleAnimation FillBehavior="HoldEnd"
                                                                     Storyboard.TargetName="IconPath"
                                                                     Storyboard.TargetProperty="(Path.StrokeDashOffset)"
                                                                     From="-12"
                                                                     To="0"
                                                                     Duration="0:0:.3" />
                                                </Storyboard>
                                            </i:ControlStoryboardAction.Storyboard>
                                        </i:ControlStoryboardAction>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                                <Viewbox Width="48"
                                         Height="48"
                                         Margin="0,0,8,0">
                                    <Canvas Width="16" Height="16">
                                        <Path x:Name="IconPath"
                                              d:StrokeDashOffset="0"
                                              Data="M 13.33 4 L 6 11.33 L 2.67 8"
                                              Stroke="White"
                                              StrokeDashArray="12"
                                              StrokeDashCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeThickness="1.5" />
                                    </Canvas>
                                </Viewbox>
                                <StackPanel DockPanel.Dock="Right">

                                    <TextBlock Margin="0,0,0,2" Text="密码已设置完成！" />
                                    <TextBlock Text="现在可使用新的密码登录到灵光回声。" />
                                </StackPanel>
                            </DockPanel>
                            <Button Height="40"
                                    Command="{Binding BackToSignInCommand}"
                                    Content="重新登录"
                                    FontSize="16"
                                    Style="{DynamicResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
