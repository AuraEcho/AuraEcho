                                                          Stroke="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Button}}, Path=Foreground}"
                                                          StrokeDashCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          StrokeStartLineCap="Round"
                                                          StrokeThickness="1.5" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock VerticalAlignment="Center" Text="{Binding Source={StaticResource R}, Path=Labels.Settings}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
            <!--#endregion-->
            <!-- 提示消息区域 -->
            <ContentControl Grid.Row="0"
                            Grid.RowSpan="2"
                            prism:RegionManager.RegionName="{x:Static constants:HostRegionNames.ContentDialogRegion}" />

            <!--#region 错误消息区域-->
            <ContentControl Grid.Row="0"
                            Height="36"
                            prism:RegionManager.RegionName="{x:Static constants:HostRegionNames.ErrorRegion}" />
            <!--#endregion-->

            <!-- Toast 区域 -->
            <ItemsControl Grid.Row="1"
                          Margin="0,24,24,0"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          d:ItemsSource="{d:SampleData ItemCount=3}"
                          Grid.ZIndex="999"
                          ItemsSource="{Binding ToastService.ActiveToasts}">

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type pm:AuraToast}">
                        <Border x:Name="ToastBorder"
                                MaxWidth="250"
                                Margin="0,0,0,10"
                                Padding="20,12"
                                HorizontalAlignment="Right"
                                Background="{DynamicResource Brushes.SurfaceContainerHighest}"
                                BorderBrush="{DynamicResource Brushes.OutlineVariant}"
                                BorderThickness="1"
                                CornerRadius="4"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20"
                                                  Direction="270"
                                                  Opacity="0.15"
                                                  ShadowDepth="6" />
                            </Border.Effect>
                            <Border.LayoutTransform>
                                <ScaleTransform x:Name="LayoutScale" ScaleY="1" />
                            </Border.LayoutTransform>

                            <Border.RenderTransform>
                                <TranslateTransform x:Name="RenderMove" Y="0" />
                            </Border.RenderTransform>
                            <TextBlock x:Name="MessageTextBlock"
                                       d:Foreground="{DynamicResource Brushes.OnSurface}"
                                       d:Text="验证码已发送至 example@domain.com"
                                       Style="{DynamicResource BodySmallTextBlockStyle}"
                                       Text="{Binding Message}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Level}" Value="Info">
                                <Setter TargetName="MessageTextBlock" Property="Foreground" Value="{DynamicResource Brushes.OnSurface}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Success">
                                <Setter TargetName="MessageTextBlock" Property="Foreground" Value="{DynamicResource Brushes.Success}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Warning">
                                <Setter TargetName="MessageTextBlock" Property="Foreground" Value="{DynamicResource Brushes.Warning}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                <Setter TargetName="MessageTextBlock" Property="Foreground" Value="{DynamicResource Brushes.Error}" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding IsClosing}" Value="False">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ToastBorder"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0"
                                                             To="1"
                                                             Duration="0:0:0.3" />
                                            <DoubleAnimation Storyboard.TargetName="RenderMove"
                                                             Storyboard.TargetProperty="Y"
                                                             From="20"
                                                             To="0"
                                                             Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="1" EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ToastBorder"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.3" />
                                            <DoubleAnimation Storyboard.TargetName="RenderMove"
                                                             Storyboard.TargetProperty="Y"
                                                             To="-20"
                                                             Duration="0:0:1">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="LayoutScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0"
                                                             Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>

                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</Window>
