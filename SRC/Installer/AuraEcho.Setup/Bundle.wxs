<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
	 xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
	 xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx">

	<Bundle Name="AuraEcho"
			Manufacturer="Suencesoft"
			Version="$(var.BundleVersion)"
			SplashScreenSourceFile="Assets/Images/splash_screen.bmp"
			IconSourceFile="Assets/Icons/AuraEcho.ico"
			InProgressName="AuraEcho Installing"
			UpgradeCode="73725F25-4E6A-4817-B1EC-69A577E59D25">
		
		<netfx:DotNetCoreSearch RuntimeType="desktop" MajorVersion="10" Platform="x64" Variable="DOTNETDESKTOPVERSION" />
		<Variable Name="InstallFolder" Type="string" Value="[ProgramFiles6432Folder]AuraEcho" />
		<Variable Name="RemoveLocalDataOnUninstall" Type="string" Value="0" />
		<Variable Name="BundleFileName" Value="$(var.BundleFileName).exe" Type="string" />
		<Variable Name="AppLauncherExeName" Type="string" Value="AuraEchoLauncher.exe" />
		
		<BootstrapperApplication SourceFile="AuraEcho.Setup.UI.exe" Secondary="$(var.IncludeRuntime)">
			<Payload SourceFile="mbanative.dll" />
			<Payload SourceFile="AuraEcho.Setup.UI.dll" />
			<Payload SourceFile="DryIoc.dll" />
			<Payload SourceFile="Microsoft.WindowsAPICodePack.dll" />
			
			<Payload SourceFile="Microsoft.Toolkit.Uwp.Notifications.dll" />
			<Payload SourceFile="Microsoft.Windows.SDK.NET.dll" />
			<Payload SourceFile="WinRT.Runtime.dll" />
			
			<Payload SourceFile="Microsoft.WindowsAPICodePack.Shell.dll" />
			<Payload SourceFile="Microsoft.Xaml.Behaviors.dll" />
			<Payload SourceFile="Prism.dll" />
			<Payload SourceFile="Prism.DryIoc.Wpf.dll" />
			<Payload SourceFile="Prism.Wpf.dll" />
			<Payload SourceFile="AuraEcho.Controls.dll" />
			<Payload SourceFile="AuraEcho.Themes.dll" />
			<Payload SourceFile="AuraEcho.PluginContracts.dll" />
			<Payload SourceFile="AuraEcho.UIToolkit.dll" />
			<Payload SourceFile="WixToolset.BootstrapperApplicationApi.dll" />
			<Payload SourceFile="AuraEcho.Setup.UI.runtimeconfig.json" />
			<Payload SourceFile="Assets/PDF/EULA.pdf" />

			<?if $(var.IncludeRuntime) = "yes" ?>
			<bal:WixPrerequisiteBootstrapperApplication Theme="standard" LogoFile="Assets/Icons/AuraEcho.ico" LocalizationFile="Strings/zh-cn.wxl"/>
			<?endif ?>

		</BootstrapperApplication>

		<Chain DisableSystemRestore="yes">

			<!-- Runtime -->
			<?if $(var.IncludeRuntime) = "yes" ?>
			<!-- Permanent: 永久(卸载时保留) or 指定卸载参数 UninstallArguments="/uninstall /quiet /norestart" -->
			<ExePackage Id="DotNetDesktop"
						DetectCondition="DOTNETDESKTOPVERSION &gt;= &quot;10.0.0&quot;"
						Permanent="yes"
						Vital="no"
						RepairCondition="DOTNETDESKTOPVERSION &lt; &quot;10.0.0&quot;"
						bal:PrereqLicenseUrl="https://dotnet.microsoft.com"
						bal:PrereqPackage="yes"
						InstallArguments="windowsdesktop-runtime-10.0.0-win-x64.exe /install /quiet /norestart"
						RepairArguments="windowsdesktop-runtime-10.0.0-win-x64.exe /repair /quiet /norestart"
						UninstallArguments="windowsdesktop-runtime-10.0.0-win-x64.exe /uninstall /quiet /norestart">
				<ExePackagePayload SourceFile="ExePackageFiles/windowsdesktop-runtime-10.0.0-win-x64.exe" />
			</ExePackage>
			<?endif ?>

			<!-- AuraEcho -->
			<MsiPackage Id="AuraEchoInstallerMSI"
						Visible="yes"
						Compressed="yes"
						SourceFile="$(AuraEcho.Installer.TargetFileName)">
				<MsiProperty Name="INSTALLFOLDER" Value="[InstallFolder]"/>
			</MsiPackage>

			<!-- AuraEcho Launcher -->
			<MsiPackage Id="AuraEchoLauncherMSI"
						Visible="yes"
						Compressed="yes"
						EnableFeatureSelection="yes"
						SourceFile="$(AuraEcho.Launcher.Installer.TargetFileName)">
				<MsiProperty Name="INSTALLFOLDER" Value="[InstallFolder]"/>
				<MsiProperty Name="UNINSTALLER_PATH" Value="[UninstallerPath]"/>
				<MsiProperty Name="REMOVE_LOCAL_DATA" Value="[RemoveLocalDataOnUninstall]" />
			</MsiPackage>

			<!-- Plugin Installer -->
			<MsiPackage Id="PluginInstallerMSI"
						Visible="yes"
						Compressed="yes"
						SourceFile="$(AuraEcho.PluginInstaller.Installer.TargetFileName)">
				<MsiProperty Name="INSTALLFOLDER" Value="[InstallFolder]"/>
			</MsiPackage>

			<!-- Data Migrator -->
			<MsiPackage Id="AuraEchoDataMigratorMsi"
						Visible="yes"
						Compressed="yes"
						SourceFile="$(AuraEcho.DataMigrator.Installer.TargetFileName)">
				<MsiProperty Name="INSTALLFOLDER" Value="[InstallFolder]"/>
			</MsiPackage>

			<!-- Updater Service -->
			<MsiPackage Id="AuraEchoUpdaterServiceMsi"
						Visible="yes"
						Compressed="yes"
						SourceFile="$(AuraEcho.UpdaterService.Installer.TargetFileName)">
				<MsiProperty Name="INSTALLFOLDER" Value="[InstallFolder]"/>
			</MsiPackage>

			<!-- Launcher Service -->
			<MsiPackage Id="AuraEchoLauncherServiceMsi"
						Visible="yes"
						Compressed="yes"
						SourceFile="$(AuraEcho.LauncherService.Installer.TargetFileName)">
				<MsiProperty Name="INSTALLFOLDER" Value="[InstallFolder]"/>
			</MsiPackage>
		</Chain>
	</Bundle>
</Wix>
