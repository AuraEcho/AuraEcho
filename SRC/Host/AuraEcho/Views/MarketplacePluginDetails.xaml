<UserControl x:Class="AuraEcho.Views.MarketplacePluginDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AuraEcho.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:enums="clr-namespace:AuraEcho.Enums"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:AuraEcho.Models"
             xmlns:pcap="clr-namespace:AuraEcho.PluginContracts.AttachedProperties;assembly=AuraEcho.PluginContracts"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:selectors="clr-namespace:AuraEcho.Selectors"
             xmlns:sv="clr-namespace:AuraEcho.Services"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:ui="http://ui.auraecho.com/"
             xmlns:uv="clr-namespace:AuraEcho.UIToolkit.Converters;assembly=AuraEcho.UIToolkit"
             xmlns:viewmodels="clr-namespace:AuraEcho.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:MarketplacePluginDetailsViewModel}"
             d:DesignHeight="1235"
             d:DesignWidth="820"
             d:Foreground="{DynamicResource Brushes.OnSurface}"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{DynamicResource Brushes.SurfaceContainerLowest}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ui:BindingProxy x:Key="BindingProxy" Data="{Binding}" />
        <DataTemplate x:Key="NotInstalledTemplate" DataType="{x:Type enums:MarketPluginInstallStatus}">
            <Button Width="200"
                    Height="52"
                    Padding="16,0"
                    HorizontalContentAlignment="Left"
                    d:Content="INSTALL"
                    Command="{Binding Source={StaticResource BindingProxy}, Path=Data.InstallCommand}"
                    FontSize="{DynamicResource FontSize.Label.Large}"
                    Style="{DynamicResource PrimaryButtonStyle}">
                <i:Interaction.Triggers>
                    <i:DataTrigger Binding="{Binding Source={StaticResource BindingProxy}, Path=Data.MarketPlugin.Status}" Value="{x:Static enums:MarketPluginStatus.Acquired}">
                        <ui:SetBindingAction PropertyName="Content" Binding="{Binding Source={StaticResource R}, Path=Labels.MarketplacePluginDetails_Install}" />
                    </i:DataTrigger>
                    <i:DataTrigger Binding="{Binding Source={StaticResource BindingProxy}, Path=Data.MarketPlugin.Status}" Value="{x:Static enums:MarketPluginStatus.None}">
                        <ui:SetBindingAction PropertyName="Content" Binding="{Binding Source={StaticResource R}, Path=Labels.MarketplacePluginDetails_Acquire}" />
                    </i:DataTrigger>
                </i:Interaction.Triggers>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="DownloadingTemplate" DataType="{x:Type enums:MarketPluginInstallStatus}">
            <Border Width="200"
                    Height="52"
                    CornerRadius="4">
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource Colors.Overlay.Level3}" />
                </Border.Background>
                <DockPanel LastChildFill="True">
                    <ProgressBar d:Value="80"
                                 DockPanel.Dock="Top"
                                 Value="{Binding Source={StaticResource BindingProxy}, Path=Data.MarketPlugin.InstallContext.Progress, Mode=OneWay}" />
                    <TextBlock Margin="16,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               d:Text="正在下载(87.23%)"
                               FontSize="{DynamicResource FontSize.Label.Medium}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}{1:F2}%)">
                                <Binding Path="Labels.MarketplacePluginDetails_DownloadingPrefix" Source="{StaticResource R}" />
                                <Binding Path="Data.MarketPlugin.InstallContext.Progress" Source="{StaticResource BindingProxy}" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </DockPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="InstallingTemplate" DataType="{x:Type enums:MarketPluginInstallStatus}">
            <Border Width="200"
                    Height="52"
                    CornerRadius="4">
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource Colors.Overlay.Level3}" />
                </Border.Background>
                <DockPanel LastChildFill="True">
                    <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" />
                    <TextBlock Margin="16,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Style="{DynamicResource LabelMediumTextBlockStyle}"
                               Text="{Binding Source={StaticResource R}, Path=Labels.MarketplacePluginDetails_Installing}" />
                </DockPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="AcquiringTemplate" DataType="{x:Type enums:MarketPluginInstallStatus}">
            <Border Width="200"
                    Height="52"
                    CornerRadius="4">
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource Colors.Overlay.Level3}" />
                </Border.Background>
                <DockPanel LastChildFill="True">
                    <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" />
                    <TextBlock Margin="16,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Style="{DynamicResource LabelMediumTextBlockStyle}"
                               Text="{Binding Source={StaticResource R}, Path=Labels.MarketplacePluginDetails_Acquiring}" />
                </DockPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="InstalledTemplate" DataType="{x:Type enums:MarketPluginInstallStatus}">
            <Button Width="200"
                    Height="52"
                    Padding="16,0"
                    HorizontalContentAlignment="Left"
                    Command="{Binding Source={StaticResource BindingProxy}, Path=Data.OpenPluginCommand}"
                    Content="{Binding Source={StaticResource R}, Path=Labels.MarketplacePluginDetails_Open}"
                    FontSize="{DynamicResource FontSize.Label.Large}"
                    Style="{DynamicResource PrimaryButtonStyle}" />
        </DataTemplate>
        <Storyboard x:Key="ScreenshotStoryboard">
            <DoubleAnimation Storyboard.TargetName="ScreenshotScrollViewer"
                             Storyboard.TargetProperty="(ui:ScrollViewerHelper.HorizontalOffset)"
                             Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CircleEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="ShowBlurBannerStoryboard">
            <DoubleAnimation Storyboard.TargetName="BlurBannerContainer"
                             Storyboard.TargetProperty="Opacity"
                             To="1"
                             Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CircleEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="HideBlurBannerStoryboard">
            <DoubleAnimation Storyboard.TargetName="BlurBannerContainer"
                             Storyboard.TargetProperty="Opacity"
                             To="0"
                             Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CircleEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="ShowDetailsStoryboard">
            <DoubleAnimation Storyboard.TargetName="ContentContainerStackPanel"
                             Storyboard.TargetProperty="Opacity"
                             To="1"
                             Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CircleEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="DetailStackPanel"
                             Storyboard.TargetProperty="Opacity"
                             To="1"
                             Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CircleEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="DetailStackPanel"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             To="0"
                             Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CircleEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:ControlStoryboardAction Storyboard="{StaticResource ShowDetailsStoryboard}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <ScrollViewer ui:ScrollViewerHelper.VerticalScrollBarMargin="0, 36, 0, 0" Background="{DynamicResource Brushes.SurfaceContainerLowest}">
        <StackPanel x:Name="ContentContainerStackPanel"
                    Opacity="0"
                    d:Opacity="1">
            <Grid>
                <i:Interaction.Triggers>
                    <i:DataTrigger Binding="{Binding ElementName=ContentContainerStackPanel, Path=ActualWidth}"
                                   Comparison="LessThan"
                                   Value="800">
                        <i:ControlStoryboardAction Storyboard="{StaticResource ShowBlurBannerStoryboard}" />
                        <i:ChangePropertyAction PropertyName="Margin"
                                                TargetName="SummaryStackPanel"
                                                Value="48, 72, 48, 0" />
                        <i:ChangePropertyAction PropertyName="Margin"
                                                TargetName="DetailStackPanel"
                                                Value="48, 0, 48, 32" />
                        <i:ChangePropertyAction PropertyName="Height"
                                                TargetName="BannerLayoutRoot"
                                                Value="320" />
                    </i:DataTrigger>
                    <i:DataTrigger Binding="{Binding ElementName=ContentContainerStackPanel, Path=ActualWidth}"
                                   Comparison="GreaterThanOrEqual"
                                   Value="800">
                        <i:ControlStoryboardAction Storyboard="{StaticResource HideBlurBannerStoryboard}" />
                        <i:ChangePropertyAction PropertyName="Margin"
                                                TargetName="SummaryStackPanel"
                                                Value="88,120,88,0" />
                        <i:ChangePropertyAction PropertyName="Margin"
                                                TargetName="DetailStackPanel"
                                                Value="88,0,88,32" />
                        <i:ChangePropertyAction PropertyName="Height"
                                                TargetName="BannerLayoutRoot"
                                                Value="400" />
                    </i:DataTrigger>
                </i:Interaction.Triggers>
                <Grid x:Name="BannerLayoutRoot" Height="400">
                    <Grid x:Name="BannerGrid" ColumnDefinitions="*, 2*">
                        <!-- 平均色背景 -->
                        <Border x:Name="OptimizedBrush"
                                Grid.Column="0"
                                Grid.ColumnSpan="2">
                            <Border.Background>
                                <Binding ElementName="BannerImage" Path="Source">
                                    <Binding.Converter>
                                        <uv:OptimizedBrushConverter />
                                    </Binding.Converter>
                                </Binding>
                            </Border.Background>
                        </Border>
                        <Border Grid.Column="1" VerticalAlignment="Top">
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0, 0" EndPoint="0, 1">
                                    <GradientStop Offset="0" Color="#FF000000" />
                                    <GradientStop Offset="0.8" Color="#FF000000" />
                                    <GradientStop Offset="1" Color="#00000000" />
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                            <Border>
                                <Image x:Name="BannerImage"
                                       pcap:WebImageHelper.DecodePixelHeight="800"
                                       pcap:WebImageHelper.Url="{Binding MarketPlugin.PluginInfo.BannerFileUrl}" />
                                <Border.OpacityMask>
                                    <RadialGradientBrush Center="0.5, 0.4" RadiusX="0.5" RadiusY="0.7">
                                        <GradientStop Offset="0" Color="#FF000000" />
                                        <GradientStop Offset="0.6" Color="#FF000000" />
                                        <GradientStop Offset="1" Color="#00000000" />
                                    </RadialGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                        </Border>
                        <!-- 圆形透明遮罩层 -->
                        <Border Grid.Column="0" Grid.ColumnSpan="2">
                            <Border.Background>
                                <RadialGradientBrush Center="0.5, 0.5" GradientOrigin="0.65, 0.5" RadiusX="0.5" RadiusY="2">
                                    <GradientStop Offset="0" Color="#00000000" />
                                    <GradientStop Offset="1.2" Color="{DynamicResource Colors.IdentityColor}" />
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                    <Grid x:Name="BlurBannerContainer" Opacity="0">
                        <Rectangle x:Name="BlurBannerClipShape">
                            <Rectangle.Fill>
                                <SolidColorBrush Color="{DynamicResource Colors.IdentityColor}" />
                            </Rectangle.Fill>
                        </Rectangle>
                        <Border>
                            <i:Interaction.Behaviors>
                                <ui:ShapeClipBehavior SourceShape="{Binding ElementName=BlurBannerClipShape}" />
                            </i:Interaction.Behaviors>
                            <Border RenderTransformOrigin=".5, .5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1.2" ScaleY="1.2" />
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <BlurEffect Radius="100" />
                                </Border.Effect>
                                <Border.Background>
                                    <VisualBrush Visual="{Binding ElementName=BannerGrid}" />
                                </Border.Background>
                            </Border>
                        </Border>
                        <Rectangle>
                            <Rectangle.Fill>
                                <SolidColorBrush Color="{DynamicResource Colors.InverseOverlay.Level6}" />
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                    <Grid.OpacityMask>
                        <LinearGradientBrush StartPoint="0, 0" EndPoint="0, 1">
                            <GradientStop Offset="0" Color="#FF000000" />
                            <GradientStop Offset="0.6" Color="#F1000000" />
                            <GradientStop Offset="0.7" Color="#D1000000" />
                            <GradientStop Offset="1" Color="#00000000" />
                        </LinearGradientBrush>
                    </Grid.OpacityMask>
                </Grid>
                <StackPanel x:Name="SummaryStackPanel"
                            MaxWidth="1200"
                            Margin="88,120,88,0">
                    <DockPanel Margin="0,0,0,16" LastChildFill="True">
                        <Border Width="85"
                                Height="85"
                                Margin="0,0,16,0"
                                CornerRadius="8"
                                DockPanel.Dock="Left">
                            <Border.Background>
                                <ImageBrush d:ImageSource="/Assets/Icons/AuraEcho.ico"
                                            pcap:WebImageHelper.DecodePixelWidth="170"
                                            pcap:WebImageHelper.Url="{Binding MarketPlugin.PluginInfo.IconFileUrl}" />
                            </Border.Background>
                        </Border>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,4"
                                       d:Text="窗口管理器"
                                       FontSize="{DynamicResource FontSize.Display.Small}"
                                       FontWeight="SemiBold"
                                       Text="{Binding MarketPlugin.PluginInfo.Name}" />
                            <TextBlock Margin="0,0,0,4"
                                       d:Text="Plugin author"
                                       FontSize="{DynamicResource FontSize.Label.Large}"
                                       Text="{Binding MarketPlugin.PluginInfo.Author}" />
                            <StackPanel HorizontalAlignment="Left"
                                        Background="Transparent"
                                        Orientation="Horizontal"
                                        ToolTip="{Binding Source={StaticResource R}, Path=Labels.MarketplacePluginDetails_UserCount}">
                                <TextBlock Margin="0,0,4,0"
                                           VerticalAlignment="Center"
                                           d:Text="100,221"
                                           Style="{DynamicResource LabelLargeTextBlockStyle}"
                                           Text="{Binding MarketPlugin.PluginInfo.UserCount, StringFormat={}{0:N0}}" />
                                <Viewbox Width="24" Height="24">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 15.75 18.75 V 17.25 C 15.75 16.45 15.43 15.69 14.87 15.13 C 14.31 14.57 13.55 14.25 12.75 14.25 H 6.75 C 5.95 14.25 5.19 14.57 4.63 15.13 C 4.07 15.69 3.75 16.45 3.75 17.25 V 18.75 M 20.25 18.75 V 17.25 C 20.25 16.59 20.03 15.94 19.62 15.41 C 19.21 14.89 18.64 14.51 18 14.35 M 15 5.35 C 15.65 5.51 16.22 5.89 16.63 6.41 C 17.03 6.94 17.26 7.59 17.26 8.25 C 17.26 8.92 17.03 9.57 16.63 10.09 C 16.22 10.62 15.65 10.99 15 11.16 M 12.75 8.25 C 12.75 9.91 11.41 11.25 9.75 11.25 C 8.09 11.25 6.75 9.91 6.75 8.25 C 6.75 6.59 8.09 5.25 9.75 5.25 C 11.41 5.25 12.75 6.59 12.75 8.25 Z"
                                              Stroke="{DynamicResource Brushes.OnSurface}"
                                              StrokeDashCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeThickness="1.5" />
                                    </Canvas>
                                </Viewbox>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock MaxWidth="400"
                               Margin="0,0,0,16"
                               HorizontalAlignment="Left"
                               d:Text="扩展说明文本"
                               Style="{DynamicResource BodyMediumTextBlockStyle}"
                               Text="{Binding MarketPlugin.PluginInfo.Summary}"
                               TextWrapping="Wrap" />
                    <ContentControl Margin="0,0,0,24"
                                    HorizontalAlignment="Left"
                                    d:ContentTemplate="{StaticResource DownloadingTemplate}"
                                    Content="{Binding MarketPlugin.InstallContext.Status}">
                        <ContentControl.ContentTemplateSelector>
                            <selectors:MarketPluginStateTemplateSelector AcquiringTemplate="{StaticResource AcquiringTemplate}"
                                                                         DownloadingTemplate="{StaticResource DownloadingTemplate}"
                                                                         InstalledTemplate="{StaticResource InstalledTemplate}"
                                                                         InstallingTemplate="{StaticResource InstallingTemplate}"
                                                                         NotInstalledTemplate="{StaticResource NotInstalledTemplate}" />
                        </ContentControl.ContentTemplateSelector>
                    </ContentControl>
                </StackPanel>
            </Grid>
            <StackPanel x:Name="DetailStackPanel"
                        MaxWidth="1200"
                        Margin="88,0,88,32"
                        Opacity="0"
                        d:Opacity="1"
                        RenderTransformOrigin="0.5, 0">
                <StackPanel.RenderTransform>
                    <TranslateTransform Y="24" />
                </StackPanel.RenderTransform>
                <Border Margin="0,0,0,16"
                        Background="{DynamicResource Brushes.SurfaceContainer}"
                        CornerRadius="4">
                    <StackPanel>
                        <TextBlock Margin="16"
                                   Style="{DynamicResource BodyLargeTextBlockStyle}"
                                   Text="{Binding Source={StaticResource R}, Path=Labels.MarketplacePluginDetails_Screenshots}" />
                        <Line Stretch="Fill"
                              Stroke="{DynamicResource Brushes.OutlineVariant}"
                              X1="0"
                              X2="1"
                              Y1="0"
                              Y2="0" />
                        <Grid ClipToBounds="True">
                            <Grid.Resources>
                                <Storyboard x:Key="ShowScrollButtonStoryboard">
                                    <DoubleAnimation Storyboard.TargetName="ScrollLeftButton"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1"
                                                     Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction>
                                            <CircleEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="ScrollRightButton"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1"
                                                     Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction>
                                            <CircleEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="ScrollLeftButton"
                                                     Storyboard.TargetProperty="(Button.RenderTransform).(TranslateTransform.X)"
                                                     From="-48"
                                                     To="0"
                                                     Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction>
                                            <CircleEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="ScrollRightButton"
                                                     Storyboard.TargetProperty="(Button.RenderTransform).(TranslateTransform.X)"
                                                     From="48"
                                                     To="0"
                                                     Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction>
                                            <CircleEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                                <Storyboard x:Key="HideScrollButtonStoryboard">
                                    <DoubleAnimation Storyboard.TargetName="ScrollLeftButton"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0"
                                                     Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction>
                                            <CircleEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="ScrollRightButton"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0"
                                                     Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction>
                                            <CircleEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </Grid.Resources>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="MouseEnter">
                                    <i:ControlStoryboardAction Storyboard="{StaticResource ShowScrollButtonStoryboard}" />
                                </i:EventTrigger>
                                <i:EventTrigger EventName="MouseLeave">
                                    <i:ControlStoryboardAction Storyboard="{StaticResource HideScrollButtonStoryboard}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                            <ScrollViewer x:Name="ScreenshotScrollViewer"
                                          HorizontalScrollBarVisibility="Hidden"
                                          ScrollChanged="ScreenshotScrollViewer_ScrollChanged">
                                <i:Interaction.Behaviors>
                                    <ui:IgnoreMouseWheelBehavior />
                                </i:Interaction.Behaviors>
                                <ItemsControl Margin="8"
                                              d:ItemsSource="{d:SampleData ItemCount=3}"
                                              ItemsSource="{Binding MarketPlugin.PluginInfo.Screenshots}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="8">
                                                <Grid.Resources>
                                                    <ui:BindingProxy x:Key="DataContextProxy" Data="{Binding}"/>
                                                </Grid.Resources>
                                                <Border Width="488"
                                                        Height="252"
                                                        CornerRadius="4">
                                                    <Border.Background>
                                                        <ImageBrush pcap:WebImageHelper.DecodePixelWidth="976"
                                                                    pcap:WebImageHelper.Url="{Binding Source={StaticResource DataContextProxy}, Path=Data.FileUrl}"
                                                                    Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>

                                                <Button ui:ControlHelper.CornerRadius="4"
                                                        Background="Transparent"
                                                        Command="{Binding Source={StaticResource BindingProxy}, Path=Data.NavigationToViewScreenshotCommand}"
                                                        CommandParameter="{Binding}"
                                                        RequestBringIntoView="Button_RequestBringIntoView" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Button x:Name="ScrollLeftButton"
                                    Margin="8"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    d:Opacity="1"
                                    ui:ControlHelper.CornerRadius="24"
                                    Click="ScrollLeft_Click"
                                    Opacity="0"
                                    RenderTransformOrigin="0.5, 0.5"
                                    Style="{DynamicResource PrimaryButtonStyle}">
                                <Button.RenderTransform>
                                    <TranslateTransform d:X="0" X="-48" />
                                </Button.RenderTransform>
                                <Viewbox Width="24" Height="24">
                                    <Canvas Width="24.0" Height="24.0">
                                        <Canvas>
                                            <Path Data="M 15 18 L 9 12 L 15 6"
                                                  Stroke="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Button}}, Path=Foreground}"
                                                  StrokeDashCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeThickness="2.0" />
                                        </Canvas>
                                    </Canvas>
                                </Viewbox>

                            </Button>
                            <Button x:Name="ScrollRightButton"
                                    Margin="8"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    d:Opacity="1"
                                    ui:ControlHelper.CornerRadius="24"
                                    Click="ScrollRight_Click"
                                    Opacity="0"
                                    RenderTransformOrigin=".5, .5"
                                    Style="{DynamicResource PrimaryButtonStyle}">
                                <Button.RenderTransform>
                                    <TranslateTransform d:X="0" X="48" />
                                </Button.RenderTransform>
                                <Viewbox Width="24" Height="24">
                                    <Canvas Width="24.0" Height="24.0">
                                        <Canvas>
                                            <Path Data="M 9 18 L 15 12 L 9 6"
                                                  Stroke="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Button}}, Path=Foreground}"
                                                  StrokeDashCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeThickness="2.0" />
                                        </Canvas>
                                    </Canvas>
                                </Viewbox>

                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Margin="0,0,0,16"
                        Background="{DynamicResource Brushes.SurfaceContainer}"
                        CornerRadius="4">
                    <StackPanel>
                        <TextBlock Margin="16"
                                   Style="{DynamicResource BodyLargeTextBlockStyle}"
                                   Text="{Binding Source={StaticResource R}, Path=Labels.MarketplacePluginDetails_Description}" />
                        <Line Stretch="Fill"
                              Stroke="{DynamicResource Brushes.OutlineVariant}"
                              X1="0"
                              X2="1"
                              Y1="0"
                              Y2="0" />
                        <TextBlock Margin="16"
                                   d:Text="这是此扩展的描述文本"
                                   Style="{DynamicResource BodyMediumTextBlockStyle}"
                                   Text="{Binding MarketPlugin.PluginInfo.Description}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,0,16"
                        Background="{DynamicResource Brushes.SurfaceContainer}"
                        CornerRadius="4">
                    <StackPanel>
                        <TextBlock Margin="16"
                                   Style="{DynamicResource BodyLargeTextBlockStyle}"
                                   Text="{Binding Source={StaticResource R}, Path=Labels.MarketplacePluginDetails_ReleaseNotes}" />
                        <Line Stretch="Fill"
                              Stroke="{DynamicResource Brushes.OutlineVariant}"
                              X1="0"
                              X2="1"
                              Y1="0"
                              Y2="0" />
                        <TextBlock Margin="16"
