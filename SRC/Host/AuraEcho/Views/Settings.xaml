<UserControl x:Class="AuraEcho.Views.Settings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cc="clr-namespace:AuraEcho.PluginContracts.Constants;assembly=AuraEcho.PluginContracts"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pm="clr-namespace:AuraEcho.PluginContracts.Models;assembly=AuraEcho.PluginContracts"
             xmlns:auraecho="http://ui.auraecho.com/"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:viewmodels="clr-namespace:AuraEcho.ViewModels"
             Padding="0,36,0,0"
             d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}"
             d:DesignHeight="425"
             d:DesignWidth="495"
             d:Foreground="{DynamicResource Brushes.OnSurface}"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{DynamicResource Brushes.SurfaceContainerLowest}"
             mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadSettingsCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <UserControl.Resources>
        <auraecho:BindingProxy x:Key="BindingProxy" Data="{Binding}" />

        <DataTemplate x:Key="SettingsItemTemplate" DataType="{x:Type pm:AppSettingsItem}">
            <Button Margin="0,0,0,1"
                    Padding="8"
                    HorizontalContentAlignment="Stretch"
                    d:Content="Plugin"
                    BorderThickness="0"
                    Command="{Binding Source={StaticResource BindingProxy}, Path=Data.NavigationToSettingsItemCommand}"
                    CommandParameter="{Binding ViewName}">
                <TextBlock VerticalAlignment="Center"
                           d:Text="Plugin Name"
                           Text="{Binding Name}" />
            </Button>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="8,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontSize="20"
                           Text="{Binding Source={StaticResource R}, Path=Labels.Settings}" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Width="200">
                <Border Margin="0,0,0,8"
                        Padding="8"
                        Background="#10FFFFFF"
                        CornerRadius="4">
                    <StackPanel Grid.Column="1">
                        <Grid>
                            
                        <TextBlock FontSize="18"
                                   FontWeight="Bold"
                                   Text="{Binding CurrentUser.UserName}" />
                            <Button Content="SIGN OUT" HorizontalAlignment="Right" Command="{Binding SignOutCommand}"/>
                        </Grid>
                        <TextBlock Text="{Binding CurrentUser.Id}" />
                    </StackPanel>
                </Border>
                <ItemsControl ItemTemplate="{StaticResource SettingsItemTemplate}" ItemsSource="{Binding SettingsItems}">
                    <d:ItemsControl.ItemsSource>
                        <x:Array Type="{x:Type pm:AppSettingsItem}">
                            <pm:AppSettingsItem Name="常规" />
                            <pm:AppSettingsItem Name="PLUGINA" />
                            <pm:AppSettingsItem Name="PLUGINB" />
                        </x:Array>
                    </d:ItemsControl.ItemsSource>
                </ItemsControl>
            </StackPanel>


            <ContentControl Grid.Column="1" prism:RegionManager.RegionName="{x:Static cc:HostRegionNames.SettingsContentRegion}" />
        </Grid>
    </Grid>
</UserControl>
