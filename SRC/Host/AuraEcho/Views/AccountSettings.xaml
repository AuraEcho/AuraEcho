<UserControl x:Class="AuraEcho.Views.AccountSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:AuraEcho.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pcap="clr-namespace:AuraEcho.PluginContracts.AttachedProperties;assembly=AuraEcho.PluginContracts"
             xmlns:pm="clr-namespace:AuraEcho.PluginContracts.Models;assembly=AuraEcho.PluginContracts"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:ui="http://ui.auraecho.com/"
             xmlns:viewmodels="clr-namespace:AuraEcho.ViewModels"
             d:Background="{DynamicResource Brushes.SurfaceContainerLowest}"
             d:DataContext="{d:DesignInstance Type=viewmodels:AccountSettingsViewModel}"
             d:DesignHeight="425"
             d:DesignWidth="495"
             d:Foreground="{DynamicResource Brushes.OnSurface}"
             prism:ViewModelLocator.AutoWireViewModel="True"
             UseLayoutRounding="True"
             mc:Ignorable="d">
    <Grid Margin="24,0,24,24">
        <StackPanel Margin="0,0">
            <TextBlock Margin="0,0,0,24"
                       HorizontalAlignment="Left"
                       Style="{DynamicResource HeadlineLargeTextBlockStyle}"
                       Text="{Binding Source={StaticResource Loc}, Path=Labels.AccountSettings_Title}" />
            <WrapPanel>
                <StackPanel Margin="0,0,0,24">
                    <TextBlock Margin="0,0,0,8"
                               Style="{DynamicResource BodyLargeTextBlockStyle}"
                               Text="{Binding Source={StaticResource Loc}, Path=Labels.AccountSettings_Avatar}" />
                    <Grid Width="150" Height="150">
                        <Border BorderBrush="{DynamicResource Brushes.Outline}"
                                BorderThickness="1"
                                CornerRadius="100">
                            <Border.Background>
                                <ImageBrush Stretch="UniformToFill">
                                    <ImageBrush.ImageSource>
                                        <BitmapImage DecodePixelHeight="300"
                                                     DecodePixelWidth="300"
                                                     UriSource="/Assets/Images/auraecho.png" />
                                    </ImageBrush.ImageSource>
                                </ImageBrush>
                            </Border.Background>
                        </Border>
                        <Border BorderBrush="{DynamicResource Brushes.Outline}"
                                BorderThickness="1"
                                CornerRadius="100">
                            <Border.Background>
                                <ImageBrush pcap:WebImageHelper.DecodePixelWidth="300"
                                            pcap:WebImageHelper.Url="{Binding NewAvatarFileUrl}"
                                            Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <Border Margin="8"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource Brushes.SurfaceContainerLowest}"
                                CornerRadius="4">
                            <Button x:Name="SelectAvatarFileButton"
                                    Padding="8, 4"
                                    ui:ControlHelper.IsBusy="{Binding IsUploadingAvatar}"
                                    ui:ControlHelper.BusyContent="{Binding Source={StaticResource Loc}, Path=Labels.AccountSettings_Uploading}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Click="SelectAvatarFileButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="20"
                                             Height="20"
                                             Margin="0,0,4,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M5,3C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19H5V5H12V3H5M17.78,4C17.61,4 17.43,4.07 17.3,4.2L16.08,5.41L18.58,7.91L19.8,6.7C20.06,6.44 20.06,6 19.8,5.75L18.25,4.2C18.12,4.07 17.95,4 17.78,4M15.37,6.12L8,13.5V16H10.5L17.87,8.62L15.37,6.12Z" Fill="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Button}}, Path=Foreground}" />
                                        </Canvas>
                                    </Viewbox>
                                    <Label Height="20"
                                           Padding="0"
                                           VerticalAlignment="Center"
                                           VerticalContentAlignment="Center"
                                           Content="{Binding Source={StaticResource Loc}, Path=Labels.AccountSettings_ChangeAvatar}"
                                           FontSize="{DynamicResource FontSize.Label.Small}"
                                           Foreground="{DynamicResource Brushes.OnSurface}" />
                                </StackPanel>
                            </Button>
                        </Border>
                    </Grid>
                </StackPanel>
                <Border Width="48" />
                <StackPanel UseLayoutRounding="True">
                    <TextBlock Margin="0,0,0,8"
                               Style="{DynamicResource BodyMediumTextBlockStyle}"
                               Text="{Binding Source={StaticResource Loc}, Path=Labels.AccountSettings_UserName}" />
                    <TextBox x:Name="NewUserNameTextBox"
                             Width="200"
                             Height="40"
                             Margin="0,0,0,2"
                             Padding="8,0"
                             HorizontalAlignment="Left"
                             d:Text="UserName"
                             FontSize="{DynamicResource FontSize.Body.Large}"
                             MaxLength="30"
                             Text="{Binding NewUserName, UpdateSourceTrigger=PropertyChanged}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="GotFocus">
                                <i:InvokeCommandAction Command="{Binding ClearErrorsCommand}" CommandParameter="NewUserName" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </TextBox>
                    <TextBlock Margin="0,0,0,24"
                               Foreground="{DynamicResource Brushes.OnSurfaceVariant}"
                               Style="{DynamicResource BodySmallTextBlockStyle}"
                               TextWrapping="Wrap">
                        <Run Text="{Binding Source={StaticResource Loc}, Path=Labels.AccountSettings_UserNameLengthHint, Mode=OneWay}" />
                        <LineBreak />
                        <Run Text="{Binding Source={StaticResource Loc}, Path=Labels.AccountSettings_UserNameSpecialCharHint, Mode=OneWay}" />
                        <TextBlock.Visibility>
                            <Binding ElementName="NewUserNameTextBox" Path="(Validation.HasError)">
                                <Binding.Converter>
                                    <ui:BooleanToObjectConverter FalseValue="{x:Static Visibility.Visible}" TrueValue="{x:Static Visibility.Hidden}" />
                                </Binding.Converter>
                            </Binding>
                        </TextBlock.Visibility>
                    </TextBlock>
                    <Button Padding="24,8"
                            HorizontalAlignment="Left"
                            ui:ControlHelper.IsBusy="{Binding IsSubmitting}"
                            ui:ControlHelper.BusyContent="{Binding Source={StaticResource Loc}, Path=Labels.AccountSettings_SaveChanges}"
                            Command="{Binding UpdateProfileCommand}"
                            Content="{Binding Source={StaticResource Loc}, Path=Labels.AccountSettings_SaveChanges}"
                            FontSize="{DynamicResource FontSize.Label.Medium}"
                            Style="{DynamicResource PrimaryButtonStyle}" />
                </StackPanel>
            </WrapPanel>
        </StackPanel>

    </Grid>
</UserControl>
