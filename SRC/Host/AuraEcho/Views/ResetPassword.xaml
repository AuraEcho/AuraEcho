<UserControl x:Class="AuraEcho.Views.ResetPassword"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cc="clr-namespace:AuraEcho.PluginContracts.Constants;assembly=AuraEcho.PluginContracts"
             xmlns:cm="clr-namespace:AuraEcho.Core.Models;assembly=AuraEcho.Core"
             xmlns:converters="clr-namespace:AuraEcho.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:AuraEcho.Core.Models;assembly=AuraEcho.Core"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:ui="http://ui.auraecho.com/"
             xmlns:viewmodels="clr-namespace:AuraEcho.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:ResetPasswordViewModel}"
             d:DesignHeight="640"
             d:DesignWidth="960"
             d:Foreground="{DynamicResource Themes.Brushes.OnBackground}"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="Black"
             mc:Ignorable="d">
    <Grid Background="{DynamicResource Themes.Background}">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <Grid>
                    <Border Width="80"
                            Height="80"
                            Margin="0,0,0,12"
                            Background="#FF9A3BFF"
                            CornerRadius="8">
                        <Border.Effect>
                            <BlurEffect Radius="40" />
                        </Border.Effect>
                    </Border>
                    <Border Width="80"
                            Height="80"
                            Margin="0,0,0,12"
                            BorderBrush="{DynamicResource Themes.BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Border.Background>
                            <ImageBrush ImageSource="/Assets/Images/auraecho.png" />
                        </Border.Background>
                    </Border>
                </Grid>
                <TextBlock Margin="0,0,0,40"
                           HorizontalAlignment="Center"
                           FontFamily="Microsoft YaHei UI"
                           FontSize="52"
                           FontWeight="Bold"
                           Text="重置密码">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0, 0" EndPoint="0, 1">
                            <GradientStop Offset="0.2" Color="White" />
                            <GradientStop Offset="1" Color="#00FFFFFF" />
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>
                <Grid Width="400" Height="320">
                    <Border Background="#33000000" BorderThickness="1" CornerRadius="8" BorderBrush="{DynamicResource Themes.BorderBrush}">
                        <Grid Margin="24">
                            <StackPanel>
                                <TextBox Height="40"
                                         Margin="0,0,0,20"
                                         Padding="8,0"
                                         ui:ControlHelper.PlaceHolder="请输入邮箱"
                                         FontSize="16"
                                         MaxLength="40"
                                         Text="{Binding Email}">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="GotFocus">
                                            <i:InvokeCommandAction Command="{Binding ClearErrorsCommand}" CommandParameter="Email" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </TextBox>
                                <Grid Margin="0,0,0,20">
                                    <i:Interaction.Triggers>
                                        <i:DataTrigger Binding="{Binding SendEmailCodeCooldown}" Value="0">
                                            <i:ChangePropertyAction PropertyName="Visibility"
                                                                    TargetName="SendEmailCodeTextBlock"
                                                                    Value="Visible" />
                                            <i:ChangePropertyAction PropertyName="Visibility"
                                                                    TargetName="SendEmailCodeCooldownTextBlock"
                                                                    Value="Hidden" />
                                        </i:DataTrigger>
                                        <i:DataTrigger Binding="{Binding SendEmailCodeCooldown}"
                                                       Comparison="NotEqual"
                                                       Value="0">
                                            <i:ChangePropertyAction PropertyName="Visibility"
                                                                    TargetName="SendEmailCodeTextBlock"
                                                                    Value="Hidden" />
                                            <i:ChangePropertyAction PropertyName="Visibility"
                                                                    TargetName="SendEmailCodeCooldownTextBlock"
                                                                    Value="Visible" />
                                        </i:DataTrigger>
                                    </i:Interaction.Triggers>
                                    <TextBox Height="40"
                                             Margin="0,0,0,2"
                                             Padding="8,0"
                                             ui:ControlHelper.PlaceHolder="请输入验证码"
                                             FontSize="16"
                                             InputMethod.IsInputMethodEnabled="False"
                                             MaxLength="10"
                                             Text="{Binding EmailCode, UpdateSourceTrigger=PropertyChanged}">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="GotFocus">
                                                <i:InvokeCommandAction Command="{Binding ClearErrorsCommand}" CommandParameter="EmailCode" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                    <TextBlock x:Name="SendEmailCodeCooldownTextBlock"
                                               Margin="0,0,12,0"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               d:Text="重新发送(49)"
                                               FontSize="14"
                                               Foreground="#8c8c8c"
                                               Text="{Binding SendEmailCodeCooldown, StringFormat=重新发送({0})}" />
                                    <TextBlock x:Name="SendEmailCodeTextBlock"
                                               Margin="0,0,12,0"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               Visibility="Hidden">
                                        <Hyperlink Command="{Binding SendEmailCodeCommand}" Cursor="Hand">
                                            获取验证码
                                        </Hyperlink>
                                    </TextBlock>
                                </Grid>
                                <TextBox x:Name="NewPasswordTextBox"
                                         Height="40"
                                         Margin="0,0,0,2"
                                         Padding="8,0"
                                         VerticalAlignment="Top"
                                         ui:ControlHelper.PlaceHolder="请输入新密码"
                                         FontSize="16"
                                         Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="GotFocus">
                                            <i:InvokeCommandAction Command="{Binding ClearErrorsCommand}" CommandParameter="Password" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </TextBox>
                                <TextBlock FontSize="14"
                                           Foreground="#8C8C8C"
                                           Text="新密码应至少8个字符且包括字母和数字">
                                    <TextBlock.Visibility>
                                        <Binding ElementName="NewPasswordTextBox" Path="(Validation.HasError)">
                                            <Binding.Converter>
                                                <ui:BooleanToObjectConverter FalseValue="{x:Static Visibility.Visible}" TrueValue="{x:Static Visibility.Hidden}" />
                                            </Binding.Converter>
                                        </Binding>
                                    </TextBlock.Visibility>
                                </TextBlock>
                            </StackPanel>
                            <UniformGrid VerticalAlignment="Bottom" Columns="2">
                                <Button Height="45"
                                        Margin="4"
                                        Command="{Binding BackToSignInCommand}"
                                        Content="返回登录"
                                        FontSize="18" />
                                <Button Height="45"
                                        Margin="4"
                                        Command="{Binding ResetPasswordCommand}"
                                        Content="确定"
                                        FontSize="18"
                                        Style="{DynamicResource PrimaryButtonStyle}">
                                    <Button.IsEnabled>
                                        <Binding Path="IsSubmitting">
                                            <Binding.Converter>
                                                <ui:ReverseBooleanConverter />
                                            </Binding.Converter>
                                        </Binding>
                                    </Button.IsEnabled>
                                </Button>
                            </UniformGrid>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
