<UserControl x:Class="AuraEcho.Setup.UI.Views.UninstallPreparation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:viewmodels="clr-namespace:AuraEcho.Setup.UI.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:UninstallPreparationViewModel}"
             d:DesignHeight="500"
             d:DesignWidth="750"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">
    <Grid>
        <StackPanel VerticalAlignment="Bottom">
            <Button Width="200"
                    Height="48"
                    Command="{Binding NavigationToUninstallCommand}"
                    Content="开始卸载"
                    Margin="60"
                    FontSize="16"
                    Style="{DynamicResource PrimaryButtonStyle}" />
            <CheckBox Margin="0,0,0,24"
                      Content="保留本地用户数据"
                      HorizontalAlignment="Center"
                      IsChecked="{Binding IsKeepLocalData}" />
        </StackPanel>
    </Grid>
</UserControl>
