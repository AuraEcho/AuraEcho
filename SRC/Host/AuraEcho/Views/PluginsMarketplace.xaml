<UserControl x:Class="AuraEcho.Views.PluginsMarketplace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AuraEcho.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:enums="clr-namespace:AuraEcho.Enums"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:AuraEcho.Models"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:sv="clr-namespace:AuraEcho.Services"
             xmlns:ui="http://ui.auraecho.com/"
             xmlns:viewmodels="clr-namespace:AuraEcho.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:PluginsMarketplaceViewModel}"
             d:DesignHeight="795"
             d:DesignWidth="940"
             d:Foreground="#EFEFEF"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{DynamicResource Brushes.SurfaceContainerLowest}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ui:BindingProxy x:Key="BindingProxy" Data="{Binding}" />
        <DataTemplate x:Key="PluginTemplate" DataType="{x:Type models:MarketPlugin}">
            <Grid Background="Transparent">
                <Grid.Resources>
                    <ui:BindingProxy x:Key="DataContextProxy" Data="{Binding}" />
                    <Storyboard x:Key="MouseEnterStoryboard">
                        <DoubleAnimation Storyboard.TargetName="CardBorder"
                                         Storyboard.TargetProperty="(Border.RenderTransform).(TranslateTransform.Y)"
                                         To="-5"
                                         Duration="0:0:0.2">
                            <DoubleAnimation.EasingFunction>
                                <CircleEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                    <Storyboard x:Key="MouseLeaveStoryboard">
                        <DoubleAnimation Storyboard.TargetName="CardBorder"
                                         Storyboard.TargetProperty="(Border.RenderTransform).(TranslateTransform.Y)"
                                         To="0"
                                         Duration="0:0:0.2">
                            <DoubleAnimation.EasingFunction>
                                <CircleEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </Grid.Resources>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseEnter">
                        <i:ControlStoryboardAction Storyboard="{StaticResource MouseEnterStoryboard}" />
                    </i:EventTrigger>
                    <i:EventTrigger EventName="MouseLeave">
                        <i:ControlStoryboardAction Storyboard="{StaticResource MouseLeaveStoryboard}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <Border x:Name="CardBorder">
                    <Border.RenderTransform>
                        <TranslateTransform />
                    </Border.RenderTransform>
                    <Viewbox>
                        <Button Width="210"
                                Height="160"
                                Padding="0"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                ui:ControlHelper.CornerRadius="4"
                                Command="{Binding Source={StaticResource BindingProxy}, Path=Data.NavigationToPluginDetailsCommand}"
                                CommandParameter="{Binding}"
                                RenderTransformOrigin=".5, .5">
                            <Grid RowDefinitions="105, *">
                                <Border Grid.Row="0" CornerRadius="4, 4, 0, 0">
                                    <Border.Background>
                                        <ImageBrush ui:WebImageHelper.DecodePixelHeight="210"
                                                    ui:WebImageHelper.Url="{Binding Source={StaticResource DataContextProxy}, Path=Data.PluginInfo.BannerFileUrl}"
                                                    Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <DockPanel Grid.Row="1"
                                           Margin="8"
                                           VerticalAlignment="Center"
                                           LastChildFill="True">
                                    <Border Width="32"
                                            Height="32"
                                            Margin="0,0,8,0"
                                            CornerRadius="4"
                                            DockPanel.Dock="Left">
                                        <Border.Background>
                                            <ImageBrush ui:WebImageHelper.DecodePixelWidth="64"
                                                        ui:WebImageHelper.Url="{Binding Source={StaticResource DataContextProxy}, Path=Data.PluginInfo.IconFileUrl}"
                                                        Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <Grid>
                                        <TextBlock VerticalAlignment="Top"
                                                   d:Text="PLUGIN NAME"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brushes.OnSurface}"
                                                   Style="{DynamicResource BodyMediumTextBlockStyle}"
                                                   Text="{Binding PluginInfo.Name}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock VerticalAlignment="Bottom"
                                                   Foreground="{DynamicResource Brushes.OnSurfaceVariant}"
                                                   Style="{DynamicResource BodySmallTextBlockStyle}"
                                                   Text="{Binding PluginInfo.Summary}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DockPanel>
                            </Grid>
                        </Button>
                    </Viewbox>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid x:Name="ContentPanel" Margin="0,36,0,0">
        <ScrollViewer Grid.Row="1" Margin="0,0,2,2">
            <StackPanel MaxWidth="1600">
                <Grid Margin="48,16,48,24">
                    <i:Interaction.Triggers>
                        <i:DataTrigger Binding="{Binding ElementName=ContentPanel, Path=ActualWidth}"
                                       Comparison="LessThan"
                                       Value="450">
                            <i:ChangePropertyAction PropertyName="Visibility"
                                                    TargetName="SmallBannerLayout"
                                                    Value="{x:Static Visibility.Visible}" />
                            <i:ChangePropertyAction PropertyName="Visibility"
                                                    TargetName="NormalBannerLayout"
                                                    Value="{x:Static Visibility.Collapsed}" />
                        </i:DataTrigger>
                        <i:DataTrigger Binding="{Binding ElementName=ContentPanel, Path=ActualWidth}"
                                       Comparison="GreaterThanOrEqual"
                                       Value="450">
                            <i:ChangePropertyAction PropertyName="Visibility"
                                                    TargetName="SmallBannerLayout"
                                                    Value="{x:Static Visibility.Collapsed}" />
                            <i:ChangePropertyAction PropertyName="Visibility"
                                                    TargetName="NormalBannerLayout"
                                                    Value="{x:Static Visibility.Visible}" />
                        </i:DataTrigger>
                    </i:Interaction.Triggers>
                    <Border x:Name="SmallBannerLayout" d:Visibility="Hidden">
                        <TextBlock FontSize="28"
                                   FontWeight="SemiBold"
                                   Text="{Binding Source={StaticResource Loc}, Path=Labels.PluginsMarketplace}" />
                    </Border>
                    <Grid x:Name="NormalBannerLayout">
                        <Viewbox>
                            <Grid Width="480"
                                  Height="100"
                                  UseLayoutRounding="True">
                                <Border Margin="0,0,0,0" CornerRadius="4">
                                    <Border.Background>
                                        <ImageBrush ImageSource="/Assets/Images/marketplace_banner.jpg" />
                                    </Border.Background>
                                </Border>
                                <Border CornerRadius="4">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0, 0" EndPoint="1, 0">
                                            <GradientStop Offset="0" Color="#7F000000" />
                                            <GradientStop Offset="1" Color="#00000000" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border Width="80"
                                        HorizontalAlignment="Right"
                                        CornerRadius="4"
                                        UseLayoutRounding="False"
                                        Visibility="Hidden">
                                    <Border.Effect>
                                        <DropShadowEffect Direction="360"
                                                          Opacity="0.3"
                                                          Color="Black" />
                                    </Border.Effect>
                                    <Border.Background>
                                        <ImageBrush x:Name="BannerImage"
                                                    ImageSource="/Assets/Images/market_banner.png"
                                                    Stretch="Uniform" />
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Viewbox>
                        <UniformGrid Margin="32,8,0,0" Columns="2">
                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock FontSize="{DynamicResource FontSize.Headline.Large}"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           Text="{Binding Source={StaticResource Loc}, Path=Labels.PluginsMarketplace}" />
                                <TextBlock Margin="0,16,0,0"
                                           FontSize="{DynamicResource FontSize.Body.Large}"
                                           Foreground="White"
                                           Text="{Binding Source={StaticResource Loc}, Path=Labels.PluginsMarketplace_Subtitle}"
                                           TextWrapping="Wrap">
                                    <i:Interaction.Triggers>
                                        <i:DataTrigger Binding="{Binding ElementName=ContentPanel, Path=ActualWidth}"
                                                       Comparison="LessThan"
                                                       Value="800">
                                            <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Collapsed}" />
                                        </i:DataTrigger>
                                        <i:DataTrigger Binding="{Binding ElementName=ContentPanel, Path=ActualWidth}"
                                                       Comparison="GreaterThanOrEqual"
                                                       Value="800">
                                            <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Visible}" />
                                        </i:DataTrigger>
                                    </i:Interaction.Triggers>
                                </TextBlock>
                            </StackPanel>
                        </UniformGrid>
                    </Grid>
                </Grid>
                <ItemsControl Margin="40,0,40,40"
                              VerticalAlignment="Top"
                              d:ItemsSource="{d:SampleData ItemCount=10}"
                              d:Visibility="Hidden"
                              ItemTemplate="{StaticResource PluginTemplate}"
                              ItemsSource="{Binding Plugins}">
                    <i:Interaction.Behaviors>
                        <ui:EntranceAnimationBehavior />
                    </i:Interaction.Behaviors>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="{x:Type ContentPresenter}">
                            <Setter Property="Margin" Value="8" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid x:Name="PluginItemGrid"
                                         Columns="4"
                                         IsItemsHost="True">
                                <i:Interaction.Behaviors>
                                    <i:FluidMoveBehavior AppliesTo="Children" Duration="0:0:0.15">
                                        <i:FluidMoveBehavior.EaseY>
                                            <CircleEase EasingMode="EaseOut" />
                                        </i:FluidMoveBehavior.EaseY>
                                    </i:FluidMoveBehavior>
                                </i:Interaction.Behaviors>
                                <i:Interaction.Triggers>
                                    <i:DataTrigger Binding="{Binding ElementName=PluginItemGrid, Path=ActualWidth}"
                                                   Comparison="GreaterThanOrEqual"
                                                   Value="1300">
                                        <i:ChangePropertyAction PropertyName="Columns" Value="5" />
                                    </i:DataTrigger>
                                    <i:DataTrigger Binding="{Binding ElementName=PluginItemGrid, Path=ActualWidth}"
                                                   Comparison="LessThan"
                                                   Value="1300">
                                        <i:ChangePropertyAction PropertyName="Columns" Value="4" />
                                    </i:DataTrigger>
                                    <i:DataTrigger Binding="{Binding ElementName=PluginItemGrid, Path=ActualWidth}"
                                                   Comparison="LessThan"
                                                   Value="900">
                                        <i:ChangePropertyAction PropertyName="Columns" Value="3" />
                                    </i:DataTrigger>
                                    <i:DataTrigger Binding="{Binding ElementName=PluginItemGrid, Path=ActualWidth}"
                                                   Comparison="LessThan"
                                                   Value="650">
                                        <i:ChangePropertyAction PropertyName="Columns" Value="2" />
                                    </i:DataTrigger>
                                    <i:DataTrigger Binding="{Binding ElementName=PluginItemGrid, Path=ActualWidth}"
                                                   Comparison="LessThan"
                                                   Value="450">
                                        <i:ChangePropertyAction PropertyName="Columns" Value="1" />
                                    </i:DataTrigger>
                                </i:Interaction.Triggers>
                            </UniformGrid>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <Grid RowDefinitions="Auto, *">
            <Grid.Resources>
                <Storyboard x:Key="LoadingAnimation">
                    <DoubleAnimation BeginTime="0:0:0.2"
                                     RepeatBehavior="Forever"
                                     Storyboard.TargetName="LoadingBrushTransform"
                                     Storyboard.TargetProperty="X"
                                     From="-1"
                                     To="1"
                                     Duration="0:0:1">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </Grid.Resources>
            <Viewbox Grid.Row="0">
                <Grid Width="480" Height="100" />
            </Viewbox>
            <Grid Grid.Row="1">

                <!-- Loading -->
                <TextBlock x:Name="LoadingText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           d:Visibility="Hidden"
                           FontSize="{DynamicResource FontSize.Headline.Small}"
                           Text="{Binding Source={StaticResource Loc}, Path=Labels.PluginsMarketplace_Loading}">
                    <i:Interaction.Triggers>
                        <i:DataTrigger Binding="{Binding State}" Value="{x:Static enums:ViewModelState.Loading}">
                            <i:ControlStoryboardAction Storyboard="{StaticResource LoadingAnimation}" />
                            <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Visible}" />
                        </i:DataTrigger>
                        <i:DataTrigger Binding="{Binding State}"
                                       Comparison="NotEqual"
                                       Value="{x:Static enums:ViewModelState.Loading}">
                            <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Collapsed}" />
                            <i:ControlStoryboardAction ControlStoryboardOption="Stop" Storyboard="{StaticResource LoadingAnimation}" />
                        </i:DataTrigger>
                    </i:Interaction.Triggers>
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0, 0" EndPoint="1, 0">
                            <GradientStop Offset="0" Color="Gray" />
                            <GradientStop Offset="0.4" Color="White" />
                            <GradientStop Offset="0.6" Color="White" />
                            <GradientStop Offset="1" Color="Gray" />

                            <LinearGradientBrush.RelativeTransform>
                                <TranslateTransform x:Name="LoadingBrushTransform" X="-0.3" />
                            </LinearGradientBrush.RelativeTransform>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>

                </TextBlock>

                <!-- 无数据 -->
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        d:Visibility="Hidden">
                    <i:Interaction.Triggers>
                        <i:DataTrigger Binding="{Binding State}" Value="{x:Static enums:ViewModelState.Ready}">
                            <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Visible}" />
                        </i:DataTrigger>
                        <i:DataTrigger Binding="{Binding State}"
                                       Comparison="NotEqual"
                                       Value="{x:Static enums:ViewModelState.Ready}">
                            <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Collapsed}" />
                        </i:DataTrigger>
                    </i:Interaction.Triggers>
                    <StackPanel>
                        <i:Interaction.Triggers>
                            <i:DataTrigger Binding="{Binding Plugins.Count}" Value="0">
                                <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Visible}" />
                            </i:DataTrigger>
                            <i:DataTrigger Binding="{Binding Plugins.Count}"
                                           Comparison="NotEqual"
                                           Value="0">
                                <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Collapsed}" />
                            </i:DataTrigger>
                        </i:Interaction.Triggers>
                        <Viewbox Width="32"
                                 Height="32"
                                 Margin="0,0,0,8">
                            <Canvas Width="24.0" Height="24.0">
                                <Path Data="M 13 3 V 11 H 21 V 3 H 13 Z M 3 21 H 11 V 13 H 3 V 21 Z M 3 3 V 11 H 11 V 3 H 3 Z M 13 16 H 16 V 13 H 18 V 16 H 21 V 18 H 18 V 21 H 16 V 18 H 13 V 16 Z" Fill="{DynamicResource Brushes.OnSurfaceVariant}" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Foreground="{DynamicResource Brushes.OnSurfaceVariant}"
                                   Style="{DynamicResource BodyLargeTextBlockStyle}"
                                   Text="{Binding Source={StaticResource Loc}, Path=Labels.PluginsMarketplace_Empty, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- 加载失败 -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Center">
                    <i:Interaction.Triggers>
                        <i:DataTrigger Binding="{Binding State}" Value="{x:Static enums:ViewModelState.LoadFailed}">
                            <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Visible}" />
                        </i:DataTrigger>
                        <i:DataTrigger Binding="{Binding State}"
                                       Comparison="NotEqual"
                                       Value="{x:Static enums:ViewModelState.LoadFailed}">
                            <i:ChangePropertyAction PropertyName="Visibility" Value="{x:Static Visibility.Collapsed}" />
                        </i:DataTrigger>
                    </i:Interaction.Triggers>
                    <StackPanel>
                        <Viewbox Width="32"
                                 Height="32"
                                 Margin="0,0,0,4"
                                 HorizontalAlignment="Center">
                            <Canvas Width="24.0" Height="24.0">
                                <Path Data="M 3 13 H 11 V 21 H 3 V 13 Z" Fill="{DynamicResource Brushes.OnSurfaceVariant}" />
                                <Path Data="M 3 3 H 11 V 11 H 3 V 3 Z" Fill="{DynamicResource Brushes.OnSurfaceVariant}" />
                                <Path Data="M 13 3 H 21 V 11 H 13 V 3 Z" Fill="{DynamicResource Brushes.OnSurfaceVariant}" />
                                <Path Data="M 14.6 13 L 21 19.4 L 19.4 21 L 13 14.6 L 14.6 13 Z" Fill="{DynamicResource Brushes.Error}" />
                                <Path Data="M 21 14.6 L 14.6 21 L 13 19.4 L 19.4 13 L 21 14.6 Z" Fill="{DynamicResource Brushes.Error}" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock HorizontalAlignment="Center"
                                   Margin="0, 0, 0, 8"
                                   Foreground="{DynamicResource Brushes.OnSurfaceVariant}"
                                   Style="{DynamicResource BodyLargeTextBlockStyle}"
                                   Text="{Binding Source={StaticResource Loc}, Path=Labels.PluginsMarketplace_LoadFailed, Mode=OneWay}" />
                        <TextBlock HorizontalAlignment="Center" Style="{DynamicResource BodyLargeTextBlockStyle}">
                            <Hyperlink Command="{Binding LoadPluginsCommand}">
                                <Run Text="{Binding Source={StaticResource Loc}, Path=Labels.PluginsMarketplace_Refresh, Mode=OneWay}" />
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
