<UserControl x:Class="AuraEcho.Views.SignIn"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cc="clr-namespace:AuraEcho.PluginContracts.Constants;assembly=AuraEcho.PluginContracts"
             xmlns:cm="clr-namespace:AuraEcho.Core.Models;assembly=AuraEcho.Core"
             xmlns:converters="clr-namespace:AuraEcho.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:AuraEcho.Core.Models;assembly=AuraEcho.Core"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:ui="http://ui.auraecho.com/"
             xmlns:viewmodels="clr-namespace:AuraEcho.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:SignInViewModel}"
             d:DesignHeight="640"
             d:DesignWidth="960"
             d:Foreground="{DynamicResource Brushes.OnSurface}"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{DynamicResource Brushes.SurfaceContainerLowest}"
             Loaded="UserControl_Loaded"
             UseLayoutRounding="True"
             mc:Ignorable="d">
    <Grid Background="{DynamicResource Brushes.Special.Background}">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <Grid>
                    <i:Interaction.Behaviors>
                        <ui:LoadedEntranceAnimationBehavior Delay="0:0:0.07"/>
                    </i:Interaction.Behaviors>
                    <Border Width="80"
                            Height="80"
                            Margin="0,0,0,12"
                            Background="#7F9A3BFF"
                            CornerRadius="8"
                            Visibility="Visible">
                        <Border.Effect>
                            <BlurEffect Radius="100" />
                        </Border.Effect>
                    </Border>
                    <Border Width="80"
                            Height="80"
                            Margin="0,0,0,12"
                            CornerRadius="8">
                        <Border.Background>
                            <ImageBrush ImageSource="/Assets/Images/auraecho.png" />
                        </Border.Background>
                        <Border BorderThickness="1" CornerRadius="8">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0.5, 0.5" EndPoint="1, 0">
                                    <GradientStop Offset="0" Color="#00FFFFFF" />
                                    <GradientStop Offset="1" Color="#FFFFFFFF" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                        </Border>
                    </Border>
                </Grid>
                <TextBlock Margin="0,0,0,40"
                           HorizontalAlignment="Center"
                           FontFamily="Microsoft YaHei UI"
                           Foreground="{DynamicResource Brushes.Special.OnSurfaceLinear}"
                           Style="{DynamicResource DisplayLargeTextBlockStyle}"
                           Text="{Binding Source={StaticResource R}, Path=Labels.AppName}">
                    <i:Interaction.Behaviors>
                        <ui:LoadedEntranceAnimationBehavior Delay="0:0:0.14" />
                    </i:Interaction.Behaviors>
                </TextBlock>

                <Border Width="400"
                        Height="320"
                        Background="{DynamicResource Brushes.Special.OnSpecialBackground}"
                        BorderBrush="{DynamicResource Brushes.Special.HighlightOutline}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <i:Interaction.Behaviors>
                        <ui:LoadedEntranceAnimationBehavior Delay="0:0:0.20" />
                    </i:Interaction.Behaviors>
                    <Grid Margin="24,20">
                        <StackPanel VerticalAlignment="Top">
                            <Grid x:Name="SignModeLayout" Margin="0,0,0,16">
                                <Grid.Resources>
                                    <Storyboard x:Key="ToCodeButton">
                                        <DoubleAnimation Storyboard.TargetName="SignInModeBg"
                                                         Storyboard.TargetProperty="(Shape.RenderTransform).(TranslateTransform.X)"
                                                         Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.4" EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                    <Storyboard x:Key="ToPasswordButton">
                                        <DoubleAnimation Storyboard.TargetName="SignInModeBg"
                                                         Storyboard.TargetProperty="(Shape.RenderTransform).(TranslateTransform.X)"
                                                         Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.4" EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </Grid.Resources>
                                <Rectangle x:Name="SignInModeBg"
                                           Width="64"
                                           Height="12"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Bottom"
                                           Fill="#BF76FF"
                                           RadiusX="2"
                                           RadiusY="2">
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform X="8" Y="2" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                                <StackPanel x:Name="SignModeButtonPanel" Orientation="Horizontal">
                                    <RadioButton x:Name="CodeModeRadioButton"
                                                 Margin="0,0,24,0"
                                                 Command="{Binding ResetDataCommand}"
                                                 Content="{Binding Source={StaticResource R}, Path=Labels.SignIn_CodeLoginTab}"
                                                 FontSize="18"
                                                 IsChecked="True"
                                                 Style="{DynamicResource TextRadioButtonStyle}">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="Checked">
                                                <i:ChangePropertyAction PropertyName="Visibility"
                                                                        TargetName="CodeSignInLayout"
                                                                        Value="Visible" />
                                                <i:ChangePropertyAction PropertyName="Visibility"
                                                                        TargetName="PasswordSignInLayout"
                                                                        Value="Hidden" />
                                                <i:ControlStoryboardAction Storyboard="{StaticResource ToCodeButton}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </RadioButton>
                                    <RadioButton x:Name="PasswordModeRadioButton"
                                                 Command="{Binding ResetDataCommand}"
                                                 Content="{Binding Source={StaticResource R}, Path=Labels.SignIn_PasswordLoginTab}"
                                                 FontSize="18"
                                                 Style="{DynamicResource TextRadioButtonStyle}">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="Checked">
                                                <i:ChangePropertyAction PropertyName="Visibility"
                                                                        TargetName="CodeSignInLayout"
                                                                        Value="Hidden" />
                                                <i:ChangePropertyAction PropertyName="Visibility"
                                                                        TargetName="PasswordSignInLayout"
                                                                        Value="Visible" />
                                                <i:ControlStoryboardAction Storyboard="{StaticResource ToPasswordButton}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </RadioButton>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <!-- 验证码登录 -->
                                <Grid x:Name="CodeSignInLayout" Visibility="Visible">
                                    <StackPanel>
                                        <TextBox Height="40"
                                                 Margin="0,0,0,24"
                                                 Padding="8,0"
                                                 ui:ControlHelper.PlaceHolder="{Binding Source={StaticResource R}, Path=Labels.SignIn_EmailPlaceholder}"
                                                 ui:InputBoxHelper.FloatingBackground="{DynamicResource Brushes.Special.FloatingBackground}"
                                                 FontSize="16"
                                                 MaxLength="40"
                                                 Style="{DynamicResource FloatingLabelTextBoxStyle}"
                                                 Text="{Binding Email}">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="GotFocus">
                                                    <i:InvokeCommandAction Command="{Binding ClearErrorsCommand}" CommandParameter="Email" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>
                                        <Grid Height="80">
                                            <Grid VerticalAlignment="Top">
                                                <i:Interaction.Triggers>
                                                    <i:DataTrigger Binding="{Binding SendEmailCodeCooldown}" Value="0">
                                                        <i:ChangePropertyAction PropertyName="Visibility"
                                                                                TargetName="SendEmailCodeTextBlock"
                                                                                Value="Visible" />
                                                        <i:ChangePropertyAction PropertyName="Visibility"
                                                                                TargetName="SendEmailCodeCooldownTextBlock"
                                                                                Value="Hidden" />
                                                    </i:DataTrigger>
                                                    <i:DataTrigger Binding="{Binding SendEmailCodeCooldown}"
                                                                   Comparison="NotEqual"
                                                                   Value="0">
                                                        <i:ChangePropertyAction PropertyName="Visibility"
                                                                                TargetName="SendEmailCodeTextBlock"
                                                                                Value="Hidden" />
                                                        <i:ChangePropertyAction PropertyName="Visibility"
                                                                                TargetName="SendEmailCodeCooldownTextBlock"
                                                                                Value="Visible" />
                                                    </i:DataTrigger>
                                                </i:Interaction.Triggers>
                                                <TextBox Height="40"
                                                         Margin="0,0,0,2"
                                                         Padding="8,0"
                                                         ui:ControlHelper.PlaceHolder="{Binding Source={StaticResource R}, Path=Labels.SignIn_VerificationCodePlaceholder}"
                                                         ui:InputBoxHelper.FloatingBackground="{DynamicResource Brushes.Special.FloatingBackground}"
                                                         FontSize="16"
                                                         InputMethod.IsInputMethodEnabled="False"
                                                         MaxLength="10"
                                                         Style="{DynamicResource FloatingLabelTextBoxStyle}"
                                                         Text="{Binding EmailCode, UpdateSourceTrigger=PropertyChanged}">
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="GotFocus">
                                                            <i:InvokeCommandAction Command="{Binding ClearErrorsCommand}" CommandParameter="EmailCode" />
                                                        </i:EventTrigger>
                                                    </i:Interaction.Triggers>
                                                </TextBox>
                                                <TextBlock x:Name="SendEmailCodeCooldownTextBlock"
                                                           Margin="0,0,12,0"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           d:Text="重新发送(49)"
                                                           FontSize="14"
                                                           Foreground="#8c8c8c">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0}({1})">
                                                            <Binding Path="Labels.SignIn_ResendCode" Source="{StaticResource R}" />
                                                            <Binding Path="SendEmailCodeCooldown" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock x:Name="SendEmailCodeTextBlock"
                                                           Margin="0,0,12,0"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           FontSize="14"
                                                           Visibility="Hidden">
                                                    <Hyperlink Command="{Binding SendEmailCodeCommand}"
                                                               Cursor="Hand"
                                                               KeyboardNavigation.IsTabStop="False">
                                                        <Run Text="{Binding Source={StaticResource R}, Path=Labels.SignIn_GetCode, Mode=OneWay}" />
                                                    </Hyperlink>
                                                </TextBlock>
                                            </Grid>
                                        </Grid>
                                        <Button Height="45"
                                                ui:ControlHelper.BusyContent="{Binding Source={StaticResource R}, Path=Labels.SignIn_SigningIn, Mode=OneWay}"
                                                ui:ControlHelper.IsBusy="{Binding IsBusy}"
                                                Command="{Binding SignInByCodeCommand}"
                                                Content="{Binding Source={StaticResource R}, Path=Labels.SignIn_SignInOrRegisterButton}"
                                                FontSize="{DynamicResource FontSize.Label.Large}"
                                                IsDefault="True"
                                                Style="{DynamicResource PrimaryButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                                <!-- 密码登录 -->
                                <Grid x:Name="PasswordSignInLayout" Visibility="Hidden">
                                    <StackPanel>
                                        <TextBox Height="40"
                                                 Margin="0,0,0,24"
                                                 Padding="8,0"
                                                 ui:ControlHelper.PlaceHolder="{Binding Source={StaticResource R}, Path=Labels.SignIn_EmailPlaceholder}"
                                                 ui:InputBoxHelper.FloatingBackground="{DynamicResource Brushes.Special.FloatingBackground}"
                                                 FontSize="16"
                                                 MaxLength="40"
                                                 Style="{DynamicResource FloatingLabelTextBoxStyle}"
                                                 Text="{Binding Email}">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="GotFocus">
                                                    <i:InvokeCommandAction Command="{Binding ClearErrorsCommand}" CommandParameter="Email" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>
                                        <StackPanel Height="80">
                                            <PasswordBox Height="40"
                                                         Margin="0,0,0,2"
                                                         Padding="8,0"
                                                         VerticalAlignment="Top"
                                                         ui:ControlHelper.PlaceHolder="{Binding Source={StaticResource R}, Path=Labels.SignIn_PasswordPlaceholder}"
                                                         ui:InputBoxHelper.FloatingBackground="{DynamicResource Brushes.Special.FloatingBackground}"
                                                         ui:PasswordBoxHelper.Attach="True"
                                                         ui:PasswordBoxHelper.Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="16"
                                                         Style="{DynamicResource FloatingLabelPasswordBoxStyle}">
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="GotFocus">
                                                        <i:InvokeCommandAction Command="{Binding ClearErrorsCommand}" CommandParameter="Password" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                                <i:Interaction.Behaviors>
                                                    <ui:IgnoreKeyBehavior Key="Space" />
                                                </i:Interaction.Behaviors>
                                            </PasswordBox>

                                            <TextBlock HorizontalAlignment="Right" FontSize="14">
                                                <Hyperlink Command="{Binding NavigationToResetPasswordCommand}" Cursor="Hand">
                                                    <Run Text="{Binding Source={StaticResource R}, Path=Labels.SignIn_ForgotPassword, Mode=OneWay}" />
                                                </Hyperlink>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Height="45"
                                                ui:ControlHelper.BusyContent="{Binding Source={StaticResource R}, Path=Labels.SignIn_SigningIn, Mode=OneWay}"
                                                ui:ControlHelper.IsBusy="{Binding IsBusy}"
                                                Command="{Binding SignInByPasswordCommand}"
                                                Content="{Binding Source={StaticResource R}, Path=Labels.SignIn_SignInButton}"
                                                FontSize="{DynamicResource FontSize.Label.Large}"
                                                IsDefault="True"
                                                Style="{DynamicResource PrimaryButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Margin="0,0,0,2"
                                       FontSize="12"
                                       Foreground="{DynamicResource Brushes.OnSurfaceVariant}"
                                       Text="{Binding Source={StaticResource R}, Path=Labels.SignIn_AutoRegisterHint}" />
                            <TextBlock FontSize="12" TextWrapping="Wrap">
                                <Run Foreground="{DynamicResource Brushes.OnSurfaceVariant}" Text="{Binding Source={StaticResource R}, Path=Labels.SignIn_AgreeToEULA, Mode=OneWay}" />
                                <Hyperlink Command="{Binding OpenEULACommand}" Cursor="Hand">
                                    <Run Text="{Binding Source={StaticResource R}, Path=Labels.SignIn_EULA, Mode=OneWay}" />
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
