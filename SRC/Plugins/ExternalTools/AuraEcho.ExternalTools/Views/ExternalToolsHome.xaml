<UserControl x:Class="AuraEcho.ExternalTools.Views.ExternalToolsHome"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:constants="clr-namespace:AuraEcho.ExternalTools.Constants"
             xmlns:converters="clr-namespace:AuraEcho.ExternalTools.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:model="clr-namespace:AuraEcho.ExternalTools.Models"
             xmlns:prism="http://prismlibrary.com/"
             Background="{DynamicResource Brushes.SurfaceContainerLowest}"
             xmlns:utils="clr-namespace:AuraEcho.ExternalTools.Utils"
             xmlns:viewmodels="clr-namespace:AuraEcho.ExternalTools.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:ExternalToolsHomeViewModel}"
             d:DesignHeight="520"
             d:DesignWidth="645"
             Foreground="{DynamicResource Brushes.OnSurface}"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadDataCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <UserControl.Resources>
        <utils:BindingProxy x:Key="BindingProxy" Data="{Binding}" />
        <DataTemplate x:Key="ExternalToolDataTemplate" DataType="{x:Type model:ExternalTool}">
            <Border Height="48"
                    Padding="4"
                    Background="{DynamicResource Brushes.SurfaceContainer}"
                    CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0"
                           Width="24"
                           Height="24"
                           Margin="8,0,8,0"
                           VerticalAlignment="Center">
                        <Image.Source>
                            <MultiBinding Converter="{converters:ExternalToolIconConverter}">
                                <Binding Path="Type" />
                                <Binding Path="Command" />
                            </MultiBinding>
                        </Image.Source>
                    </Image>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   Text="{Binding Name}" />
                        <TextBlock Grid.Row="1"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Foreground="{DynamicResource Brushes.OnSurfaceVariant}"
                                   Text="{Binding Command}" />
                    </Grid>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Height="24"
                                Margin="0,0,8,0"
                                Padding="16,0"
                                VerticalAlignment="Center"
                                Command="{Binding Source={StaticResource BindingProxy}, Path=Data.LunchExternalToolCommand}"
                                CommandParameter="{Binding}"
                                Content="LUNCH" />
                        <Button Width="40"
                                Height="24"
                                VerticalAlignment="Center"
                                Content="...">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="ExternalToolContextMenu">
                                    <MenuItem Command="{Binding Source={StaticResource BindingProxy}, Path=Data.EditExternalToolCommand}"
                                              CommandParameter="{Binding}"
                                              Header="EDIT" />
                                    <MenuItem Command="{Binding Source={StaticResource BindingProxy}, Path=Data.RemoveExternalToolCommand}"
                                              CommandParameter="{Binding}"
                                              Header="REMOVE" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Click">
                                    <i:ChangePropertyAction PropertyName="IsOpen"
                                                            TargetName="ExternalToolContextMenu"
                                                            Value="True" />
                                </i:EventTrigger>
                                <i:EventTrigger EventName="Loaded">
                                    <i:ChangePropertyAction PropertyName="DataContext"
                                                            TargetName="ExternalToolContextMenu"
                                                            Value="{Binding}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <StackPanel Margin="24, 36, 24, 24">
            <TextBlock Margin="0,0,0,12"
                       HorizontalAlignment="Left"
                       FontSize="24"
                       Text="{Binding Source={x:Static utils:ExternalToolsResources.Current}, Path=Strings.PluginName}" />
            <Line Margin="0,0,0,12"
                  Stretch="Fill"
                  Stroke="{DynamicResource Brushes.OutlineVariant}"
                  StrokeThickness="1"
                  UseLayoutRounding="True"
                  X1="0"
                  X2="1"
                  Y1="0"
                  Y2="0" />
            <Border Height="48"
                    Padding="4"
                    Background="{DynamicResource Brushes.SurfaceContainer}"
                    CornerRadius="4">
                <Grid>
                    <TextBlock Margin="8,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FontSize="16"
                               Text="ADD EXTERNAL TOOL" />
                    <Button Height="24"
                            Margin="0,0,8,0"
                            Padding="16,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Command="{Binding Source={StaticResource BindingProxy}, Path=Data.AddExternalToolCommand}"
                            Content="ADD EXTERNAL TOOL" />
                </Grid>
            </Border>
            <ItemsControl d:ItemsSource="{d:SampleData ItemCount=8}"
                          ItemTemplate="{StaticResource ExternalToolDataTemplate}"
                          ItemsSource="{Binding ExternalTools}">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="{x:Type ContentPresenter}">
                        <Setter Property="Margin" Value="0,4" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
